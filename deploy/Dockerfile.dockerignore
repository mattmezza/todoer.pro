# Allowlist only files needed by this image. Overrides the root ignore file.
**
!Cargo.toml
!Cargo.lock
!package.json
!package-lock.json
!app
app/**
!app/Cargo.toml
!app/build.rs
!app/openapi.json
!app/src
!app/src/**
!app/templates
!app/templates/**
!app/migrations
!app/migrations/**
!app/assets
!app/assets/**
!app/tests
app/tests/**
!app/tests/fixtures
!app/tests/fixtures/**
# Never admit databases, environment files or nested local outputs.
**/.env*
**/*.db
**/*.db-*
**/node_modules/**
**/target/**
**/.local/**
