# Optional replication process only; never put these in app.env.
TODOER_REPLICA_ENDPOINT=https://s3.example.invalid
TODOER_REPLICA_REGION=us-east-1
TODOER_REPLICA_BUCKET=replace-with-private-backup-bucket
TODOER_REPLICA_PREFIX=todoer/database
TODOER_REPLICA_ACCESS_KEY_ID=replace-with-dedicated-replication-key
TODOER_REPLICA_SECRET_ACCESS_KEY=replace-with-dedicated-replication-secret
