# Complete standalone virtual host for app.todoer.pro after obtaining a certificate.
# For first issuance, serve the ACME location over HTTP before adding the TLS block.
server {
    listen 80;
    listen [::]:80;
    server_name app.todoer.pro;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/todoer-acme;
    }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name app.todoer.pro;
    ssl_certificate /etc/letsencrypt/live/app.todoer.pro/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.todoer.pro/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    location / {
        proxy_pass http://127.0.0.1:8092;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        client_max_body_size 512m;
    }
}
