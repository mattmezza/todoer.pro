# Compose interpolation only. Copy to deploy/.env; never commit real values.
# For direct Compose commands. deploy.sh vX.Y.Z overrides this with that version.
TODOER_IMAGE=ghcr.io/mattmezza/todoer.pro:v1.0.0
TODOER_PUBLIC_URL=https://app.todoer.pro
TODOER_PORT=8092
TODOER_DATA_DIR=/var/lib/todoer
# Uncomment to enable separately credentialed continuous SQLite replication.
# COMPOSE_FILE=compose.yml:compose.replication.yml
