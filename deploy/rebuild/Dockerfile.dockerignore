# Allowlist only files needed by this image. Overrides the root ignore file.
**
!Cargo.toml
!Cargo.lock
!package.json
!package-lock.json
!rebuild
rebuild/**
!rebuild/Cargo.toml
!rebuild/build.rs
!rebuild/openapi.json
!rebuild/src
!rebuild/src/**
!rebuild/templates
!rebuild/templates/**
!rebuild/migrations
!rebuild/migrations/**
!rebuild/assets
!rebuild/assets/**
!rebuild/tests
rebuild/tests/**
!rebuild/tests/fixtures
!rebuild/tests/fixtures/**
!public
public/**
!public/favicon.png
!public/icon512_rounded.png
!public/icon512_maskable.png
# Never admit databases, environment files or nested local outputs.
**/.env*
**/*.db
**/*.db-*
**/node_modules/**
**/target/**
**/.local/**
