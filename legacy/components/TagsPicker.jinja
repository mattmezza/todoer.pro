<script>
function tagsPicker() {
    return {
        taskSid: '', selected: [], allTags: [], query: '', focusIdx: -1,

        get filtered() {
            if (!this.query) return this.allTags;
            var q = this.query.toLowerCase();
            return this.allTags.filter(function(t) { return t.toLowerCase().includes(q); });
        },
        get canAdd() {
            var q = this.query.trim().toLowerCase();
            return q && !this.allTags.some(function(t) { return t.toLowerCase() === q; });
        },

        open(taskSid, currentTags) {
            this.taskSid = taskSid;
            this.selected = currentTags ? currentTags.split(',').map(function(t) { return t.trim(); }).filter(Boolean) : [];
            this.query = ''; this.focusIdx = -1;
            var self = this;
            fetch('/api/tags').then(function(r) { return r.json(); }).then(function(data) {
                self.allTags = data.tags || [];
            }).catch(function() { self.allTags = []; });
            this.$el.showModal();
            this.$nextTick(function() { self.$refs.tagSearch.focus(); });
        },

        has(tag) { return this.selected.includes(tag); },
        toggle(tag) {
            var idx = this.selected.indexOf(tag);
            if (idx >= 0) this.selected.splice(idx, 1);
            else this.selected.push(tag);
        },
        addNew() {
            var tag = this.query.trim();
            if (!tag) return;
            if (!this.selected.includes(tag)) this.selected.push(tag);
            if (!this.allTags.includes(tag)) { this.allTags.push(tag); this.allTags.sort(); }
            this.query = '';
        },

        save() {
            var tags = this.selected.join(', ');
            var self = this;
            fetch('/task/' + this.taskSid + '/tags', {
                method: 'PUT',
                headers: {'Content-Type': 'application/x-www-form-urlencoded'},
                body: 'tags=' + encodeURIComponent(tags)
            }).then(function(r) { return r.text(); }).then(function(html) {
                var w = document.querySelector('.tags-wrapper[data-task-sid="' + self.taskSid + '"]');
                if (w) { var t = document.createElement('div'); t.innerHTML = html.trim(); var n = t.firstElementChild; w.replaceWith(n); htmx.process(n); }
                self.$el.close();
                htmx.trigger(document.body, 'task-update');
                htmx.trigger(document.body, 'task-' + self.taskSid + '-update');
                var el = document.querySelector('.task[data-sid="' + self.taskSid + '"]');
                var sec = el ? el.closest('.section') : null;
                var secSid = sec ? sec.id.replace('section-', '') : null;
                if (secSid) htmx.trigger(document.body, 'section-' + secSid + '-update');
            });
        },

        handleKey(e) {
            if (e.key === 'Escape') { e.preventDefault(); if (this.query) this.query = ''; else this.$el.close(); return; }
            if (e.key === 'Enter') {
                e.preventDefault();
                if (this.canAdd) this.addNew();
                else if (this.focusIdx >= 0 && this.focusIdx < this.filtered.length) this.toggle(this.filtered[this.focusIdx]);
                else if (this.filtered.length === 1) this.toggle(this.filtered[0]);
                return;
            }
            if (e.key === 'ArrowDown') { e.preventDefault(); this.focusIdx = Math.min(this.focusIdx + 1, this.filtered.length - 1); return; }
            if (e.key === 'ArrowUp') { e.preventDefault(); this.focusIdx = Math.max(this.focusIdx - 1, -1); return; }
        }
    };
}
window.openTagsPicker = function(taskSid, currentTags) {
    var d = document.getElementById('tags-picker-dialog');
    d._x_dataStack[0].open(taskSid, currentTags);
};
</script>
<dialog id="tags-picker-dialog"
    class="bg-transparent backdrop:bg-black/50 w-full max-w-md mx-auto mt-[15vh]"
    x-data="tagsPicker()"
    @keydown="handleKey($event)">
    <div class="bg-zinc-950 rounded-lg border border-slate-700 shadow-2xl overflow-hidden">
        <div class="p-4 border-b border-slate-700">
            <input type="text" x-ref="tagSearch" x-model="query" @input="focusIdx = -1"
                placeholder="Search or add tags..."
                class="w-full bg-slate-900 border border-slate-600 rounded px-3 py-2 text-sm text-slate-200 placeholder:text-slate-500 focus:ring-indigo-500 focus:border-indigo-500">
        </div>
        <template x-if="selected.length > 0">
            <div class="px-4 pt-3 flex flex-wrap gap-1">
                <template x-for="tag in selected" :key="'sel-'+tag">
                    <span @click="toggle(tag)"
                        class="inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded-full bg-indigo-500/30 text-indigo-300 cursor-pointer hover:bg-indigo-500/50">
                        <span x-text="'+' + tag"></span>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3 h-3"><path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z" /></svg>
                    </span>
                </template>
            </div>
        </template>
        <div class="max-h-[40vh] overflow-y-auto p-2">
            <template x-if="canAdd">
                <button type="button" @click="addNew()"
                    class="w-full text-left px-3 py-2 text-sm rounded hover:bg-slate-700 text-indigo-400 cursor-pointer">
                    Create "<span x-text="query.trim()"></span>"
                </button>
            </template>
            <template x-for="(tag, idx) in filtered" :key="tag">
                <button type="button" @click="toggle(tag)"
                    class="w-full text-left px-3 py-2 text-sm rounded cursor-pointer flex items-center justify-between"
                    :class="focusIdx === idx ? 'bg-slate-700' : 'hover:bg-slate-700/50'">
                    <span class="text-slate-300" x-text="'+' + tag"></span>
                    <template x-if="has(tag)">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 text-indigo-400"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
                    </template>
                </button>
            </template>
            <template x-if="filtered.length === 0 && !canAdd">
                <div class="text-center text-sm text-slate-500 py-4">No tags yet</div>
            </template>
        </div>
        <div class="px-4 py-3 border-t border-slate-700 flex justify-between items-center">
            <span class="text-xs text-slate-500" x-text="selected.length + ' selected'"></span>
            <div class="flex gap-2">
                <button type="button" @click="$el.closest('dialog').close()" class="text-xs px-3 py-1.5 text-slate-400 hover:text-slate-300 cursor-pointer">Cancel</button>
                <button type="button" @click="save()" class="text-xs px-3 py-1.5 bg-indigo-600 text-white rounded hover:bg-indigo-700 cursor-pointer">Save</button>
            </div>
        </div>
    </div>
</dialog>
