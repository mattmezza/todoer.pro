{# def task, comments, attachments, audit_log, user #}
<!-- attachments -->
<div class="space-y-4">
    <h3 class="font-bold">&nbsp;</h3>
    <div class="space-y-6">
        <ul id="attachments" class="list-none text-sm flex flex-wrap gap-4">
            {% for a in attachments %}
                <Attachment attachment={{a}} />
            {% endfor %}
        </ul>
        <form
            hx-encoding='multipart/form-data'
            hx-post='/attachments'
            hx-target="previous ul"
            hx-swap="beforeend"
            hx-trigger="submit"
            class="max-w-xs rounded bg-white/5 hover:cursor-pointer"
            _='on htmx:beforeRequest show #progress then hide #upload then show #uploading on htmx:xhr:progress(loaded, total) set #progress.value to (loaded/total)*100 on htmx:afterRequest reset() me then set #progress.value to 0 then hide #progress then hide #uploading then show #upload'>
            <div class="dark:text-zing-200 text-sm cursor-wait w-full text-center animate-pulse duration-150">
            </div>
            <label for="post-attachment" class="dark:text-zinc-200 text-sm cursor-pointer w-full">
                <div id="uploading" style="display: none" class="btn text-center w-full px-16 animate-pulse duration-150 cursor-wait">Uploading...</div>
                <div id="upload" style="display: flex" class="btn group hover:text-indigo-500 gap-2 w-full justify-start relative">
                    <div class="group-hover:bg-indigo-500 group-hover:text-white rounded-full">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 rounded-full group-hover:bg-indigo-500 transition-all p-1">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                        </svg>
                    </div>
                    <span id="post-attachment-fname">Click or drag file here</span>
                    <input id="post-attachment" onchange="validate(this)" class="opacity-0 absolute file:top-0 left-0 file:w-full text-sm file:py-2 file:cursor-pointer" type='file' name='file'>
                </div>
                <div>
                    <progress style="display: none" id='progress' value='0' max='100' class="h-1 w-full rounded"></progress>
                </div>
            </label>
            <button class="btn hover:text-indigo-500 hidden" type="submit">Upload</button>
            <input type="hidden" name="task" value="{{ task.uuid }}">
        </form>
    </div>
</div>

<!-- comments -->
<h3 class="font-bold">&nbsp;</h3>
<div id="comments" class="space-y-4">
    {% for c in comments %}
        <Comment comment={{c}} />
    {% endfor %}
</div>
<div class="flex justify-start">
    <Btn.Create id="btn-comment-create" with-text-reveal={{False}} focus-tag="textarea">Add comment</Btn.Create>
</div>
<form
    style="display: none"
    class="rounded-sm border border-slate-600"
    hx-target="#comments" hx-swap="beforeend"
    hx-post="/comments"
    hx-on::after-request="this.reset()"
    _="on reset or keyup[key is 'Escape'] hide me then show #btn-comment-create">
    <div class="py-2">
        <textarea
            name="content"
            placeholder="Type here..."
            x-data="{
                resize () {
                    $el.style.height = '0px';
                    $el.style.height = $el.scrollHeight + 'px'
                }
            }"
            x-init="$nextTick(() => resize())"
            @input="resize()"
            @keydown.meta.enter="$event.target.form && $event.target.form.dispatchEvent(new Event('submit'))"
            @keydown.ctrl.enter="$event.target.form && $event.target.form.dispatchEvent(new Event('submit'))"
            _="on keyup[key is 'Escape'] reset() the closest <form />"
            class="form-input h-auto min-h-[40px] block py-1 px-3 border-0 w-full resize-none md:text-base"
            autofocus></textarea>
        <input type="hidden" name="task" value="{{ task.uuid }}">
    </div>
    <div class="flex flex-row justify-between items-center border-t border-slate-600 px-3 py-2">
        <div>
        </div>
        <div class="space-x-2">
            <button type="reset" class="btn py-1">Cancel</button>
            <button type="submit" class="btn py-1 bg-indigo-600 text-white">Add comment</button>
        </div>
    </div>
</form>

<!-- audit log -->
<h3 class="font-bold">&nbsp;</h3>
<Tasks.AuditLog audit_log={{audit_log}} />
