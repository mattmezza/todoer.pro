{# def task, attachments #}
<!-- Priority indicator -->
{% if task.priority %}
<div class="w-9 h-9 rounded-lg flex items-center justify-center text-xs font-bold cursor-pointer shadow-lg border
            {% if task.priority == 1 %}bg-red-500/20 text-red-400 border-red-500/30
            {% elif task.priority == 2 %}bg-orange-500/20 text-orange-400 border-orange-500/30
            {% elif task.priority == 3 %}bg-yellow-500/20 text-yellow-400 border-yellow-500/30
            {% elif task.priority == 4 %}bg-blue-500/20 text-blue-400 border-blue-500/30
            {% endif %}"
     @click="sidebarOpen = true"
     title="Priority P{{ task.priority }}">
    P{{ task.priority }}
</div>
{% endif %}

<!-- Due date indicator -->
{% if task.due_date %}
{% set parts = task.due_date.split('-') %}
<div class="w-9 h-9 rounded-lg flex flex-col items-center justify-center leading-tight cursor-pointer shadow-lg border border-slate-700/50 bg-zinc-950"
     @click="sidebarOpen = true"
     title="Due {{ task.due_date }}">
    <span class="text-xs font-bold text-slate-300">{{ parts[2] }}</span>
    {% set months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'] %}
    <span class="text-[9px] text-slate-500">{{ months[parts[1]|int - 1] }}</span>
</div>
{% endif %}

<!-- Tags indicator -->
{% if task.tags %}
{% set tag_list = task.tags.split(',') if task.tags else [] %}
<div class="w-9 h-9 rounded-lg flex items-center justify-center text-xs font-semibold text-indigo-400 cursor-pointer shadow-lg border border-indigo-500/30 bg-indigo-500/10"
     @click="sidebarOpen = true"
     title="{{ tag_list|length }} tag(s)">
    +{{ tag_list|length }}
</div>
{% endif %}

<!-- Attachments indicator -->
{% if attachments|length %}
<div class="w-9 h-9 rounded-lg flex items-center justify-center text-xs font-semibold text-emerald-400 cursor-pointer shadow-lg border border-emerald-500/30 bg-emerald-500/10"
     @click="sidebarOpen = true"
     title="{{ attachments|length }} file(s)">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
      <path stroke-linecap="round" stroke-linejoin="round" d="M18.375 12.739l-7.693 7.693a4.5 4.5 0 01-6.364-6.364l10.94-10.94A3 3 0 1119.5 7.372L8.552 18.32m.009-.01l-.01.01m5.699-9.941l-7.81 7.81a1.5 1.5 0 002.112 2.13" />
    </svg>
</div>
{% endif %}
