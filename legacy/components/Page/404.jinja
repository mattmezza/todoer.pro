<Layout.Err title="Not found - 404">
    <h1 class="text-7xl text-slate-800 dark:text-slate-100 font-bold underline mb-4">404.</h1>
    <h2 class="text-xl text-slate-800 dark:text-slate-100">Oh nooooo...<br>We couldn't find what you were looking for!</h2>
    <button
        class="mt-4 md:mt-8 transition-all active:scale-95 px-4 py-2 rounded dark:hover:bg-zinc-900/80 hover:bg-gray-100/80 font-bold"
        onclick="window.history.go(-1); return false;">
        Go back
    </button>
</Layout.Err>

