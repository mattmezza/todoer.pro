# generated via "openssl rand -hex 32"

export TODOER_SECRET_KEY="..."
export TODOER_ACCESS_TOKEN_EXPIRE_MINUTES="43200" # 60m * 24h * 30d
export TODOER_AUTH_COOKIE_EXPIRE_MINUTES="43200" # 60m * 24h * 30d

export TODOER_DB_URL="sqlite:////var/todoer.db"

# possible values "local|dev|prod"
export TODOER_ENV="local"
export TODOER_RELEASE="$(git rev-parse --short HEAD)"

# the following are needed for connecting to your s3-like storage
export TODOER_STORAGE_ACCESS_KEY_ID=""
export TODOER_STORAGE_SECRET_KEY=""
export TODOER_STORAGE_ENDPOINT=""
export TODOER_STORAGE_BUCKET=""
export TODOER_STORAGE_PRESIGNED_URL_DURATION_DEFAULT_MINUTES="1"
export TODOER_STORAGE_SECRET_KEY_LOCAL="${TODOER_STORAGE_SECRET_KEY}"
