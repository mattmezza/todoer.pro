{# def space, tasks_by_space #}
<li
    class="flex flex-row justify-center items-stretch gap-1 hover:bg-slate-800/50 cursor-pointer rounded">
    <a
        href="/space/{{ space.sid }}"
        class="py-4 md:py-6 md:pl-6 flex-grow transition-all active:scale-95">
        <h2 class="text-lg font-semibold mb-2 font-mono">@{{ space.title }}</h2>
        <p class="text-sm mb-4 whitespace-pre-wrap">{{ space.descr or '' }}</p>
        <div class="flex flex-row gap-4 text-xs dark:text-slate-500">
            <div>
                <span class="font-mono">{{ space.lists or 0 }}</span> lists
            </div>
            <div>
                <span class="font-mono">{{ tasks_by_space[space.uuid] or 0 }}</span> tasks
            </div>
            <div>Created {{ space.created|age }}</div>
        </div>
    </a>
    <button
        hx-confirm="Are you sure you want to delete this space? All of its content (i.e. lists, sections, tasks) will be lost."
        hx-delete="/space/{{ space.sid }}"
        hx-swap="outerHTML"
        hx-target="closest li"
        class="text-red-600 rounded-r px-1 md:px-4 hover:bg-slate-800/50 transition-all active:scale-95 cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
          <path fill-rule="evenodd" d="M16.5 4.478v.227a48.816 48.816 0 0 1 3.878.512.75.75 0 1 1-.256 1.478l-.209-.035-1.005 13.07a3 3 0 0 1-2.991 2.77H8.084a3 3 0 0 1-2.991-2.77L4.087 6.66l-.209.035a.75.75 0 0 1-.256-1.478A48.567 48.567 0 0 1 7.5 4.705v-.227c0-1.564 1.213-2.9 2.816-2.951a52.662 52.662 0 0 1 3.369 0c1.603.051 2.815 1.387 2.815 2.951Zm-6.136-1.452a51.196 51.196 0 0 1 3.273 0C14.39 3.05 15 3.684 15 4.478v.113a49.488 49.488 0 0 0-6 0v-.113c0-.794.609-1.428 1.364-1.452Zm-.355 5.945a.75.75 0 1 0-1.5.058l.347 9a.75.75 0 1 0 1.499-.058l-.346-9Zm5.48.058a.75.75 0 1 0-1.498-.058l-.347 9a.75.75 0 0 0 1.5.058l.345-9Z" clip-rule="evenodd" />
        </svg>
    </button>
</li>


