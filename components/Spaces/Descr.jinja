{#def space #}
<div
    class="cursor-pointer rounded text-sm min-h-[3lh] px-2 w-full prose dark:prose-white prose-base lg:prose-lg"
    _="on click hide me then show the next <form /> then select() on the next <textarea />">
{%- if space.descr -%}
    {{ space.descr|markdown|safe }}
{%- else -%}
    <span class="dark:text-slate-700">(no description)</span>
{%- endif -%}
</div>
<form
    hx-put="/space/{{ space.sid }}/descr"
    hx-target="closest div"
    style="display: none" _="on submit or reset hide me then show the previous <div /> from me"
    class="rounded border border-slate-600 p-1">
    <textarea
        autofocus
        name="descr"
        placeholder="Description..."
        x-data="{
            resize () {
                $el.style.height = '0px';
                $el.style.height = $el.scrollHeight + 'px'
            }
        }"
        x-init="resize()"
        @input="resize()"
        @focus="resize()"
        @keydown.meta.enter="$event.target.form && $event.target.form.dispatchEvent(new Event('submit'))"
        @keydown.ctrl.enter="$event.target.form && $event.target.form.dispatchEvent(new Event('submit'))"
        _="on keyup[key is 'Escape'] reset() the closest <form />"
        class="form-input h-auto min-h-[3lh] block py-1 px-23 border-0 w-full resize-none"
        >{% if space.descr %}{{ space.descr }}{% endif %}</textarea>
    <div class="flex justify-between items-center p-2">
        <div></div>
        <div class="">
            <button type="reset" class="btn text-xs py-0.5 text-white">Cancel</button>
            <button type="submit" class="btn bg-indigo-500 text-xs py-0.5 text-white">Save</button>
        </div>
    </div>
</form>
