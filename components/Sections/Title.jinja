{# def section, tasks, lists, list, view_complete #}
<div class="section-{{section.sid}}-head mb-3"
    hx-trigger="section-{{ section.uuid }}-update from:body, section-{{ section.sid }}-update from:body, list-update from:body"
    hx-get="/section/{{ section.sid}}/title"
    hx-swap="outerHTML"
    hx-target="this">
    <div class="flex items-center justify-between group pl-2 py-1">
        <div class="flex items-center gap-2 flex-grow">
            <!-- Caret button -->
            <button _="on click hide the next <ul /> then hide #btn-task-create-{{ section.sid }} then hide me then show the next <button />" class="p-1">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                </svg>
            </button>
            <button style="display: none" _="on click show the next <ul /> then show #btn-task-create-{{ section.sid }} then hide me then show the previous <button />">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                </svg>
            </button>
            <div class="w-full flex items-end gap-4">
                <h2
                    _="on click hide me then show the next <form /> then select() the next <input />"
                    class="font-semibold font-mono flex-grow cursor-pointer">
                    ${{ section.title }}
                </h2>
                <form
                    style="display: none"
                    _="on submit or reset hide me then show the previous <h2 />"
                    class="flex-grow flex items-center gap-1"
                    hx-put="/section/{{ section.sid }}/title"
                    hx-swap="outerHTML"
                    hx-target=".section-{{section.sid}}-head">
                    <input
                        class="form-input block py-1 px-23 border w-full font-semibold placeholder:font-semibold rounded flex-grow"
                        name="title"
                        value="{{ section.title }}"
                        _="on keyup[key is 'Escape'] reset() the closest <form />"
                        required>
                    <button type="reset" class="btn py-1" _="on click hide closest <form /> then show the previous <h2 />">Cancel</button>
                    <button type="submit" class="btn py-1 bg-indigo-600 text-white">Save</button>
                </form>
                {% set complete = tasks|selectattr("complete")|list|length %}
                {% set total = tasks|length %}
                {% set completion = complete / total * 100 if total else 0 %}
                <span
                    title="{{ complete }} out of {{ total }} tasks completed"
                    class="text-zinc-400 dark:text-slate-700 font-mono">
                    {{ completion|round|int  }}%
                </span>
            </div>
        </div>
        <div class="mx-2">
            <Sections.Actions section={section} view_complete={view_complete} />
            <Sections.ActionMove section={section} lists={lists} />
        </div>
    </div>
    <div class="flex justify-center items-center gap-0">
        <hr style="width: {{ completion|round|int }}%; border-color: {{ list.color }};">
        {% set remainder = 100 - completion %}
        <hr class="border-slate-200/20 dark:border-slate-400/20" style="width: {{ remainder|round|int }}%;">
    </div>
</div>
