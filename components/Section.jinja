{# def section, view_complete, tasks #}
<li
    class="py-4 section"
    hx-trigger="section-update-{{ section.sid}} from:body, section-{{ section.sid }}-task-complete from:body, section-{{ section.sid }}-task-incomplete from:body"
    hx-get="/section/{{ section.sid }}"
    hx-vals='{"view_complete": {% if view_complete %}true{% else %}false{% endif %} }'>

    {% if not section.default %}
    <div class="flex items-center justify-between border-b border-slate-200/20 dark:border-slate-400/20 group mb-3 pl-2 py-1">
        <div class="flex items-center gap-2 flex-grow">
            <!-- Caret button -->
            <button _="on click hide the next <ul /> then hide #btn-task-create-{{ section.sid }} then hide me then show the next <button />" class="p-1">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                </svg>
            </button>
            <button style="display: none" _="on click show the next <ul /> then show #btn-task-create-{{ section.sid }} then hide me then show the previous <button />">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                </svg>
            </button>
            <div class="flex items-end gap-1">
                <h2 class="font-semibold font-mono">${{ section.title }}</h2>
                <span class="text-zinc-400 dark:text-slate-700">{{ tasks|rejectattr("complete")|list|length  }}</span>
            </div>
        </div>
        <div class="mr-5">
            <button class="hover:text-red-700 invisible group-hover:visible" hx-confirm="Are you sure?" hx-delete="/section/{{ section.sid }}" hx-target="closest li" hx-swap="outerHTML">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                </svg>
            </button>
        </div>
    </div>
    {% endif %}
    <ul class="list-none space-y-3">
        {% for task in tasks|rejectattr("complete") %}
            <Tasks.TaskItem task={task} />
        {% endfor %}
    </ul>
    <Btn.Create id={"btn-task-create-" + section.sid} class="!justify-start ml-2" with_text_reveal={False} tabindex="0">Add task</Btn.Create>
    <form
        style="display: none"
        class="rounded-sm border border-slate-600 add-task-form my-4 md:ml-6"
        hx-target="previous ul"
        hx-swap="beforeend"
        hx-post="/tasks"
        hx-on::after-request="this.reset()"
        _="on keyup[key is 'Escape'] hide me then show #btn-task-create-{{ section.sid }}">
        <div class="py-2"">
            <input
                class="form-input block py-1 px-23 border-0 w-full font-bold placeholder:font-bold"
                name="title"
                placeholder="Task name"
                required
                autofocus>
            <textarea
                autofocus
                name="descr"
                placeholder="Description"
                x-data="{
                    resize () {
                        $el.style.height = '0px';
                        $el.style.height = $el.scrollHeight + 'px'
                    }
                }"
                x-init="resize()"
                @input="resize()"
                @keydown.ctrl.enter="$event.target.form && $event.target.form.dispatchEvent(new Event('submit'))"
                @keydown.meta.enter="$event.target.form && $event.target.form.dispatchEvent(new Event('submit'))"
                _="on keyup[key is 'Escape'] reset() the closest <form />"
                class="form-input h-auto min-h-[40px] block py-1 px-23 border-0 w-full resize-none"
                ></textarea>

        </div>
        <div class="flex flex-row justify-between items-center border-t border-slate-600 px-3 py-2">
            <div>
            </div>
            <div class="space-x-2">
                <button type="reset" class="btn py-1" _="on click hide closest <form /> then show #btn-task-create-{{ section.sid }}">Cancel</button>
                <button type="submit" class="btn py-1 bg-indigo-600 text-white">Add task</button>
            </div>
        </div>
        <input type="hidden" name="section" value="{{ section.uuid }}">
    </form>
    {% if view_complete %}
    <div class="section-complete mb-8 space-y-2">
        <span class="font-bold uppercase text-xs ml-2">Complete</span>
        <ul class="list-none space-y-3 mb-8">
            {% for task in tasks|selectattr("complete") if tasks|selectattr("complete")|list|length %}
                <Tasks.TaskItem task={task} />
            {% else %}
                <span class="text-xs text-slate-700 dark:text-slate-300 italic ml-2">(no completed tasks)</span>
            {% endfor %}
        </ul>
    </div>
    {% endif %}

</li>
