{# def section, view_complete, tasks, lists, list, sections, sections_by_list = [] #}
<li
    id="section-{{ section.sid }}"
    class="py-4 section {% if section.is_first %}first{% endif %} {% if section.is_last %}last{% endif %}"
    hx-trigger="section-{{ section.sid }}-update from:body"
    hx-get="/section/{{ section.sid }}"
    hx-vals='{"view_complete": {% if view_complete %}true{% else %}false{% endif %} }'>

    {% if not section.default %}
    <Sections.Title section={{section}} tasks={{tasks}} view_complete={{view_complete}} lists={{lists}} list={{list}}/>
    {% endif %}
    <ul class="list-none space-y-3 tasks sortable-tasks" data-section-sid="{{ section.sid }}">
        {% for task in tasks|rejectattr("complete") %}
            <Tasks.TaskItem task={{task}} section={{section}} sections={{sections}} sections_by_list={{sections_by_list}} />
        {% endfor %}
    </ul>
    <div class="flex items-center gap-1">
        <Btn.Create id={{"btn-task-create-" + section.sid}} class="!justify-start ml-2" with_text_reveal={{False}} tabindex="0">Add task</Btn.Create>
        {% if AI_ENABLED %}
        <button
            type="button"
            class="btn text-slate-500 dark:text-slate-500 hover:text-indigo-500 dark:hover:text-indigo-400 px-2 py-3 cursor-pointer"
            onclick="document.getElementById('ai-dialog-{{ section.sid }}').showModal()"
            title="Generate tasks with AI"
        >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 0 0-2.455 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z" />
            </svg>
        </button>
        <Tasks.AiGenerate section_sid={{section.sid}} />
        {% endif %}
    </div>
    <form
        style="display: none"
        class="rounded-sm border border-slate-600 add-task-form my-4 md:ml-6"
        hx-target="previous ul"
        hx-swap="beforeend"
        hx-post="/tasks"
        hx-on::after-request="this.reset();this.querySelector('input[name=title]').focus()"
        x-data
        @keydown.escape="$el.reset();$el.style.display='none';document.getElementById('btn-task-create-{{ section.sid }}').style.display=''"
        @reset="$el.style.display='none';document.getElementById('btn-task-create-{{ section.sid }}').style.display=''">
        <div class="py-2">
            <input
                class="form-input block py-1 px-3 border-0 focus:ring-0 w-full font-semibold placeholder:font-semibold xs:text-xs sm:text-sm md:text-base lg:text-lg"
                name="title"
                placeholder="Task name"
                required
                autofocus>
            <textarea
                autofocus
                name="descr"
                placeholder="Description"
                x-data="{
                    resize () {
                        $el.style.height = '0px';
                        $el.style.height = $el.scrollHeight + 'px'
                    }
                }"
                x-init="resize()"
                @input="resize()"
                @keydown.ctrl.enter="$event.target.form && $event.target.form.dispatchEvent(new Event('submit'))"
                @keydown.meta.enter="$event.target.form && $event.target.form.dispatchEvent(new Event('submit'))"
                class="form-input h-auto min-h-[40px] block py-1 px-3 border-0 focus:ring-0 w-full resize-none"
                ></textarea>

        </div>
        <div class="flex flex-row justify-between items-center border-t border-slate-600 px-3 py-2">
            <div>
            </div>
            <div class="space-x-2">
                <button type="reset" class="btn py-1">Cancel</button>
                <button type="submit" class="btn py-1 bg-indigo-600 text-white">Add task</button>
            </div>
        </div>
        <input type="hidden" name="section" value="{{ section.uuid }}">
    </form>
    {% if view_complete %}
    <div class="section-complete mb-8 space-y-2">
        <span class="font-bold uppercase text-sm ml-2">Complete</span>
        <ul class="list-none space-y-3 mb-8">
            {% for task in tasks|selectattr("complete") if tasks|selectattr("complete")|list|length %}
                    <Tasks.TaskItem task={{task}} section={{section}} sections={{sections}} sections_by_list={{sections_by_list}} />
            {% else %}
                <span class="text-sm text-slate-700 dark:text-slate-600 ml-2">(no completed tasks)</span>
            {% endfor %}
        </ul>
    </div>
    {% endif %}

</li>
