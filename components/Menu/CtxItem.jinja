{# def tag="a", destructive=False #}
<{{ tag }}
    tabindex="0"
    class="flex gap-2 w-full first-of-type:rounded-t-md last-of-type:rounded-b-md px-4 py-2.5 text-left items-center hover:bg-gray-50 dark:hover:bg-gray-800 disabled:text-gray-500 group active:scale-95 {{'text-red-600 hover:text-red-500' if destructive else ''}}"
    {{ attrs.render() }}>
    {{ content }}
</{{ tag }}>

