{# def subtask #}
<div class="title-wrapper mt-2 w-full">
    <div class="font-bold text-2xl md:text-4xl flex gap-2 items-center">
        <div class="flex flex-row gap-2 items-center">
            <input
                hx-put="/subtask/{{ subtask.sid }}/complete"
                hx-target="closest .title-wrapper"
                hx-swap="outerHTML"
                type="checkbox"
                name="complete"
                class="rounded-full w-6 h-6 cursor-pointer"
                {% if subtask.complete %}checked{% endif %}>
            <h1
                class="page-title-display cursor-pointer hover:text-white rounded px-2 py-1 {% if subtask.complete %}line-through{% endif %}"
                _="on click hide me then show the next <form /> then select() the next <input />">
                {{ subtask.title }}
            </h1>
        </div>
        <form
            class="flex items-center gap-1 w-full"
            hx-put="/subtask/{{ subtask.sid }}/title"
            hx-target="closest .title-wrapper"
            hx-swap="outerHTML"
            style="display: none"
            _="on submit or reset hide me then show the previous <h1 />">
            <input
                class="form-input px-2 py-1 text-2xl md:text-4xl text-white w-full grow"
                name="title"
                value="{{ subtask.title }}"
                _="on keyup[key is 'Escape'] call the closest <form />.reset() then call the closest <form />.dispatchEvent(new Event('reset'))">
            <div class="flex items-center">
                <button type="reset" class="btn text-xs py-0.5 text-white cursor-pointer">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
                      <path fill-rule="evenodd" d="M5.47 5.47a.75.75 0 0 1 1.06 0L12 10.94l5.47-5.47a.75.75 0 1 1 1.06 1.06L13.06 12l5.47 5.47a.75.75 0 1 1-1.06 1.06L12 13.06l-5.47 5.47a.75.75 0 0 1-1.06-1.06L10.94 12 5.47 6.53a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                    </svg>
                </button>
                <button type="submit" class="btn bg-indigo-500 text-xs py-0.5 text-white cursor-pointer">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
                      <path fill-rule="evenodd" d="M19.916 4.626a.75.75 0 0 1 .208 1.04l-9 13.5a.75.75 0 0 1-1.154.114l-6-6a.75.75 0 0 1 1.06-1.06l5.353 5.353 8.493-12.74a.75.75 0 0 1 1.04-.207Z" clip-rule="evenodd" />
                    </svg>
                </button>
            </div>
        </form>
    </div>
    {% if subtask.complete %}
    <p class="text-sm dark:text-slate-700 ml-10" title="Completed on {{ subtask.completed }}">Completed {{ subtask.completed|age }}</p>
    {% endif %}
</div>
