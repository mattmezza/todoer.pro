{# def results, query #}
{% if not query or query|length < 2 %}
    <div class="py-8 text-center text-sm text-slate-500">Type at least 2 characters to search...</div>
{% elif results|length == 0 %}
    <div class="py-8 text-center text-sm text-slate-500">No results found for "{{ query }}"</div>
{% else %}
    <ul class="divide-y divide-slate-700">
        {% for r in results %}
        <li>
            <a href="{% if r.type == 'task' %}/task/{{ r.sid }}{% elif r.type == 'list' %}/list/{{ r.sid }}{% else %}/space/{{ r.sid }}{% endif %}"
               class="flex items-center gap-3 px-4 py-3 hover:bg-slate-700/50 transition-colors"
               onclick="document.getElementById('search-dialog').close()">
                {% if r.type == 'task' %}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-slate-400 shrink-0">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                </svg>
                {% elif r.type == 'list' %}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 shrink-0" style="color: {{ r.color }}">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0ZM3.75 12h.007v.008H3.75V12Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm-.375 5.25h.007v.008H3.75v-.008Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
                </svg>
                {% else %}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-slate-400 shrink-0">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 0 1 4.5 9.75h15A2.25 2.25 0 0 1 21.75 12v.75m-8.69-6.44-2.12-2.12a1.5 1.5 0 0 0-1.061-.44H4.5A2.25 2.25 0 0 0 2.25 6v12a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9a2.25 2.25 0 0 0-2.25-2.25h-5.379a1.5 1.5 0 0 1-1.06-.44Z" />
                </svg>
                {% endif %}
                <div class="min-w-0">
                    <div class="text-sm font-medium text-slate-200 truncate">
                        {% if r.type == 'task' %}%{% elif r.type == 'list' %}#{% else %}@{% endif %}{{ r.title }}
                    </div>
                    {% if r.type == 'task' %}
                    <div class="text-xs text-slate-500 truncate">@{{ r.space_title }} / #{{ r.list_title }}</div>
                    {% elif r.type == 'list' %}
                    <div class="text-xs text-slate-500 truncate">@{{ r.space_title }}</div>
                    {% endif %}
                </div>
            </a>
        </li>
        {% endfor %}
    </ul>
{% endif %}
