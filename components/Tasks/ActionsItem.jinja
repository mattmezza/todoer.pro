{# def task #}
<Menu.Ctx>
    {% set btn_cls = "flex gap-2 w-full first-of-type:rounded-t-md last-of-type:rounded-b-md px-4 py-2.5 text-left items-center hover:bg-gray-50 dark:hover:bg-gray-800 disabled:text-gray-500 active:scale-95 transition-all cursor-pointer" %}

    <Menu.CtxItem
        title="Open this task"
        href={"/task/" + task.sid}
    >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
        </svg>
        <span>Open</span>
    </Menu.CtxItem>

    <Menu.CtxItem
        tag="button"
        title="Edit task title"
        _="on click
            set li to closest <li/>
            set df to first <form/> in li
            hide df
            set ef to first .task-title-edit in li
            show ef
            ef.querySelector('input[name=title]').select()"
    >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" />
        </svg>
        <span>Edit</span>
    </Menu.CtxItem>

    <hr class="border-slate-900">

    {% if task.is_first == False %}
    <button
        tabindex="0"
        type="button"
        class="{{ btn_cls }}"
        title="Move task to the top"
        hx-patch="/task/{{ task.sid }}/move-top">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 size-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="m9 9 6-6m0 0 6 6m-6-6v12a6 6 0 0 1-12 0v-3" />
        </svg>
        <span>Move to top</span>
    </button>
    <button
        tabindex="0"
        type="button"
        class="{{ btn_cls }}"
        title="Move task up"
        hx-patch="/task/{{ task.sid }}/move-up">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 size-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5 12 3m0 0 7.5 7.5M12 3v18" />
        </svg>
        <span>Move up</span>
    </button>
    {% endif %}
    {% if task.is_last == False %}
    <button
        tabindex="0"
        type="button"
        class="{{ btn_cls }}"
        title="Move task down"
        hx-patch="/task/{{ task.sid }}/move-down">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 size-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3" />
        </svg>
        <span>Move down</span>
    </button>
    <button
        tabindex="0"
        type="button"
        class="{{ btn_cls }}"
        title="Move task to the bottom"
        hx-patch="/task/{{ task.sid }}/move-bottom">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 size-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="m15 15-6 6m0 0-6-6m6 6V9a6 6 0 0 1 12 0v3" />
        </svg>
        <span>Move to bottom</span>
    </button>
    {% endif %}

    <hr class="border-slate-900">

    <Menu.CtxItem
        tag="button"
        title="Move task to a different section"
        onclick={"document.getElementById('dialog-task-" + task.sid + "-move').showModal()"}
    >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4">
          <path fill-rule="evenodd" d="M14.47 2.47a.75.75 0 0 1 1.06 0l6 6a.75.75 0 0 1 0 1.06l-6 6a.75.75 0 1 1-1.06-1.06l4.72-4.72H9a5.25 5.25 0 1 0 0 10.5h3a.75.75 0 0 1 0 1.5H9a6.75 6.75 0 0 1 0-13.5h10.19l-4.72-4.72a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
        </svg>
        <span>Move to section...</span>
    </Menu.CtxItem>

    <hr class="border-slate-900">

    <button
        tabindex="0"
        type="button"
        class="{{ btn_cls }}"
        title="Archive task"
        hx-patch="/task/{{ task.sid }}/archive"
        hx-target="closest li"
        hx-swap="outerHTML"
        hx-push-url="false">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="m20.25 7.5-.625 10.632a2.25 2.25 0 0 1-2.247 2.118H6.622a2.25 2.25 0 0 1-2.247-2.118L3.75 7.5m8.25 3v6.75m0 0-3-3m3 3 3-3M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z" />
        </svg>
        <span>Archive</span>
    </button>
    <button
        tabindex="0"
        type="button"
        class="text-red-600 flex gap-2 w-full first-of-type:rounded-t-md last-of-type:rounded-b-md px-4 py-2.5 text-left items-center hover:bg-gray-50 dark:hover:bg-gray-800 disabled:text-gray-500 hover:text-red-500 group active:scale-95"
        hx-delete="/task/{{ task.sid }}"
        hx-confirm="Are you sure? You will lose all of this task's sub-tasks, attachments and comments."
        hx-target="closest li"
        hx-swap="outerHTML"
        title="Delete task">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
        </svg>
        <span>Delete</span>
    </button>
</Menu.Ctx>


