{# def section_sid #}
<dialog
    id="ai-dialog-{{ section_sid }}"
    class="backdrop:backdrop-blur-sm backdrop:bg-black/50 dark:text-zinc-50 w-full sm:w-11/12 md:w-2/3 lg:w-1/2 bg-white dark:bg-slate-800 shadow-xl rounded z-50"
    x-data="{
        step: 'prompt',
        loading: false,
        charCount: 0,
        maxChars: 1000,
        updateCount(e) { this.charCount = e.target.value.length }
    }"
    @close="step = 'prompt'; loading = false; charCount = 0"
>
    <div class="p-6 relative">
        <button
            class="text-slate-800 dark:text-gray-300 flex items-center justify-center h-6 w-6 active:scale-95 absolute right-3 top-3 rounded-full dark:hover:bg-white/30 hover:bg-black/30 cursor-pointer"
            onclick="this.closest('dialog').close()">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
              <path fill-rule="evenodd" d="M5.47 5.47a.75.75 0 0 1 1.06 0L12 10.94l5.47-5.47a.75.75 0 1 1 1.06 1.06L13.06 12l5.47 5.47a.75.75 0 1 1-1.06 1.06L12 13.06l-5.47 5.47a.75.75 0 0 1-1.06-1.06L10.94 12 5.47 6.53a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
            </svg>
        </button>

        <div class="flex items-center gap-2 mb-4">
            <div class="w-8 h-8 rounded-full flex items-center justify-center shrink-0 bg-indigo-600">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-white">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 0 0-2.455 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z" />
                </svg>
            </div>
            <h2 class="text-xl font-bold">Generate tasks with AI</h2>
        </div>

        <!-- Step 1: Prompt input -->
        <div x-show="step === 'prompt'">
            <form
                hx-post="/ai/generate-tasks"
                hx-target="#ai-results-{{ section_sid }}"
                hx-swap="innerHTML"
                @htmx:before-request="loading = true"
                @htmx:after-request="loading = false; if(event.detail.successful) step = 'preview'"
            >
                <p class="text-sm text-slate-500 dark:text-slate-400 mb-3">
                    Describe what you want to accomplish and AI will generate a list of tasks for you.
                </p>
                <textarea
                    name="prompt"
                    placeholder="e.g. Plan a birthday party for 20 people"
                    required
                    maxlength="1000"
                    @input="updateCount($event)"
                    @keydown.ctrl.enter="$event.target.form && $event.target.form.dispatchEvent(new Event('submit', {cancelable: true, bubbles: true}))"
                    @keydown.meta.enter="$event.target.form && $event.target.form.dispatchEvent(new Event('submit', {cancelable: true, bubbles: true}))"
                    _="on keyup[key is 'Escape'] trigger click on the closest <dialog />'s first <button />"
                    x-data="{
                        resize () {
                            $el.style.height = '0px';
                            $el.style.height = $el.scrollHeight + 'px'
                        }
                    }"
                    x-init="resize()"
                    @input.debounce="resize()"
                    class="form-input h-auto min-h-[100px] block py-2 px-3 border border-slate-300 dark:border-slate-700 rounded w-full resize-none text-sm dark:bg-zinc-800"
                ></textarea>
                <div class="flex justify-between items-center mt-2">
                    <span
                        class="text-xs"
                        :class="charCount > maxChars ? 'text-red-500' : 'text-slate-400'"
                        x-text="charCount + '/' + maxChars"
                    ></span>
                    <div class="flex gap-2">
                        <button
                            type="button"
                            class="btn rounded px-6 py-1 text-sm"
                            onclick="this.closest('dialog').close()"
                        >Cancel</button>
                        <button
                            type="submit"
                            class="btn bg-indigo-600 text-white rounded px-6 py-1 text-sm disabled:opacity-50"
                            :disabled="loading || charCount === 0 || charCount > maxChars"
                        >
                            <span x-show="!loading">Generate</span>
                            <span x-show="loading" class="flex items-center gap-1">
                                <svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                                Generating...
                            </span>
                        </button>
                    </div>
                </div>
                <input type="hidden" name="section_sid" value="{{ section_sid }}">
            </form>
        </div>

        <!-- Step 2: Preview results -->
        <div x-show="step === 'preview'" x-cloak>
            <div id="ai-results-{{ section_sid }}">
            </div>
            <div class="flex justify-between items-center mt-4">
                <button
                    type="button"
                    class="btn rounded px-6 py-1 text-sm"
                    @click="step = 'prompt'"
                >Back</button>
            </div>
        </div>
    </div>
</dialog>
