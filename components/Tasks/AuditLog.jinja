{# def audit_log #}
{% if audit_log %}
<div class="space-y-2">
    <h3 class="text-sm font-semibold text-slate-500 uppercase">Activity</h3>
    <ul class="space-y-1">
        {% for entry in audit_log %}
        <li class="flex items-center gap-2 text-xs text-slate-500">
            <span class="w-1.5 h-1.5 rounded-full bg-slate-600 shrink-0"></span>
            <span>
                {% if entry.action == 'created' %}Task created
                {% elif entry.action == 'completed' %}Marked as complete
                {% elif entry.action == 'uncompleted' %}Marked as incomplete
                {% elif entry.action == 'archived' %}Archived
                {% elif entry.action == 'moved' %}Moved to another section
                {% elif entry.action == 'title_changed' %}Title updated
                {% else %}{{ entry.action }}
                {% endif %}
                {% if entry.detail %}<span class="text-slate-600">&middot; {{ entry.detail }}</span>{% endif %}
            </span>
            <span class="ml-auto text-slate-600 whitespace-nowrap" title="{{ entry.created }}">{{ entry.created|age }}</span>
        </li>
        {% endfor %}
    </ul>
</div>
{% endif %}
