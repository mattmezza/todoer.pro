{# def task, section, sections, sections_by_list = [], list = None #}
<li
    id="task-{{ task.sid }}"
    data-sid="{{ task.sid }}"
    class="task {% if task.is_first %}first{% endif %} {% if task.is_last %}last{% endif %}"
    :class="typeof selectMode !== 'undefined' && isSelected('{{ task.sid }}') ? 'ring-2 ring-indigo-500 rounded' : ''"
>
    <div
        class="shadow-lg rounded-sm border-b border-slate-200 dark:border-slate-800 py-2 group cursor-pointer{% if task.complete %} opacity-40{% endif %} flex items-start justify-between px-2">
        <!-- Drag handle -->
        {% if not task.complete %}
        <div class="drag-handle flex md:!hidden items-center mr-1 mt-1 cursor-grab active:cursor-grabbing text-slate-400 hover:text-slate-300 select-none" title="Drag to reorder"
            :class="typeof selectMode !== 'undefined' && selectMode ? '!hidden' : ''">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9h16.5m-16.5 6.75h16.5" />
            </svg>
        </div>
        {% endif %}
        <!-- Left side -->
        <div
            @click="if (typeof selectMode !== 'undefined' && selectMode) { $event.preventDefault(); toggleSelect('{{ task.sid }}'); } else { window.location.href = '/task/{{ task.sid }}'; }"
            class="grow mt-0.5 mb-0.5 sm:mb-0">
            <div class="flex items-center">
                <!-- Checkbox button -->
                <form class="flex items-center">
                    <input
                        hx-put="/task/{{ task.sid }}"
                        hx-target="closest li"
                        hx-swap="outerHTML"
                        hx-trigger="click consume"
                        name="complete"
                        hx-push-url="false"
                        type="checkbox"
                        {% if task.complete %}checked{% endif %}
                        class="form-checkbox w-5 h-5 rounded-full peer cursor-pointer">
                    <input name="title" type="hidden" value="{{ task.title }}" />
                    {% if task.descr %}<input name="descr" type="hidden" value="{{ task.descr }}" />{% endif %}
                    {% if task.priority %}
                    <span class="ml-2 w-2 h-2 rounded-full inline-block flex-shrink-0
                        {% if task.priority == 1 %}bg-red-500
                        {% elif task.priority == 2 %}bg-orange-500
                        {% elif task.priority == 3 %}bg-yellow-500
                        {% elif task.priority == 4 %}bg-blue-500
                        {% endif %}" title="P{{ task.priority }}"></span>
                    {% endif %}
                    <span class="font-semibold text-slate-800 dark:text-slate-100 peer-checked:line-through ml-3 xs:text-xs sm:text-sm md:text-base lg:text-lg">{{ task.title }}</span>
                </form>
                <div class="ml-2" onclick="event.stopPropagation()">
                    <Tasks.DueDate task={{task}} />
                </div>
                <!-- Inline title edit form (hidden by default) -->
                <form class="task-title-edit ml-3 flex-grow flex items-center gap-1" style="display:none"
                    onclick="event.stopPropagation()"
                    hx-put="/task/{{ task.sid }}"
                    hx-target="closest li"
                    hx-swap="outerHTML"
                    hx-push-url="false"
                    x-data
                    @keydown.escape="$el.reset();$el.style.display='none';$el.previousElementSibling.style.display=''"
                    @reset="$el.style.display='none';$el.previousElementSibling.style.display=''"
                >
                    <input class="form-input text-sm w-full px-2 py-0.5 border-0 focus:ring-0" name="title" value="{{ task.title }}">
                    {% if task.descr %}<input name="descr" type="hidden" value="{{ task.descr }}" />{% endif %}
                    {% if task.complete %}<input name="complete" type="hidden" value="on" />{% endif %}
                    <button type="submit" class="btn text-xs py-0.5 px-2 bg-indigo-600 hover:bg-indigo-700 text-white">Save</button>
                    <button type="reset" class="btn text-xs py-0.5 px-2">Cancel</button>
                </form>
            </div>
            {% if task.descr %}
            <div class="ml-8 text-sm prose dark:prose-white xs:prose-xs sm:prose-sm md:prose-base peer-checked:line-through">
                {{ task.descr|strip_markdown|truncate(200)|linkify|safe }}
            </div>
            {% endif %}

            {% if task.tags %}
            <div class="ml-8 flex flex-wrap gap-1 mt-1">
                {% for tag in task.tags.split(',') %}
                    {% if tag.strip() %}
                    <span class="text-xs px-1.5 py-0.5 rounded-full bg-indigo-500/20 text-indigo-400">+{{ tag.strip() }}</span>
                    {% endif %}
                {% endfor %}
            </div>
            {% endif %}
            <form class="task-descr-edit ml-8 mt-1 flex-grow flex flex-col gap-1" style="display:none"
                onclick="event.stopPropagation()"
                hx-put="/task/{{ task.sid }}"
                hx-target="closest li"
                hx-swap="outerHTML"
                hx-push-url="false"
                x-data
                @keydown.escape="$el.reset();$el.style.display='none'"
                @reset="$el.style.display='none'"
            >
                <input name="title" type="hidden" value="{{ task.title }}" />
                {% if task.complete %}<input name="complete" type="hidden" value="on" />{% endif %}
                <textarea name="descr" rows="3"
                    class="form-input text-sm w-full px-2 py-1 resize-none border-0 focus:ring-0"
                    x-data="{ resize() { $el.style.height = '0px'; $el.style.height = $el.scrollHeight + 'px' } }"
                    x-init="$nextTick(() => resize())"
                    @input="resize()"
                    @keydown.meta.enter="$event.target.form && $event.target.form.dispatchEvent(new Event('submit'))"
                    @keydown.ctrl.enter="$event.target.form && $event.target.form.dispatchEvent(new Event('submit'))"
                >{{ task.descr or '' }}</textarea>
                <div class="flex gap-1">
                    <button type="submit" class="btn text-xs py-0.5 px-2 bg-indigo-600 hover:bg-indigo-700 text-white">Save</button>
                    <button type="reset" class="btn text-xs py-0.5 px-2">Cancel</button>
                </div>
            </form>
        </div>
        <!-- Right side -->
        <div class="items-center justify-end space-x-2 flex">
            {% if task.subtasks_total and task.subtasks_total > 0 %}
            {% set circumference = 87.96 %}
            {% set progress = (circumference * task.subtasks_done / task.subtasks_total)|round(2) %}
            {% set remaining = (circumference - progress)|round(2) %}
            {% set is_complete = task.subtasks_done == task.subtasks_total %}
            <div class="shrink-0 group/ring relative flex items-center justify-center" aria-label="{{ task.subtasks_done }}/{{ task.subtasks_total }} subtasks done">
                <svg class="w-10 h-10" viewBox="0 0 36 36">
                    <circle cx="18" cy="18" r="14" fill="none" class="stroke-slate-500" stroke-width="3" />
                    <circle cx="18" cy="18" r="14" fill="none"
                        stroke="{{ list.color if list and list.color else '#6366f1' }}"
                        stroke-width="3"
                        stroke-dasharray="{{ progress }}, {{ remaining }}"
                        transform="rotate(-90 18 18)" />
                </svg>
                <span class="absolute text-[10px] font-semibold text-slate-400 pointer-events-none select-none">{{ task.subtasks_done }}</span>
                <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-1.5 px-2 py-0.5 rounded bg-slate-800 text-xs text-slate-200 whitespace-nowrap opacity-0 group-hover/ring:opacity-100 transition-opacity pointer-events-none z-10 shadow-lg">
                    {{ task.subtasks_done }}/{{ task.subtasks_total }} subtasks
                </div>
            </div>
            {% endif %}
            {% if not task.complete %}
            <Tasks.ActionsItem task={{task}} />
            <Tasks.ActionMove task={{task}} section={{section}} sections={{sections}} sections_by_list={{sections_by_list}} />
            {% endif %}
        </div>
    </div>
</li>
