{# def task, section, sections, should_reload = False #}
<Dialog.Closable style="margin: auto" id={"dialog-task-" + task.sid + "-move"} class="md:w-1/3 mx-auto">
    <form
        class="space-y-8 mx-auto"
        hx-put="/task/{{ task.sid }}/section{% if should_reload %}?reload=true{% endif %}"
        {% if not should_reload %}
        hx-target="closest li"
        hx-swap="outerHTML"
        {% endif %}
        hx-on:htmx:after-request="document.getElementById('dialog-task-{{task.sid}}-move').close()"
    >
        <div class="">
            <h1 class="font-bold text-2xl">Move this task to a different section</h1>
            <h2 class="text-sm">Choose to which section you want to move <span class="underlined">{{ task.title }}</span></h2>
        </div>
        <main>
            <select name="section" class="rounded dark:bg-black dark:text-white cursor-pointer border-0 ring-0 w-full text-center font-mono px-4 py-2">
                {% for se in sections|rejectattr("uuid", "==", section.uuid) %}
                <option class="cursor-pointer" value="{{ se.uuid }}">
                    ${{ se.title }}
                </option>
                {% else %}
                    <p class="text-slate-300 dark:text-slate-700">You only have one section in this list.</p>
                {% endfor %}
            </select>
        </main>
        <footer class="flex justify-center items-center gap-4">
            <button
                type="reset"
                onclick="document.getElementById('dialog-task-{{task.sid}}-move').close()"
                class="px-12 py-2 rounded text-white font-bold uppercase hover:bg-slate-700 transitions-all active:pulse-95"
                >
                Cancel
            </button>
            {% if sections|rejectattr("uuid", "==", section.uuid)|list|length %}
            <button
                type="submit"
                class="px-12 py-2 rounded bg-indigo-600 text-white font-bold uppercase hover:bg-indigo-700 transitions-all active:pulse-95"
                >
                Move
            </button>
            {% endif %}
        </footer>
    </form>
</Dialog.Closable>
