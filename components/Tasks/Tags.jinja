{# def task #}
<div class="tags-wrapper flex flex-wrap items-center gap-1" data-task-sid="{{ task.sid }}" data-tags="{{ task.tags or '' }}">
    {% set tag_list = task.tags.split(',') if task.tags else [] %}
    {% for tag in tag_list %}
        {% if tag.strip() %}
        <span class="inline-flex items-center text-xs px-2 py-0.5 rounded-full bg-indigo-500/20 text-indigo-300">
            #{{ tag.strip() }}
        </span>
        {% endif %}
    {% endfor %}
    <button type="button" class="tags-display text-xs text-slate-600 hover:text-slate-400 cursor-pointer"
        onclick="event.stopPropagation(); openTagsPicker('{{ task.sid }}', this.closest('.tags-wrapper').dataset.tags)">
        + tag
    </button>
</div>
