{# def spaces, lists, sections, default_space, default_list, default_section #}
<div class="bg-zinc-950 rounded-lg border border-slate-700 shadow-2xl overflow-hidden">
    <form
        hx-post="/tasks"
        hx-target="#quick-add-result"
        hx-swap="innerHTML"
        hx-on::after-request="if(event.detail.successful) { document.getElementById('quick-add-dialog').close(); }"
        class="flex flex-col"
    >
        <div class="flex items-center justify-between px-4 py-3 border-b border-slate-700">
            <h3 class="font-semibold text-sm text-slate-200">Quick add task</h3>
            <button
                type="button"
                class="text-slate-400 hover:text-slate-200 cursor-pointer"
                onclick="document.getElementById('quick-add-dialog').close()"
            >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
                    <path fill-rule="evenodd" d="M5.47 5.47a.75.75 0 0 1 1.06 0L12 10.94l5.47-5.47a.75.75 0 1 1 1.06 1.06L13.06 12l5.47 5.47a.75.75 0 1 1-1.06 1.06L12 13.06l-5.47 5.47a.75.75 0 0 1-1.06-1.06L10.94 12 5.47 6.53a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                </svg>
            </button>
        </div>

        <div class="p-4 space-y-3">
            <div>
                <input
                    id="quick-add-title"
                    type="text"
                    name="title"
                    placeholder="Task name"
                    required
                    class="form-input block w-full rounded border-slate-600 bg-slate-700/50 text-slate-200 placeholder:text-slate-500 font-semibold text-base focus:ring-indigo-500 focus:border-indigo-500"
                >
            </div>
            <div>
                <textarea
                    name="descr"
                    placeholder="Description (optional)"
                    rows="2"
                    x-data="{
                        resize () {
                            $el.style.height = '0px';
                            $el.style.height = $el.scrollHeight + 'px'
                        }
                    }"
                    x-init="resize()"
                    @input="resize()"
                    @keydown.ctrl.enter="$event.target.form && $event.target.form.dispatchEvent(new Event('submit'))"
                    @keydown.meta.enter="$event.target.form && $event.target.form.dispatchEvent(new Event('submit'))"
                    class="form-input block w-full rounded border-slate-600 bg-slate-700/50 text-slate-200 placeholder:text-slate-500 text-sm resize-none min-h-[40px] focus:ring-indigo-500 focus:border-indigo-500"
                ></textarea>
            </div>

            <div class="space-y-2">
                <div>
                    <label class="block text-xs text-slate-400 mb-1">Space</label>
                    <select
                        name="space"
                        hx-get="/tasks/quick-add/lists"
                        hx-target="#quick-add-lists-wrap"
                        hx-trigger="change"
                        class="form-select block w-full rounded border-slate-600 bg-slate-700/50 text-slate-200 text-sm focus:ring-indigo-500 focus:border-indigo-500"
                    >
                        {% for sp in spaces %}
                        <option value="{{ sp.sid }}" {% if sp.uuid == default_space.uuid %}selected{% endif %}>@{{ sp.title }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div id="quick-add-lists-wrap">
                    <Tasks.QuickAddLists lists={{lists}} default_list={{default_list}} sections={{sections}} default_section={{default_section}} />
                </div>
            </div>
        </div>

        <div class="flex items-center justify-between px-4 py-3 border-t border-slate-700">
            <span class="text-xs text-slate-400">
                <kbd class="px-1.5 py-0.5 rounded bg-slate-700 text-slate-400 font-mono text-xs">Esc</kbd> to close
                &middot;
                <kbd class="px-1.5 py-0.5 rounded bg-slate-700 text-slate-400 font-mono text-xs">Cmd+Enter</kbd> to save
            </span>
            <div class="flex gap-2">
                <button type="button" class="btn rounded px-4 py-1 text-sm" onclick="document.getElementById('quick-add-dialog').close()">
                    Cancel
                </button>
                <button type="submit" class="btn bg-indigo-600 text-white rounded px-4 py-1 text-sm">
                    Add task
                </button>
            </div>
        </div>
    </form>
</div>
<div id="quick-add-result" class="hidden"></div>
