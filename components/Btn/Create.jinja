{# def with_text_reveal=True #}
{% do attrs.set(class=".btn-create flex flex-row space-x-1 items-center justify-center text-zinc-600 rounded px-3 py-3 group cursor-pointer") %}
<div
    _="on click hide me then show the next <form /> then focus() the next <input />"
    {{ attrs.render() }}
>
    <button tabindex="0" class="btn text-slate-700 dark:text-slate-400 group-hover:text-indigo-500 gap-1">
        <div class="dark:text-slate-700 dark:group-hover:bg-indigo-500 dark:group-hover:text-white rounded-full">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m6-6H6" />
            </svg>
        </div>
        <span class="{{ 'lg:hidden lg:group-hover:block' if with_text_reveal }}">{{ content }}</span>
    </button>
</div>
