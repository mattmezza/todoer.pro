{# def user, space, spaces, lists, list, section, sections, task, subtasks, attachments, comments #}
<Layout.App spaces={spaces} space={space} user={user} title={list.title} lists={lists}>
<div class="py-8 px-4 md:px-8 max-w-screen-xl mx-auto">
    <div class="mb-8 space-y-4">
        <!--
        <a href="
                {%- if list.default -%}
                    {%- if space.default -%}
                        /inbox
                    {%- else -%}
                        /space/{{ space.sid }}
                    {%- endif -%}
                {%- else -%}
                    /list/{{ list.sid }}
                {%- endif -%}
            " class="flex items-center gap-1 cursor-pointer mb-2 hover:text-white">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 15.75L3 12m0 0l3.75-3.75M3 12h18" />
            </svg>
            {#<span class="font-mono">{{ '@' + space.title if list.default else '#' + list.title }}</span>#}
            <span>back</span>
        </a>
-->
        <div class="ml-2 md:ml-0">
            <Breadcrumbs>
                <Breadcrumb title="Go to space." href={"/space/" + space.sid}>
                    @{{ space.title }}
                </Breadcrumb>
                <Breadcrumb title="Go to list." href={"/list/" + list.sid}>
                    #{{ list.title }}
                </Breadcrumb>
                <Breadcrumb title="Go to section." href={"/list/" + list.sid + "#section-" + section.sid}>
                    ${{ section.title }}
                </Breadcrumb>
            </Breadcrumbs>
        </div>
        <div class="flex justify-between items-center gap-2 p-4">
            <Tasks.Title task={task} section={section} list={list} space={space} />
            <Btn.CopyId id={task.sid} prefix="%" title={"Copy task id (%" + task.sid + ")"} />
            <Tasks.Actions task={task} list={list} view_complete={False} />
            <Tasks.ActionMove task={task} section={section} sections={sections} />
        </div>
        <Tasks.Descr task={task} />

        <div>
            <!-- sub-task -->
            <h3 class="font-bold">&nbsp;</h3>
            <ul class="list-none space-y-1">
                {% for subt in subtasks %}
                    <Subtask subtask={subt} />
                {% endfor %}
            </ul>
            <Btn.Create id="btn-subtask-create" with-text-reveal={False} class="!justify-start">Add sub-task</Btn.Create>
            <form
                style="display: none"
                class="rounded-sm border border-slate-600"
                hx-target="previous ul"
                hx-swap="beforeend"
                hx-post="/subtasks"
                hx-on::after-request="this.reset();this.querySelector('input[name=title]').focus()"
                _="on keyup[key is 'Escape'] reset() on me then hide me then show #btn-subtask-create">
                <div class="py-2"">
                    <input autocapitalize="none" class="form-input block py-1 px-23 border-0 w-full placeholder:font-semibold font-semibold" name="title" placeholder="Sub-task name" required autofocus>
                    <textarea
                        autofocus
                        name="descr"
                        placeholder="Description..."
                        x-data="{
                            resize () {
                                $el.style.height = '0px';
                                $el.style.height = $el.scrollHeight + 'px'
                            }
                        }"
                        x-init="$nextTick(() => resize())"
                        @input="resize()"
                        @keydown.meta.enter="$event.target.form && $event.target.form.dispatchEvent(new Event('submit'))"
                        @keydown.ctrl.enter="$event.target.form && $event.target.form.dispatchEvent(new Event('submit'))"
                        _="on keyup[key is 'Escape'] reset() the closest <form />"
                        class="form-input h-auto min-h-[40px] block py-1 px-23 border-0 w-full resize-none"
                        ></textarea>
                        <input type="hidden" name="task" value="{{ task.uuid }}">
                </div>
                <div class="flex flex-row justify-between items-center border-t border-slate-600 px-3 py-2">
                    <div>
                    </div>
                    <div class="space-x-2">
                        <button type="reset" class="btn py-1" _="on click hide the closest <form /> then show #btn-subtask-create">Cancel</button>
                        <button type="submit" class="btn py-1 bg-indigo-600 text-white">Add sub-task</button>
                    </div>
                </div>
            </form>
        </div>
        <!-- attachments -->
        <div class="space-y-4">
            <h3 class="font-bold">&nbsp;</h3>
            <div class="space-y-6">
                <ul class="list-none flex flex-wrap gap-4">
                <ul id="attachments" class="list-none text-sm flex flex-wrap gap-4">
                    {% for a in attachments %}
                        <Attachment attachment={a} />
                    {% endfor %}
                </ul>
                <!-- <div _="on dragover or dragenter halt the event
        then add .bg-slate-700 to the target
      on dragleave or drop remove .bg-slate-700 from the target
      on drop halt the event
      then call processDrop(event)" class="w-full rounded p-6 bg-slate-50/5 flex items-center justify-center text-slate-400 text-xs font-semibold cursor-pointer">
                    <p><span class="text-zinc-200">Click</span> or <span class="text-zinc-200">Drop your file here</span></p>
                </div>-->
                <form
                    hx-encoding='multipart/form-data'
                    hx-post='/attachments'
                    hx-target="previous ul"
                    hx-swap="beforeend"
                    hx-trigger="submit"
                    class="max-w-xs rounded bg-white/5 hover:cursor-pointer"
                    _='on htmx:beforeRequest show #progress then hide #upload then show #uploading on htmx:xhr:progress(loaded, total) set #progress.value to (loaded/total)*100 on htmx:afterRequest reset() me then set #progress.value to 0 then hide #progress then hide #uploading then show #upload'>
                    <div class="dark:text-zing-200 text-sm cursor-wait w-full text-center animate-pulse duration-150">
                    </div>
                    <label for="post-attachment" class="dark:text-zinc-200 text-sm cursor-pointer w-full">
                        <div id="uploading" style="display: none" class="btn text-center w-full px-16 animate-pulse duration-150 cursor-wait">Uploading...</div>
                        <div id="upload" style="display: flex" class="btn group hover:text-indigo-500 gap-2 w-full justify-start relative">
                            <div class="group-hover:bg-indigo-500 group-hover:text-white rounded-full">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 rounded-full group-hover:bg-indigo-500 transition-all p-1">
                                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                                </svg>
                            </div>
                            <span id="post-attachment-fname">Click or drag file here</span>
                            <input id="post-attachment" onchange="validate(this)" class="opacity-0 absolute file:top-0 left-0 file:w-full text-sm file:py-2 file:cursor-pointer" type='file' name='file'>
                        </div>
                        <div>
                            <progress style="display: none" id='progress' value='0' max='100' class="h-1 w-full rounded"></progress>
                        </div>
                    </label>
                    <button class="btn hover:text-indigo-500 hidden" type="submit">Upload</button>
                    <input type="hidden" name="task" value="{{ task.uuid }}">
                </form>
                </ul>
            </div>
        </div>

        <!-- comments -->
        <h3 class="font-bold">&nbsp;</h3>
        {% for c in comments %}
            <Comment comment={c} />
        {% endfor %}
        <ul class="list-none space-y-1">
            {#% for comment in html.comments %#}
            {#{ commen|safe }#}
            {#% endfor %#}
        </ul>
        <div class="flex justify-start">
            <Btn.Create id="btn-comment-create" with-text-reveal={False} focus-tag="textarea">Add comment</Btn.Create>
        </div>
        <form
            style="display: none"
            class="rounded-sm border border-slate-600"
            hx-target="previous ul" hx-swap="beforeend"
            hx-post="/comments"
            hx-on::after-request="this.reset()"
            _="on reset or keyup[key is 'Escape'] hide me then show #btn-comment-create">
            <div class="py-2"">
                <textarea
                    name="content"
                    placeholder="Type here..."
                    x-data="{
                        resize () {
                            $el.style.height = '0px';
                            $el.style.height = $el.scrollHeight + 'px'
                        }
                    }"
                    x-init="$nextTick(() => resize())"
                    @input="resize()"
                    @keydown.meta.enter="$event.target.form && $event.target.form.dispatchEvent(new Event('submit'))"
                    @keydown.ctrl.enter="$event.target.form && $event.target.form.dispatchEvent(new Event('submit'))"
                    _="on keyup[key is 'Escape'] reset() the closest <form />"
                    class="form-input h-auto min-h-[40px] block py-1 px-23 border-0 w-full resize-none"
                    autofocus></textarea>
                <input type="hidden" name="task" value="{{ task.uuid }}">
            </div>
            <div class="flex flex-row justify-between items-center border-t border-slate-600 px-3 py-2">
                <div>
                </div>
                <div class="space-x-2">
                    <button type="reset" class="btn py-1">Cancel</button>
                    <button type="submit" class="btn py-1 bg-indigo-600 text-white">Add comment</button>
                </div>
            </div>
        </form>
    </div>
</div>
<script>
    function fileIsTooLarge(input) {
        const fileSize = input.files[0].size / 1024 / 1024; // in MiB
        if (fileSize > 10)
            return true
        return false
    }
    function fileTypeIsNotAllowed(input) {
        const notAllowed = [
            'a-mime/type',
        ]
        if (notAllowed.includes(input.files[0].type))
            return true
        return false
    }
    function validate(input) {
        if (fileIsTooLarge(input)) {
            alert('File size is over 10MB. Select a smaller file please.')
            return false
        }
        if (fileTypeIsNotAllowed(input)) {
            alert('File type is not allowed. Select a different file please.')
            return false
        }

        input.form.querySelector("button[type=submit]").click()
    }
    function processDrop(ev) {
        console.log(ev)
    }
</script>
</Layout.App>
