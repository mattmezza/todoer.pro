{# def sent = False #}
<Layout.Auth title="Forgot password" img="/public/images/forgot-pwd.jpg">
    <div class="max-w-sm mx-auto w-full px-4 py-8">
        <h1 class="text-3xl text-slate-800 dark:text-slate-100 font-bold mb-6">Reset your Password</h1>
        {% if sent %}
        <div class="rounded-sm bg-emerald-500/10 border border-emerald-500/30 px-4 py-3 mb-6">
            <p class="text-sm text-emerald-200">
                If an account with that email exists, we'll send you a reset link.
            </p>
        </div>
        {% else %}
        <form action="/forgot-password" method="POST">
            <div class="space-y-4 mb-6">
                <div>
                    <label class="block text-sm font-medium mb-1" for="email">Email Address <span class="text-rose-500">*</span></label>
                    <input id="email" name="email" class="form-input w-full" type="email" required>
                </div>
            </div>
            <div class="flex justify-between items-center">
                <div class="mr-1">
                    <a class="text-sm underline hover:no-underline" href="/signup">Need an account?</a>
                </div>
                <button type="submit" class="btn bg-indigo-500 hover:bg-indigo-600 text-white whitespace-nowrap">Send Reset Link</button>
            </div>
        </form>
        {% endif %}
        <div class="pt-5 mt-6 border-t border-slate-200 dark:border-slate-700">
            <div class="text-sm">
                Already have an account? <a class="font-medium text-indigo-500 hover:text-indigo-600 dark:hover:text-indigo-400" href="/signin">Sign In</a>
            </div>
        </div>
    </div>
</Layout.Auth>


