{# def user, spaces, tasks, by_space, priority_level, priority_label, priority_color, tasks_total #}
<Layout.App spaces={{spaces}} user={{user}} title={{"Priority: " + priority_label}}>
<div class="py-6 px-4 md:px-8 lg:max-w-4xl lg:mx-auto">
    <!-- Header -->
    <div class="mb-8">
        <h1 class="text-3xl font-bold flex items-center gap-3">
            <span class="inline-flex items-center justify-center w-10 h-10 rounded-lg
                {% if priority_color == 'red' %}bg-red-500/20 text-red-400
                {% elif priority_color == 'orange' %}bg-orange-500/20 text-orange-400
                {% elif priority_color == 'yellow' %}bg-yellow-500/20 text-yellow-400
                {% elif priority_color == 'blue' %}bg-blue-500/20 text-blue-400
                {% endif %}">
                {{ priority_label }}
            </span>
            <span>Tasks</span>
        </h1>
        <p class="text-sm text-slate-500 mt-1">{{ tasks_total }} task{% if tasks_total != 1 %}s{% endif %} across all spaces</p>
    </div>

    {% if not tasks %}
    <div class="text-center py-16">
        <p class="text-slate-500">No {{ priority_label }} tasks. Nice work!</p>
    </div>
    {% else %}
        {% for space_sid, space_tasks in by_space.items() %}
        {% set space_title = space_tasks[0].space_title %}
        <div class="mb-12">
            <h2 class="text-lg font-semibold text-slate-300 mb-5">
                <a href="/space/{{ space_sid }}" class="hover:text-indigo-400 transition-colors">@{{ space_title }}</a>
            </h2>

            <!-- Group by list -->
            {% set ns = namespace(last_list_sid='') %}
            {% for task in space_tasks %}
                {% if task.list_sid != ns.last_list_sid %}
                    {% set ns.last_list_sid = task.list_sid %}
                    <h3 class="text-sm font-medium text-slate-500 mb-3 mt-6">
                        <a href="/list/{{ task.list_sid }}" class="hover:text-indigo-400 transition-colors"
                           style="color: {{ task.list_color or '#6366f1' }}">#{{ task.list_title }}</a>
                        <span class="text-slate-600">/</span>
                        <a href="/list/{{ task.list_sid }}#section-{{ task.section_sid }}"
                           class="hover:text-indigo-400 transition-colors text-slate-600">{{ task.section_title }}</a>
                    </h3>
                {% endif %}
                <div class="mb-3">
                    <a href="/task/{{ task.sid }}"
                       class="block px-3 py-2 rounded-lg hover:bg-white/5 transition-colors group">
                        <div class="flex items-center gap-2">
                            <span class="text-base font-medium text-slate-200 group-hover:text-white transition-colors
                                {% if task.complete %}line-through text-slate-600{% endif %}">
                                {{ task.title }}
                            </span>
                        </div>
                        {% if task.descr %}
                        <div class="text-sm text-slate-500 mt-0.5 truncate">{{ task.descr[:100] }}{% if task.descr|length > 100 %}...{% endif %}</div>
                        {% endif %}
                        <div class="flex gap-1.5 mt-1.5 items-center flex-wrap">
                            <span class="text-sm font-mono px-1.5 py-0.5 rounded
                                {% if priority_color == 'red' %}bg-red-500/20 text-red-400
                                {% elif priority_color == 'orange' %}bg-orange-500/20 text-orange-400
                                {% elif priority_color == 'yellow' %}bg-yellow-500/20 text-yellow-400
                                {% elif priority_color == 'blue' %}bg-blue-500/20 text-blue-400
                                {% endif %}">{{ priority_label }}</span>
                            {% if task.due_date %}
                            <span class="text-sm text-slate-500">{{ task.due_date|date_short }}</span>
                            {% endif %}
                            {% if task.tags %}
                            {% for tag in task.tags.split(',') %}
                                {% if tag.strip() %}
                                <span class="text-xs px-1.5 py-0.5 rounded-full bg-indigo-500/20 text-indigo-400">+{{ tag.strip() }}</span>
                                {% endif %}
                            {% endfor %}
                            {% endif %}
                        </div>
                    </a>
                </div>
            {% endfor %}
        </div>
        {% endfor %}
    {% endif %}
</div>
</Layout.App>
