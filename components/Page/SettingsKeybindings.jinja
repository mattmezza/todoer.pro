{# def user, spaces, keybindings={}, defaults={} #}
<Layout.App spaces={{spaces}} user={{user}} title="Keybindings">
<div class="py-8 px-4 md:px-8 max-w-screen-md mx-auto space-y-8">
    <div class="flex items-center justify-between">
        <h1 class="text-2xl font-bold">Settings</h1>
    </div>

    <!-- Navigation -->
    <div class="flex gap-4 border-b border-slate-700 pb-2">
        <a href="/settings" class="text-sm text-slate-400 hover:text-white pb-2 -mb-2.5">General</a>
        <span class="text-sm font-semibold text-indigo-400 border-b-2 border-indigo-400 pb-2 -mb-2.5">Keybindings</span>
    </div>

    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-indigo-400">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m6.75 7.5 3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0 0 21 18V6a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 6v12a2.25 2.25 0 0 0 2.25 2.25Z" />
                </svg>
                <h2 class="text-lg font-bold">Keyboard Shortcuts</h2>
            </div>
            <form hx-post="/settings/keybindings/reset" hx-swap="none">
                <button type="submit" class="text-xs text-slate-400 hover:text-white cursor-pointer">Reset to defaults</button>
            </form>
        </div>
        <p class="text-sm text-slate-400">Customize keyboard shortcuts. Use modifier keys like <kbd class="px-1 py-0.5 rounded bg-slate-700 text-slate-400 font-mono text-xs">Alt</kbd>, <kbd class="px-1 py-0.5 rounded bg-slate-700 text-slate-400 font-mono text-xs">Meta</kbd> (Cmd/Win), <kbd class="px-1 py-0.5 rounded bg-slate-700 text-slate-400 font-mono text-xs">Ctrl</kbd> with a <kbd class="px-1 py-0.5 rounded bg-slate-700 text-slate-400 font-mono text-xs">+</kbd> separator.</p>

        <form
            class="space-y-3"
            hx-put="/settings/keybindings"
            hx-swap="none">

            {% set binding_labels = {
                "quick_add": "Quick add task",
                "search": "Search",
                "shortcuts_help": "Show shortcuts help",
                "focus_sidebar": "Focus sidebar",
                "focus_main": "Focus main content",
                "search_nav_down": "Search: navigate down",
                "search_nav_up": "Search: navigate up"
            } %}

            {% for key, label in binding_labels.items() %}
            <div class="flex items-center justify-between py-2 border-b border-slate-800">
                <label class="text-sm text-slate-300">{{ label }}</label>
                <div class="flex items-center gap-2">
                    <input
                        type="text"
                        name="{{ key }}"
                        value="{{ keybindings.get(key, defaults.get(key, '')) }}"
                        class="form-input w-32 rounded px-2 py-1 text-sm text-center font-mono"
                        placeholder="{{ defaults.get(key, '') }}">
                    {% if keybindings.get(key) != defaults.get(key) and keybindings.get(key) %}
                    <span class="text-xs text-amber-400" title="Default: {{ defaults.get(key, '') }}">modified</span>
                    {% endif %}
                </div>
            </div>
            {% endfor %}

            <div class="flex justify-end gap-2 pt-4">
                <button type="submit" class="btn bg-indigo-600 text-white text-sm py-1.5 px-4">Save keybindings</button>
            </div>
        </form>

        <!-- Reference: all shortcuts -->
        <div class="mt-8 pt-6 border-t border-slate-700">
            <h3 class="text-sm font-semibold text-slate-400 mb-3">All keyboard shortcuts (read-only reference)</h3>
            <div class="text-xs text-slate-500 space-y-1">
                <p><kbd class="px-1 bg-slate-700 rounded font-mono">j/k</kbd> Move focus down/up &middot; <kbd class="px-1 bg-slate-700 rounded font-mono">gg/G</kbd> First/last &middot; <kbd class="px-1 bg-slate-700 rounded font-mono">{/}</kbd> Section bounds</p>
                <p><kbd class="px-1 bg-slate-700 rounded font-mono">x</kbd> Complete &middot; <kbd class="px-1 bg-slate-700 rounded font-mono">Enter</kbd> Open &middot; <kbd class="px-1 bg-slate-700 rounded font-mono">e</kbd> Edit &middot; <kbd class="px-1 bg-slate-700 rounded font-mono">a</kbd> Append &middot; <kbd class="px-1 bg-slate-700 rounded font-mono">cc</kbd> Clear+edit</p>
                <p><kbd class="px-1 bg-slate-700 rounded font-mono">ct</kbd> Change title &middot; <kbd class="px-1 bg-slate-700 rounded font-mono">cd</kbd> Change description &middot; <kbd class="px-1 bg-slate-700 rounded font-mono">d</kbd> Due date &middot; <kbd class="px-1 bg-slate-700 rounded font-mono">t</kbd> Tags</p>
                <p><kbd class="px-1 bg-slate-700 rounded font-mono">!1-4</kbd> Set priority &middot; <kbd class="px-1 bg-slate-700 rounded font-mono">b</kbd> Bookmark &middot; <kbd class="px-1 bg-slate-700 rounded font-mono">yy</kbd> Copy title &middot; <kbd class="px-1 bg-slate-700 rounded font-mono">v</kbd> Visual mode</p>
                <p><kbd class="px-1 bg-slate-700 rounded font-mono">f</kbd> Attach file</p>
                <p><kbd class="px-1 bg-slate-700 rounded font-mono">@#$%</kbd> Scoped search &middot; <kbd class="px-1 bg-slate-700 rounded font-mono">A</kbd> New task in section &middot; <kbd class="px-1 bg-slate-700 rounded font-mono">dd</kbd> Delete selected</p>
            </div>
        </div>
    </div>
</div>
</Layout.App>
