{# def user, spaces, tasks_by_space #}
<Layout.App spaces={spaces} user={user} title="Spaces">
    <div class="py-8 px-4 md:px-8 max-w-screen-xl mx-auto">
        <div class="flex justify-between items-center gap-4 md:p-4">
            <h1 class="text-2xl md:text-4xl font-bold px-2 py-1">Spaces</h1>
        </div>
        <div class="rounded dark:text-zinc-100 px-2 md:px-6 text-sm mt-4">
            Spaces help you to separate environments. Work from personal life, project a from project b, etc... You got the gist!
            <br />
            Create as many as you need with the + button below.
        </div>
        <ul class="my-16 space-y-1">
            {% for space in spaces|rejectattr("default") %}
            <Spaces.ListItem space={space} tasks_by_space={tasks_by_space} />
            {% else %}
            <p class="py-4 md:py-8 opacity-70 text-center italic">It looks like you didn't create a space yet.</p>
            {% endfor %}
        </ul>
        <Btn.Create id="btn-space-create" class="mb-24">Add space</Btn.Create>
        <form
            style="display: none"
            hx-target="previous ul"
            hx-swap="beforeend"
            hx-post="/spaces"
            hx-on::after-request="this.reset()"
            class="rounded-sm border border-slate-600 add-task-form mb-8"
            _="on reset or keyup[key is 'Escape'] hide me then show #btn-space-create">
            <div class="py-2"">
                <input
                    autocapitalize="none"
                    name="title"
                    placeholder="Space name"
                    autofocus
                    required
                    class="form-input block py-1 px-23 border-0 w-full font-bold placeholder:font-bold"
                >
                <textarea
                    autofocus
                    name="descr"
                    placeholder="Description"
                    x-data="{
                        resize () {
                            $el.style.height = '0px';
                            $el.style.height = $el.scrollHeight + 'px'
                        }
                    }"
                    x-init="resize()"
                    @input="resize()"
                    @keydown.meta.enter="$event.target.form && $event.target.form.dispatchEvent(new Event('submit'))"
                    @keydown.ctrl.enter="$event.target.form && $event.target.form.dispatchEvent(new Event('submit'))"
                    _="on keyup[key is 'Escape'] reset() the closest <form />"
                    class="form-input h-auto min-h-[40px] block py-1 px-23 border-0 w-full resize-none"
                    ></textarea>
            </div>
            <div class="flex flex-row justify-between items-center border-t border-slate-600 px-3 py-2">
                <div>
                </div>
                <div class="space-x-2">
                    <button type="reset" class="btn py-1">Cancel</button>
                    <button type="submit" class="btn py-1 bg-indigo-600 text-white">
                        Add space
                    </button>
                </div>
            </div>
        </form>
    </div>
    </Layout.App>

