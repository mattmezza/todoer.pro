{# def user, spaces, space, lists, list, sections, sections_by_list, view_complete, tasks_by_section, sort_by='manual', filter_priority=None, filter_due=None, filter_tags=None, all_tags=[], is_bookmarked=False, today='' #}
<div id="page-context" data-space-sid="{{ space.sid }}" data-space-title="{{ space.title }}" data-list-sid="{{ list.sid }}" data-list-title="{{ list.title }}" data-show-completed="{{ 'true' if view_complete else 'false' }}" style="display:none"></div>
    <!-- Breadcrumbs -->
    <div class="mb-4 px-4 md:px-8 lg:max-w-4xl lg:mx-auto">
        <Breadcrumbs.Items with_back_arrow={{"/space/" + space.sid}}>
            <Breadcrumbs.Item title="Go to space." href={{"/space/" + space.sid}}>
                @{{ space.title }}
            </Breadcrumbs.Item>
        </Breadcrumbs.Items>
    </div>

    <!-- Title + actions -->
    <div class="flex items-start justify-between gap-4 mb-4 px-4 md:px-8 lg:max-w-4xl lg:mx-auto">
        <div class="min-w-0 grow">
            <Lists.Title list={{list}} />
        </div>
        <div class="flex items-center gap-2 shrink-0">
            <Bookmarks.Toggle entity_type="list" entity_uuid={{list.uuid}} bookmarked={{is_bookmarked}} />
            <Btn.CopyId id={{list.sid}} prefix="#" title={{"Copy list id (#" + list.sid + ")"}} />
            <Lists.Actions list={{list}} view_complete={{view_complete}} is_bookmarked={{is_bookmarked}} board_view={{True}} />
        </div>
    </div>

    <!-- Description -->
    <div class="mb-6 px-4 md:px-8 lg:max-w-4xl lg:mx-auto">
        <Lists.Descr list={{list}} />
    </div>

    <!-- Filter/Sort bar -->
    <div class="px-4 md:px-8 lg:max-w-4xl lg:mx-auto">
        <Tasks.FilterBar list={{list}} sort_by={{sort_by}} filter_priority={{filter_priority}} filter_due={{filter_due}} filter_tags={{filter_tags}} all_tags={{all_tags}} />
    </div>

    <!-- Dialogs (hidden until triggered) -->
    <Dialog.Closable id="dialog-list-move" class="md:w-1/3 mx-auto">
        <form class="space-y-8 mx-auto" hx-put="/list/{{ list.sid }}/space">
            <div class="">
                <h1 class="font-bold text-2xl">Move list <span class="font-mono">#{{ list.title }}</span> to a different space</h1>
                <h2 class="text-sm">Choose to which space you want to move <span class="font-mono">#{{ list.title }}</span></h2>
            </div>
            <main>
                <select name="space" class="rounded dark:bg-black dark:text-white cursor-pointer border-0 ring-0 w-full text-center font-mono px-4 py-2">
                    {% for sp in spaces|rejectattr("uuid", "==", space.uuid) %}
                    <option class="cursor-pointer" value="{{ sp.uuid }}">
                        @{{ sp.title }}
                    </option>
                    {% else %}
                        <p class="text-slate-300 dark:text-slate-700">You only have one space.</p>
                    {% endfor %}
                </select>
            </main>
            <footer class="flex justify-center items-center gap-4">
                <button
                    type="reset"
                    onclick="document.getElementById('dialog-list-move').close()"
                    class="px-12 py-2 rounded text-white font-bold uppercase hover:bg-slate-700 transition-all active:scale-95"
                    >
                    Cancel
                </button>
                {% if spaces|rejectattr("uuid", "==", space.uuid)|list|length %}
                <button
                    type="submit"
                    class="px-12 py-2 rounded bg-indigo-600 text-white font-bold uppercase hover:bg-indigo-700 transition-all active:scale-95"
                    >
                    Move
                </button>
                {% endif %}
            </footer>
        </form>
    </Dialog.Closable>

    <!-- Board: sections as columns -->
    <div class="overflow-x-auto pb-4 px-4 md:px-8"
         x-data="{
            selectMode: false,
            selected: [],
            toggleSelect(sid) {
                const idx = this.selected.indexOf(sid);
                if (idx === -1) {
                    this.selected.push(sid);
                } else {
                    this.selected.splice(idx, 1);
                }
            },
            isSelected(sid) {
                return this.selected.includes(sid);
            },
            selectAll() {
                const tasks = Array.from(document.querySelectorAll('.board-task[data-sid]'));
                const sids = tasks.map(el => el.dataset.sid).filter(Boolean);
                this.selected = [...new Set(sids)];
            },
            exitSelectMode() {
                this.selectMode = false;
                this.selected = [];
            },
            async bulkComplete() {
                if (!this.selected.length) return;
                const sids = [...this.selected];
                await fetch('/tasks/bulk/complete', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify(sids)
                });
                this.exitSelectMode();
                location.reload();
            },
            async bulkDelete() {
                if (!this.selected.length) return;
                if (!confirm('Delete ' + this.selected.length + ' task(s)? This cannot be undone.')) return;
                const sids = [...this.selected];
                await fetch('/tasks/bulk/delete', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify(sids)
                });
                this.exitSelectMode();
                location.reload();
            },
            async bulkMove(sectionUuid) {
                if (!this.selected.length || !sectionUuid) return;
                const sids = [...this.selected];
                await fetch('/tasks/bulk/move', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({sids, section: sectionUuid})
                });
                this.exitSelectMode();
                location.reload();
            }
         }"
         @keydown.escape.window="if (selectMode) { exitSelectMode(); $event.preventDefault(); }">

        <!-- Board columns -->
        <div id="board-columns" class="flex gap-4 min-h-[60vh]"
             style="width: max-content; min-width: 100%;">
            {% set section_def = sections|selectattr("default")|first %}
            {% set all_sections = [section_def] + (sections|rejectattr("default")|list) %}
            {% for section in all_sections %}
            <div class="board-column flex flex-col w-72 shrink-0 rounded-lg bg-slate-900/50 border border-slate-800" data-section-sid="{{ section.sid }}">
                <!-- Column header (no + button) -->
                <div class="flex items-center justify-between px-3 py-2 border-b border-slate-800">
                    <div class="flex items-center gap-2 min-w-0">
                        {% if section.default %}
                        <span class="text-sm font-semibold text-slate-300 truncate">Inbox</span>
                        {% else %}
                        <h2 class="text-sm font-semibold text-slate-300 truncate cursor-pointer"
                            _="on click hide me then show the next form then call the next input's select()">
                            ${{ section.title }}
                        </h2>
                        <form style="display:none" class="flex items-center gap-1"
                            hx-put="/section/{{ section.sid }}/title"
                            hx-swap="none"
                            x-data
                            _="on submit or reset hide me then show the previous h2"
                            @keydown.escape="$el.reset()">
                            <input name="title" value="{{ section.title }}"
                                class="w-full text-sm px-1 py-0.5 rounded border border-slate-600 bg-slate-800 text-slate-200 focus:ring-0">
                            <button type="submit" class="text-xs px-1.5 py-0.5 rounded bg-indigo-600 text-white cursor-pointer">✓</button>
                            <button type="reset" class="text-xs px-1.5 py-0.5 rounded text-slate-500 hover:text-slate-300 cursor-pointer">✕</button>
                        </form>
                        {% endif %}
                        <span class="text-xs text-slate-600 font-mono">{{ tasks_by_section[section.uuid]|length }}</span>
                    </div>
                    {% if not section.default %}
                    <button class="text-xs text-slate-500 hover:text-red-400 cursor-pointer p-0.5"
                        hx-delete="/section/{{ section.sid }}"
                        hx-confirm="Delete this section and all its tasks?"
                        hx-swap="none">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3.5 h-3.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                        </svg>
                    </button>
                    {% endif %}
                </div>

                <!-- Task cards container -->
                <div class="flex-1 overflow-y-auto p-2 space-y-2 sortable-board-tasks" data-section-sid="{{ section.sid }}" data-section-uuid="{{ section.uuid }}">
                    {% for task in tasks_by_section[section.uuid]|rejectattr("complete") %}
                    <div
                        class="board-task task rounded-lg border border-slate-700/50 bg-slate-800/30 hover:bg-slate-800/60 transition-colors p-3 cursor-pointer group"
                        data-sid="{{ task.sid }}"
                        onclick="var x=this.closest('[x-data]');if(x&&x.__x&&x.__x.$data.selectMode){x.__x.$data.toggleSelect('{{ task.sid }}');return;}window.location.href='/task/{{ task.sid }}'"
                        :class="{ 'ring-2 ring-indigo-500': isSelected('{{ task.sid }}') }">
                        <div class="flex items-start gap-2">
                            <input
                                type="checkbox"
                                class="mt-0.5 rounded dark:bg-black border-slate-600 cursor-pointer shrink-0"
                                {% if task.complete %}checked{% endif %}
                                hx-patch="/task/{{ task.sid }}/complete"
                                hx-swap="none"
                                @click.stop>
                            <div class="min-w-0 flex-1">
                                <span class="text-sm font-medium text-slate-200 line-clamp-2">{{ task.title }}</span>
                                {% if task.descr %}
                                <p class="text-xs text-slate-500 mt-1 line-clamp-2">{{ task.descr }}</p>
                                {% endif %}
                                <!-- Due date inline -->
                                {% if task.due_date %}
                                <span class="inline-flex items-center gap-1 mt-1 text-xs
                                    {% if task.due_date < today and not task.complete %}text-red-400
                                    {% elif task.due_date == today and not task.complete %}text-yellow-400
                                    {% else %}text-slate-500{% endif %}">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3 h-3">
                                      <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
                                    </svg>
                                    {{ task.due_date }}
                                </span>
                                {% endif %}
                                <!-- Tags -->
                                {% if task.tags %}
                                <div class="mt-1 flex flex-wrap gap-1">
                                    {% for tag in task.tags.split(",") %}
                                    <span class="text-xs px-1.5 py-0.5 rounded bg-indigo-500/10 text-indigo-400">+{{ tag.strip() }}</span>
                                    {% endfor %}
                                </div>
                                {% endif %}
                                <!-- Subtask progress -->
                                {% if task.num_subtasks and task.num_subtasks > 0 %}
                                <div class="mt-2 flex items-center gap-1.5 text-xs text-slate-500">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3 h-3">
                                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                                    </svg>
                                    <span>{{ task.num_completed_subtasks or 0 }}/{{ task.num_subtasks }}</span>
                                </div>
                                {% endif %}
                            </div>
                            <!-- Priority badge -->
                            {% if task.priority %}
                            <span class="text-xs font-mono shrink-0 px-1.5 py-0.5 rounded
                                {% if task.priority == 1 %}bg-red-500/20 text-red-400
                                {% elif task.priority == 2 %}bg-orange-500/20 text-orange-400
                                {% elif task.priority == 3 %}bg-yellow-500/20 text-yellow-400
                                {% elif task.priority == 4 %}bg-blue-500/20 text-blue-400{% endif %}">
                                P{{ task.priority }}
                            </span>
                            {% endif %}
                        </div>
                    </div>
                    {% endfor %}

                    <!-- Completed tasks -->
                    {% if view_complete %}
                        {% for task in tasks_by_section[section.uuid]|selectattr("complete") %}
                        <div
                            class="board-task task rounded-lg border border-slate-700/30 bg-slate-800/10 p-3 opacity-60 hover:opacity-80 transition-opacity cursor-pointer group"
                            data-sid="{{ task.sid }}"
                            onclick="var x=this.closest('[x-data]');if(x&&x.__x&&x.__x.$data.selectMode){x.__x.$data.toggleSelect('{{ task.sid }}');return;}window.location.href='/task/{{ task.sid }}'"
                            :class="{ 'ring-2 ring-indigo-500': isSelected('{{ task.sid }}'), 'opacity-100': isSelected('{{ task.sid }}') }">
                            <div class="flex items-start gap-2">
                                <input
                                    type="checkbox"
                                    checked
                                    class="mt-0.5 rounded dark:bg-black border-slate-600 cursor-pointer shrink-0"
                                    hx-patch="/task/{{ task.sid }}/complete"
                                    hx-swap="none"
                                    @click.stop>
                                <span class="text-sm text-slate-500 line-through line-clamp-2">{{ task.title }}</span>
                            </div>
                        </div>
                        {% endfor %}
                    {% endif %}

                    <!-- Add task form -->
                    <button id="board-add-btn-{{ section.uuid }}"
                        class="w-full text-xs text-slate-500 hover:text-slate-300 py-2 rounded border border-dashed border-slate-700/50 hover:border-slate-600 transition-colors cursor-pointer"
                        onclick="var f=document.getElementById('board-task-form-{{ section.uuid }}'); f.style.display='flex'; this.style.display='none'; setTimeout(function(){var i=f.querySelector('input[name=title]'); if(i) i.focus();}, 50)">
                        + Add task
                    </button>
                    <form
                        id="board-task-form-{{ section.uuid }}"
                        style="display: none"
                        class="flex-col gap-2 p-2 rounded border border-slate-700 bg-slate-800/50"
                        hx-post="/tasks"
                        hx-swap="none"
                        onkeydown="if(event.key==='Escape'){event.preventDefault();this.style.display='none';this.reset();document.getElementById('board-add-btn-{{ section.uuid }}').style.display=''}">
                        <input
                            class="form-input block w-full text-sm px-2 py-1.5 border border-slate-600 rounded focus:ring-0 bg-slate-800 placeholder:text-slate-600"
                            name="title"
                            placeholder="Task name"
                            required
                            autofocus>
                        <textarea
                            name="descr"
                            placeholder="Description (optional)"
                            rows="2"
                            class="form-input block w-full text-xs px-2 py-1 border border-slate-600 rounded focus:ring-0 bg-slate-800 placeholder:text-slate-600 resize-none"
                            oninput="this.style.height='0px';this.style.height=this.scrollHeight+'px'"
                            onkeydown="if((event.metaKey||event.ctrlKey)&&event.key==='Enter')event.target.form&&event.target.form.requestSubmit()"></textarea>
                        <div class="flex gap-1 justify-end">
                            <button type="reset"
                                class="text-xs px-2 py-1 rounded text-slate-500 hover:text-slate-300 cursor-pointer"
                                onclick="var f=this.closest('form'); f.style.display='none'; f.reset(); document.getElementById('board-add-btn-{{ section.uuid }}').style.display=''">Cancel</button>
                            <button type="submit" class="text-xs px-2 py-1 rounded bg-indigo-600 text-white cursor-pointer">Add</button>
                        </div>
                        <input type="hidden" name="section" value="{{ section.uuid }}">
                    </form>
                </div>
            </div>
            {% endfor %}

            <!-- Add section column -->
            <div class="flex flex-col w-72 shrink-0 justify-start">
                <button id="board-add-section-btn"
                    class="w-full rounded-lg border-2 border-dashed border-slate-700/50 hover:border-slate-600 text-slate-500 hover:text-slate-300 py-4 text-sm transition-colors cursor-pointer"
                    onclick="var f=document.getElementById('board-section-form'); f.style.display='block'; this.style.display='none'; setTimeout(function(){var i=f.querySelector('input[name=title]'); if(i) i.focus();}, 50)">
                    + Add section
                </button>
                <form
                    id="board-section-form"
                    style="display: none"
                    class="rounded-lg border border-slate-700 bg-slate-900/50 p-3"
                    hx-post="/sections"
                    hx-swap="none"
                    onkeydown="if(event.key==='Escape'){event.preventDefault();this.style.display='none';this.reset();document.getElementById('board-add-section-btn').style.display=''}">
                    <input
                        class="form-input block w-full text-sm px-2 py-1.5 border border-slate-600 rounded focus:ring-0 bg-slate-800 placeholder:text-slate-600 mb-2"
                        name="title"
                        placeholder="Section title"
                        required
                        autofocus>
                    <input type="hidden" name="list_id" value="{{ list.uuid }}">
                    <div class="flex gap-1 justify-end">
                        <button type="reset" class="text-xs px-2 py-1 rounded text-slate-500 hover:text-slate-300 cursor-pointer"
                            onclick="var f=this.closest('form'); f.style.display='none'; f.reset(); document.getElementById('board-add-section-btn').style.display=''">Cancel</button>
                        <button type="submit" class="text-xs px-2 py-1 rounded bg-indigo-600 text-white cursor-pointer">Add</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <Tasks.BulkActions sections_by_list={{sections_by_list}} />

    <script>
    (function() {
        var boardFocusedCol = -1;
        var boardFocusedRow = -1;

        function getBoardCols() {
            return Array.from(document.querySelectorAll('.board-column'));
        }

        function getColTasks(colEl) {
            return Array.from(colEl.querySelectorAll('.board-task.task[data-sid]')).filter(function(el) {
                return el.offsetParent !== null;
            });
        }

        function getFocusedTask() {
            return document.querySelector('.board-task.task.task-focused');
        }

        function clearBoardFocus() {
            var current = getFocusedTask();
            if (current) current.classList.remove('task-focused');
            boardFocusedCol = -1;
            boardFocusedRow = -1;
        }

        function focusBoardTask(colIdx, rowIdx) {
            clearBoardFocus();
            var cols = getBoardCols();
            if (colIdx < 0 || colIdx >= cols.length) return;
            var tasks = getColTasks(cols[colIdx]);
            if (rowIdx < 0 || rowIdx >= tasks.length) return;
            boardFocusedCol = colIdx;
            boardFocusedRow = rowIdx;
            tasks[rowIdx].classList.add('task-focused');
            tasks[rowIdx].scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        }

        var pendingBang = false;
        var bangTimeout = null;

        document.addEventListener('keydown', function(e) {
            if (e.metaKey || e.ctrlKey || e.altKey) return;
            var active = document.activeElement;
            if (active && (active.tagName === 'INPUT' || active.tagName === 'TEXTAREA' || active.tagName === 'SELECT' || active.isContentEditable)) return;

            // Only in board view
            var boardEl = document.querySelector('.board-column');
            if (!boardEl) return;

            var cols = getBoardCols();
            if (!cols.length) return;

            var focused = getFocusedTask();

            // Priority: !N
            if (pendingBang) {
                clearTimeout(bangTimeout);
                pendingBang = false;
                if (e.key >= '0' && e.key <= '4') {
                    e.preventDefault();
                    focused = getFocusedTask();
                    if (focused) {
                        var val = e.key === '0' ? '' : e.key;
                        fetch('/task/' + focused.dataset.sid + '/priority', {
                            method: 'PUT',
                            headers: {'Content-Type': 'application/x-www-form-urlencoded'},
                            body: 'priority=' + val
                        });
                        htmx.trigger(document.body, 'task-update');
                        htmx.trigger(document.body, 'task-' + focused.dataset.sid + '-update');
                    }
                    return;
                }
            }

            switch (e.key) {
                case 'j':
                    e.preventDefault();
                    if (focused && boardFocusedCol >= 0) {
                        var tasks = getColTasks(cols[boardFocusedCol]);
                        focusBoardTask(boardFocusedCol, Math.min(boardFocusedRow + 1, tasks.length - 1));
                    } else {
                        focusBoardTask(0, 0);
                    }
                    break;
                case 'k':
                    e.preventDefault();
                    if (focused && boardFocusedCol >= 0) {
                        focusBoardTask(boardFocusedCol, Math.max(boardFocusedRow - 1, 0));
                    } else {
                        var lastCol = cols.length - 1;
                        var lastTasks = getColTasks(cols[lastCol]);
                        focusBoardTask(lastCol, lastTasks.length - 1);
                    }
                    break;
                case 'h':
                    e.preventDefault();
                    if (focused && boardFocusedCol >= 0) {
                        focusBoardTask(Math.max(boardFocusedCol - 1, 0), boardFocusedRow);
                    } else {
                        focusBoardTask(0, 0);
                    }
                    break;
                case 'l':
                    e.preventDefault();
                    if (focused && boardFocusedCol >= 0) {
                        focusBoardTask(Math.min(boardFocusedCol + 1, cols.length - 1), boardFocusedRow);
                    } else {
                        focusBoardTask(0, 0);
                    }
                    break;
                case 'g':
                    if (boardFocusedCol >= 0) {
                        e.preventDefault();
                        focusBoardTask(boardFocusedCol, 0);
                    }
                    break;
                case 'G':
                    if (boardFocusedCol >= 0) {
                        e.preventDefault();
                        var tasks = getColTasks(cols[boardFocusedCol]);
                        focusBoardTask(boardFocusedCol, tasks.length - 1);
                    }
                    break;
                case 'x':
                    focused = getFocusedTask();
                    if (focused) {
                        e.preventDefault();
                        var cb = focused.querySelector('input[type="checkbox"]');
                        if (cb) cb.click();
                    }
                    break;
                case 'Enter':
                    focused = getFocusedTask();
                    if (focused) {
                        e.preventDefault();
                        var sid = focused.dataset.sid;
                        if (sid) window.location.href = '/task/' + sid;
                    }
                    break;
                case '+':
                    focused = getFocusedTask();
                    if (focused) {
                        e.preventDefault();
                        var tw = focused.querySelector('.tags-wrapper');
                        window.openTagsPicker(focused.dataset.sid, tw ? tw.dataset.tags : '');
                    }
                    break;
                case 'e':
                    focused = getFocusedTask();
                    if (focused) {
                        e.preventDefault();
                        var h2 = focused.querySelector('h2');
                        if (h2) h2.click();
                    }
                    break;
                case 'S':
                    e.preventDefault();
                    var btn = document.getElementById('board-add-section-btn');
                    if (btn) { btn.scrollIntoView({ behavior: 'smooth' }); btn.click(); }
                    break;
                case '!':
                    e.preventDefault();
                    pendingBang = true;
                    bangTimeout = setTimeout(function() { pendingBang = false; }, 1000);
                    break;
                case 'Escape':
                    if (getFocusedTask()) {
                        e.preventDefault();
                        clearBoardFocus();
                    }
                    break;
            }
        });
    })();
    </script>

    <script>
        function initSortableBoard() {
            // Task drag & drop within columns
            document.querySelectorAll('.sortable-board-tasks').forEach(function(el) {
                if (el._sortable) return;
                el._sortable = new Sortable(el, {
                    group: 'board-tasks',
                    forceFallback: true,
                    animation: 150,
                    ghostClass: 'opacity-30',
                    chosenClass: 'sortable-chosen',
                    dragClass: 'sortable-drag',
                    onEnd: function(evt) {
                        var sectionSid = el.dataset.sectionSid;
                        var sids = Array.from(el.children).map(function(li) {
                            return li.dataset.sid;
                        }).filter(Boolean);
                        fetch('/tasks/reorder', {
                            method: 'PUT',
                            headers: {'Content-Type': 'application/json'},
                            body: JSON.stringify({sids: sids, section_sid: sectionSid})
                        });
                        htmx.trigger(document.body, 'section-' + sectionSid + '-update');
                    }
                });
            });

            // Column drag & drop for sections
            var boardCols = document.getElementById('board-columns');
            if (boardCols && !boardCols._sortable) {
                boardCols._sortable = new Sortable(boardCols, {
                    animation: 150,
                    ghostClass: 'opacity-30',
                    chosenClass: 'sortable-chosen',
                    dragClass: 'sortable-drag',
                    handle: '.board-column',
                    forceFallback: true,
                    onEnd: function(evt) {
                        var sids = Array.from(boardCols.querySelectorAll('.board-column')).map(function(el) {
                            return el.dataset.sectionSid;
                        }).filter(Boolean);
                        fetch('/sections/reorder', {
                            method: 'PUT',
                            headers: {'Content-Type': 'application/json'},
                            body: JSON.stringify({sids: sids})
                        });
                    }
                });
            }
        }
        document.addEventListener('DOMContentLoaded', initSortableBoard);
        document.body.addEventListener('htmx:afterSettle', initSortableBoard);
    </script>
