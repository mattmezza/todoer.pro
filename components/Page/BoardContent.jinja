{# def user, spaces, space, lists, list, sections, sections_by_list, view_complete, tasks_by_section, sort_by='manual', filter_priority=None, filter_due=None, filter_tags=None, all_tags=[], is_bookmarked=False #}
<div id="page-context" data-space-sid="{{ space.sid }}" data-space-title="{{ space.title }}" data-list-sid="{{ list.sid }}" data-list-title="{{ list.title }}" data-show-completed="{{ 'true' if view_complete else 'false' }}" style="display:none"></div>
    <!-- Breadcrumbs -->
    <div class="mb-4">
        <Breadcrumbs.Items with_back_arrow={{"/space/" + space.sid}}>
            <Breadcrumbs.Item title="Go to space." href={{"/space/" + space.sid}}>
                @{{ space.title }}
            </Breadcrumbs.Item>
        </Breadcrumbs.Items>
    </div>

    <!-- Title + actions -->
    <div class="flex items-start justify-between gap-4 mb-4 px-4 md:px-8">
        <div class="min-w-0 grow">
            <Lists.Title list={{list}} />
        </div>
        <div class="flex items-center gap-2 shrink-0">
            <Bookmarks.Toggle entity_type="list" entity_uuid={{list.uuid}} bookmarked={{is_bookmarked}} />
            <Btn.CopyId id={{list.sid}} prefix="#" title={{"Copy list id (#" + list.sid + ")"}} />
            <Lists.Actions list={{list}} view_complete={{view_complete}} is_bookmarked={{is_bookmarked}} />
        </div>
    </div>

    <!-- Description -->
    <div class="mb-6 px-4 md:px-8">
        <Lists.Descr list={{list}} />
    </div>

    <!-- Filter/Sort bar -->
    <div class="px-4 md:px-8">
        <Tasks.FilterBar list={{list}} sort_by={{sort_by}} filter_priority={{filter_priority}} filter_due={{filter_due}} filter_tags={{filter_tags}} all_tags={{all_tags}} />
    </div>

    <!-- Dialogs (hidden until triggered) -->
    <Dialog.Closable id="dialog-list-move" class="md:w-1/3 mx-auto">
        <form class="space-y-8 mx-auto" hx-put="/list/{{ list.sid }}/space">
            <div class="">
                <h1 class="font-bold text-2xl">Move list <span class="font-mono">#{{ list.title }}</span> to a different space</h1>
                <h2 class="text-sm">Choose to which space you want to move <span class="font-mono">#{{ list.title }}</span></h2>
            </div>
            <main>
                <select name="space" class="rounded dark:bg-black dark:text-white cursor-pointer border-0 ring-0 w-full text-center font-mono px-4 py-2">
                    {% for sp in spaces|rejectattr("uuid", "==", space.uuid) %}
                    <option class="cursor-pointer" value="{{ sp.uuid }}">
                        @{{ sp.title }}
                    </option>
                    {% else %}
                        <p class="text-slate-300 dark:text-slate-700">You only have one space.</p>
                    {% endfor %}
                </select>
            </main>
            <footer class="flex justify-center items-center gap-4">
                <button
                    type="reset"
                    onclick="document.getElementById('dialog-list-move').close()"
                    class="px-12 py-2 rounded text-white font-bold uppercase hover:bg-slate-700 transition-all active:scale-95"
                    >
                    Cancel
                </button>
                {% if spaces|rejectattr("uuid", "==", space.uuid)|list|length %}
                <button
                    type="submit"
                    class="px-12 py-2 rounded bg-indigo-600 text-white font-bold uppercase hover:bg-indigo-700 transition-all active:scale-95"
                    >
                    Move
                </button>
                {% endif %}
            </footer>
        </form>
    </Dialog.Closable>

    <Dialog.Closable id="dialog-list-settings" class="md:w-1/3 mx-auto">
        <div class="space-y-4">
            <div>
                <h1 class="font-bold text-2xl">List settings</h1>
                <h2 class="text-sm">Configure <span class="font-mono">#{{ list.title }}</span></h2>
            </div>
            <div
                hx-get="/list/{{ list.sid }}/settings"
                hx-trigger="intersect once"
                hx-swap="innerHTML">
                <div class="flex justify-center py-8">
                    <svg class="animate-spin h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                </div>
            </div>
        </div>
    </Dialog.Closable>

    <!-- Board: sections as columns -->
    <div class="overflow-x-auto pb-4 px-4 md:px-8" 
         x-data="{
            selectMode: false,
            selected: [],
            toggleSelect(sid) {
                const idx = this.selected.indexOf(sid);
                if (idx === -1) {
                    this.selected.push(sid);
                } else {
                    this.selected.splice(idx, 1);
                }
            },
            isSelected(sid) {
                return this.selected.includes(sid);
            },
            selectAll() {
                const tasks = Array.from(document.querySelectorAll('.board-task[data-sid]'));
                const sids = tasks.map(el => el.dataset.sid).filter(Boolean);
                this.selected = [...new Set(sids)];
            },
            exitSelectMode() {
                this.selectMode = false;
                this.selected = [];
            },
            async bulkComplete() {
                if (!this.selected.length) return;
                const sids = [...this.selected];
                await fetch('/tasks/bulk/complete', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify(sids)
                });
                this.exitSelectMode();
                location.reload();
            },
            async bulkDelete() {
                if (!this.selected.length) return;
                if (!confirm('Delete ' + this.selected.length + ' task(s)? This cannot be undone.')) return;
                const sids = [...this.selected];
                await fetch('/tasks/bulk/delete', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify(sids)
                });
                this.exitSelectMode();
                location.reload();
            },
            async bulkMove(sectionUuid) {
                if (!this.selected.length || !sectionUuid) return;
                const sids = [...this.selected];
                await fetch('/tasks/bulk/move', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({sids, section: sectionUuid})
                });
                this.exitSelectMode();
                location.reload();
            }
         }"
         @keydown.escape.window="if (selectMode) { exitSelectMode(); $event.preventDefault(); }">
        <div class="flex gap-4 min-h-[60vh]" style="min-width: max-content;">
            {% set section_def = sections|selectattr("default")|first %}
            {% set all_sections = [section_def] + (sections|rejectattr("default")|list) %}
            {% for section in all_sections %}
            <div class="flex flex-col w-72 shrink-0 rounded-lg bg-slate-900/50 dark:bg-slate-900/50 border border-slate-800">
                <!-- Column header -->
                <div class="flex items-center justify-between px-3 py-2 border-b border-slate-800">
                    <div class="flex items-center gap-2 min-w-0">
                        {% if section.default %}
                        <span class="text-sm font-semibold text-slate-300 truncate">Inbox</span>
                        {% else %}
                        <Sections.Title section={{section}} tasks={{tasks_by_section[section.uuid]}} view_complete={{view_complete}} lists={{lists}} list={{list}} />
                        {% endif %}
                        <span class="text-xs text-slate-600 font-mono">{{ tasks_by_section[section.uuid]|length }}</span>
                    </div>
                    {% if not section.default %}
                    <Sections.Actions section={{section}} view_complete={{view_complete}} />
                    {% endif %}
                </div>

                <!-- Task cards -->
                <div class="flex-1 overflow-y-auto p-2 space-y-2 sortable-board-tasks" data-section-sid="{{ section.sid }}" data-section-uuid="{{ section.uuid }}">
                    {% for task in tasks_by_section[section.uuid]|rejectattr("complete") %}
                    <div
                        class="board-task rounded-lg border border-slate-700/50 bg-slate-800/30 hover:bg-slate-800/60 transition-colors p-3 cursor-pointer group"
                        data-sid="{{ task.sid }}"
                        @click="if (selectMode) { toggleSelect('{{ task.sid }}'); $event.preventDefault() }"
                        :class="{ 'ring-2 ring-indigo-500': isSelected('{{ task.sid }}') }"
                        onclick="if (!this.closest('[x-data]').__x.$data.selectMode) window.location.href='/task/{{ task.sid }}'">
                        <div class="flex items-start gap-2">
                            <input
                                type="checkbox"
                                class="mt-0.5 rounded dark:bg-black border-slate-600 cursor-pointer shrink-0"
                                {% if task.complete %}checked{% endif %}
                                hx-patch="/task/{{ task.sid }}/complete"
                                hx-target="closest .board-task"
                                hx-swap="outerHTML"
                                @click.stop>
                            <div class="min-w-0 flex-1">
                                <span class="text-sm font-medium text-slate-200 line-clamp-2">{{ task.title }}</span>
                                {% if task.descr %}
                                <p class="text-xs text-slate-500 mt-1 line-clamp-2">{{ task.descr }}</p>
                                {% endif %}
                            </div>
                            {% if task.priority %}
                            <span class="text-xs font-mono shrink-0 px-1.5 py-0.5 rounded
                                {% if task.priority == 1 %}bg-red-500/20 text-red-400
                                {% elif task.priority == 2 %}bg-orange-500/20 text-orange-400
                                {% elif task.priority == 3 %}bg-yellow-500/20 text-yellow-400
                                {% elif task.priority == 4 %}bg-blue-500/20 text-blue-400{% endif %}">
                                P{{ task.priority }}
                            </span>
                            {% endif %}
                        </div>
                        {% if task.due_date %}
                        <div class="mt-2 flex items-center gap-1 text-xs
                            {% if task.due_date < today %}text-red-400
                            {% elif task.due_date == today %}text-yellow-400
                            {% else %}text-slate-500{% endif %}">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3 h-3">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
                            </svg>
                            {{ task.due_date }}
                        </div>
                        {% endif %}
                        {% if task.tags %}
                        <div class="mt-2 flex flex-wrap gap-1">
                            {% for tag in task.tags.split(",") %}
                            <span class="text-xs px-1.5 py-0.5 rounded bg-indigo-500/10 text-indigo-400">+{{ tag.strip() }}</span>
                            {% endfor %}
                        </div>
                        {% endif %}
                        <!-- Subtask progress -->
                        {% if task.num_subtasks and task.num_subtasks > 0 %}
                        <div class="mt-2 flex items-center gap-1.5 text-xs text-slate-500">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3 h-3">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                            </svg>
                            <span>{{ task.num_completed_subtasks or 0 }}/{{ task.num_subtasks }}</span>
                        </div>
                        {% endif %}
                    </div>
                    {% endfor %}

                    <!-- Completed tasks in column -->
                    {% if view_complete %}
                        {% for task in tasks_by_section[section.uuid]|selectattr("complete") %}
                        <div
                            class="board-task rounded-lg border border-slate-700/30 bg-slate-800/10 p-3 opacity-60 hover:opacity-80 transition-opacity cursor-pointer group"
                            data-sid="{{ task.sid }}"
                            @click="if (selectMode) { toggleSelect('{{ task.sid }}'); $event.preventDefault() }"
                            :class="{ 'ring-2 ring-indigo-500': isSelected('{{ task.sid }}'), 'opacity-100': isSelected('{{ task.sid }}') }"
                            onclick="if (!this.closest('[x-data]').__x.$data.selectMode) window.location.href='/task/{{ task.sid }}'">
                            <div class="flex items-start gap-2">
                                <input
                                    type="checkbox"
                                    checked
                                    class="mt-0.5 rounded dark:bg-black border-slate-600 cursor-pointer shrink-0"
                                    hx-patch="/task/{{ task.sid }}/complete"
                                    hx-target="closest .board-task"
                                    hx-swap="outerHTML"
                                    @click.stop>
                                <span class="text-sm text-slate-500 line-through line-clamp-2">{{ task.title }}</span>
                            </div>
                        </div>
                        {% endfor %}
                    {% endif %}

                    <!-- Add task button -->
                    <button
                        class="w-full text-xs text-slate-500 hover:text-slate-300 py-2 rounded border border-dashed border-slate-700/50 hover:border-slate-600 transition-colors cursor-pointer"
                        onclick="document.getElementById('board-task-form-{{ section.uuid }}').style.display = 'flex'; this.style.display = 'none'">
                        + Add task
                    </button>
                    <form
                        id="board-task-form-{{ section.uuid }}"
                        style="display: none"
                        class="flex flex-col gap-2"
                        hx-post="/tasks"
                        hx-target="closest .sortable-board-tasks"
                        hx-swap="beforeend"
                        hx-on::after-request="this.reset(); this.querySelector('input').focus()"
                        @keydown.escape="$el.reset();$el.style.display='none';$el.previousElementSibling.style.display=''">
                        <input
                            class="form-input block w-full text-sm px-2 py-1.5 border border-slate-600 rounded focus:ring-0 bg-slate-800 placeholder:text-slate-600"
                            name="title"
                            placeholder="Task name"
                            required
                            autofocus>
                        <div class="flex gap-1">
                            <button type="reset" class="text-xs px-2 py-1 rounded text-slate-500 hover:text-slate-300 cursor-pointer">Cancel</button>
                            <button type="submit" class="text-xs px-2 py-1 rounded bg-indigo-600 text-white cursor-pointer">Add</button>
                        </div>
                        <input type="hidden" name="section" value="{{ section.uuid }}">
                    </form>
                </div>
            </div>
            {% endfor %}

            <!-- Add section column -->
            <div class="flex flex-col w-72 shrink-0">
                <button
                    class="w-full rounded-lg border-2 border-dashed border-slate-700/50 hover:border-slate-600 text-slate-500 hover:text-slate-300 py-4 text-sm transition-colors cursor-pointer"
                    onclick="document.getElementById('board-section-form').style.display = 'block'; this.style.display = 'none'">
                    + Add section
                </button>
                <form
                    id="board-section-form"
                    style="display: none"
                    class="rounded-lg border border-slate-700 bg-slate-900/50 p-3"
                    hx-post="/sections"
                    hx-target="#main"
                    hx-swap="innerHTML"
                    hx-on::after-request="this.reset(); this.querySelector('input').focus()"
                    @keydown.escape="$el.reset();$el.style.display='none';$el.previousElementSibling.style.display=''">
                    <input
                        class="form-input block w-full text-sm px-2 py-1.5 border border-slate-600 rounded focus:ring-0 bg-slate-800 placeholder:text-slate-600 mb-2"
                        name="title"
                        placeholder="Section title"
                        required
                        autofocus>
                    <input type="hidden" name="list" value="{{ list.uuid }}">
                    <div class="flex gap-1">
                        <button type="reset" class="text-xs px-2 py-1 rounded text-slate-500 hover:text-slate-300 cursor-pointer">Cancel</button>
                        <button type="submit" class="text-xs px-2 py-1 rounded bg-indigo-600 text-white cursor-pointer">Add</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <Tasks.BulkActions sections_by_list={{sections_by_list}} />
