{# def user, spaces, space, lists, list, sections, sections_by_list, view_complete, tasks_by_section, sort_by='manual', filter_priority=None, filter_due=None, filter_tags=None, all_tags=[], is_bookmarked=False, layout=True #}
{% if layout %}
<Layout.App spaces={{spaces}} space={{space}} user={{user}} title={{"#" + list.title}} lists={{lists}}>
{% endif %}
<div id="page-context" data-space-sid="{{ space.sid }}" data-space-title="{{ space.title }}" data-list-sid="{{ list.sid }}" data-list-title="{{ list.title }}" style="display:none"></div>
<div id="page-content"
    class="py-6 px-4 md:px-8 lg:max-w-4xl lg:mx-auto"
    x-data="{
        selectMode: false,
        selected: [],
        toggleSelect(sid) {
            const idx = this.selected.indexOf(sid);
            if (idx === -1) {
                this.selected.push(sid);
            } else {
                this.selected.splice(idx, 1);
            }
        },
        isSelected(sid) {
            return this.selected.includes(sid);
        },
        selectAll() {
            const tasks = Array.from(document.querySelectorAll('.task[data-sid]'));
            const sids = tasks.map(el => el.dataset.sid).filter(Boolean);
            this.selected = [...new Set(sids)];
        },
        exitSelectMode() {
            this.selectMode = false;
            this.selected = [];
        },
        async bulkComplete() {
            if (!this.selected.length) return;
            const sids = [...this.selected];
            await fetch('/tasks/bulk/complete', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(sids)
            });
            this.exitSelectMode();
            location.reload();
        },
        async bulkDelete() {
            if (!this.selected.length) return;
            if (!confirm('Delete ' + this.selected.length + ' task(s)? This cannot be undone.')) return;
            const sids = [...this.selected];
            await fetch('/tasks/bulk/delete', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(sids)
            });
            this.exitSelectMode();
            location.reload();
        },
        async bulkMove(sectionUuid) {
            if (!this.selected.length || !sectionUuid) return;
            const sids = [...this.selected];
            await fetch('/tasks/bulk/move', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({sids: sids, section: sectionUuid})
            });
            this.exitSelectMode();
            location.reload();
        }
    }"
    @keydown.escape.window="if (selectMode) { exitSelectMode(); $event.preventDefault(); }"
>
    <!-- Breadcrumbs -->
        <div class="mb-4">
            <Breadcrumbs.Items with_back_arrow={{"/space/" + space.sid}}>
                <Breadcrumbs.Item title="Go to space." href={{"/space/" + space.sid}}>
                    @{{ space.title }}
                </Breadcrumbs.Item>
            </Breadcrumbs.Items>
        </div>

        <!-- Title + actions -->
        <div class="flex items-start justify-between gap-4 mb-4">
            <div class="min-w-0 grow">
                <Lists.Title list={{list}} />
            </div>
            <div class="flex items-center gap-2 shrink-0">
                <Bookmarks.Toggle entity_type="list" entity_uuid={{list.uuid}} bookmarked={{is_bookmarked}} />
                <Btn.CopyId id={{list.sid}} prefix="#" title={{"Copy list id (#" + list.sid + ")"}} />
                <Lists.Actions list={{list}} view_complete={{view_complete}} is_bookmarked={{is_bookmarked}} />
            </div>
        </div>

        <!-- Description -->
        <div class="mb-6">
            <Lists.Descr list={{list}} />
        </div>

        <!-- Filter/Sort bar -->
        <Tasks.FilterBar list={{list}} sort_by={{sort_by}} filter_priority={{filter_priority}} filter_due={{filter_due}} filter_tags={{filter_tags}} all_tags={{all_tags}} />

        <!-- Dialogs (hidden until triggered) -->
        <Dialog.Closable id="dialog-list-move" class="md:w-1/3">
            <form class="space-y-8 mx-auto" hx-put="/list/{{ list.sid }}/space">
                <div class="">
                    <h1 class="font-bold text-2xl">Move list <span class="font-mono">#{{ list.title }}</span> to a different space</h1>
                    <h2 class="text-sm">Choose to which space you want to move <span class="font-mono">#{{ list.title }}</span></h2>
                </div>
                <main>
                    <select name="space" class="rounded dark:bg-black dark:text-white cursor-pointer border-0 ring-0 w-full text-center font-mono px-4 py-2">
                        {% for sp in spaces|rejectattr("uuid", "==", space.uuid) %}
                        <option class="cursor-pointer" value="{{ sp.uuid }}">
                            @{{ sp.title }}
                        </option>
                        {% else %}
                            <p class="text-slate-300 dark:text-slate-700">You only have one space.</p>
                        {% endfor %}
                    </select>
                </main>
                <footer class="flex justify-center items-center gap-4">
                    <button
                        type="reset"
                        onclick="document.getElementById('dialog-list-move').close()"
                        class="px-12 py-2 rounded text-white font-bold uppercase hover:bg-slate-700 transition-all active:scale-95"
                        >
                        Cancel
                    </button>
                    {% if spaces|rejectattr("uuid", "==", space.uuid)|list|length %}
                    <button
                        type="submit"
                        class="px-12 py-2 rounded bg-indigo-600 text-white font-bold uppercase hover:bg-indigo-700 transition-all active:scale-95"
                        >
                        Move
                    </button>
                    {% endif %}
                </footer>
            </form>
        </Dialog.Closable>

        <Dialog.Closable id="dialog-list-settings" class="md:w-1/3">
            <div class="space-y-4">
                <div>
                    <h1 class="font-bold text-2xl">List settings</h1>
                    <h2 class="text-sm">Configure <span class="font-mono">#{{ list.title }}</span></h2>
                </div>
                <div
                    hx-get="/list/{{ list.sid }}/settings"
                    hx-trigger="intersect once"
                    hx-swap="innerHTML">
                    <div class="flex justify-center py-8">
                        <svg class="animate-spin h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                    </div>
                </div>
            </div>
        </Dialog.Closable>

        <!-- Default section (inbox) -->
        <ul class="sections">
            {% set section_def = sections|selectattr("default")|first %}
            <Section
                section={{section_def}}
                sections={{sections}}
                sections_by_list={{sections_by_list}}
                view_complete={{view_complete}}
                tasks={{tasks_by_section[section_def.uuid]}}
                lists={{lists}}
                list={{list}}
            />
        </ul>

        <!-- Sections -->
        <ul id="sections" class="py-6 space-y-6">
        {% for section in sections|rejectattr("default") %}
            <Section
                section={{section}}
                sections={{sections}}
                sections_by_list={{sections_by_list}}
                view_complete={{view_complete}}
                tasks={{tasks_by_section[section.uuid]}}
                lists={{lists}}
                list={{list}}
            />
        {% endfor %}
        </ul>

        <!-- Add section -->
        <div class="pb-24">
            <Btn.Create id="btn-section-create" class="!justify-start" with-text-reveal={{False}}>Add section</Btn.Create>
            <Lists.SectionAddForm list={{list}} />
        <!-- Select all link (visible in select mode) -->
        <div x-show="selectMode" x-cloak class="flex justify-center pb-24">
            <button
                type="button"
                class="text-sm text-indigo-400 hover:text-indigo-300 underline cursor-pointer"
                @click="selectAll()"
            >Select all tasks</button>
        </div>

    </div>
    <Tasks.BulkActions sections_by_list={{sections_by_list}} />
</div>
<script>
(function() {
    function isInputFocused() {
        var active = document.activeElement;
        if (!active) return false;
        var tag = active.tagName.toLowerCase();
        return tag === 'input' || tag === 'textarea' || tag === 'select' || active.isContentEditable;
    }
    function isAnyDialogOpen() {
        var dialogs = document.getElementsByTagName('dialog');
        for (var i = 0; i < dialogs.length; i++) {
            if (dialogs[i].open) return true;
        }
        return false;
    }

    document.addEventListener('keydown', function(e) {
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        if (isInputFocused()) return;
        if (isAnyDialogOpen()) return;

        switch (e.key) {
            case 'S':
                e.preventDefault();
                var btn = document.querySelector('#btn-section-create');
                if (btn) btn.click();
                break;
        }
    });
})();
</script>
{% if layout %}
</Layout.App>
{% endif %}
