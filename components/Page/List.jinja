{# def user, spaces, space, lists, list, sections, sections_by_list, view_complete, tasks_by_section, sort_by='manual', filter_priority=None, filter_due=None, filter_tags=None, all_tags=[], is_bookmarked=False #}
<Layout.App spaces={{spaces}} space={{space}} user={{user}} title={{"#" + list.title}} lists={{lists}}>
<style>
    #list-skeleton { display: none; }
</style>
<div id="page-context" data-space-sid="{{ space.sid }}" data-space-title="{{ space.title }}" data-list-sid="{{ list.sid }}" data-list-title="{{ list.title }}" style="display:none"></div>
<div id="page-content"
    class="py-6 px-4 md:px-8 lg:max-w-4xl lg:mx-auto"
    x-data="{
        selectMode: false,
        selected: [],
        toggleSelect(sid) {
            const idx = this.selected.indexOf(sid);
            if (idx === -1) {
                this.selected.push(sid);
            } else {
                this.selected.splice(idx, 1);
            }
        },
        isSelected(sid) {
            return this.selected.includes(sid);
        },
        selectAll() {
            const tasks = Array.from(document.querySelectorAll('.task[data-sid]'));
            const sids = tasks.map(el => el.dataset.sid).filter(Boolean);
            this.selected = [...new Set(sids)];
        },
        exitSelectMode() {
            this.selectMode = false;
            this.selected = [];
        },
        async bulkComplete() {
            if (!this.selected.length) return;
            const sids = [...this.selected];
            await fetch('/tasks/bulk/complete', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(sids)
            });
            this.exitSelectMode();
            location.reload();
        },
        async bulkDelete() {
            if (!this.selected.length) return;
            if (!confirm('Delete ' + this.selected.length + ' task(s)? This cannot be undone.')) return;
            const sids = [...this.selected];
            await fetch('/tasks/bulk/delete', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(sids)
            });
            this.exitSelectMode();
            location.reload();
        },
        async bulkMove(sectionUuid) {
            if (!this.selected.length || !sectionUuid) return;
            const sids = [...this.selected];
            await fetch('/tasks/bulk/move', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({sids: sids, section: sectionUuid})
            });
            this.exitSelectMode();
            location.reload();
        }
    }"
    @keydown.escape.window="if (selectMode) { exitSelectMode(); $event.preventDefault(); }"
>
    <Page.ListContent
        user={{user}}
        spaces={{spaces}}
        space={{space}}
        lists={{lists}}
        list={{list}}
        sections={{sections}}
        sections_by_list={{sections_by_list}}
        view_complete={{view_complete}}
        tasks_by_section={{tasks_by_section}}
        sort_by={{sort_by}}
        filter_priority={{filter_priority}}
        filter_due={{filter_due}}
        filter_tags={{filter_tags}}
        all_tags={{all_tags}}
        is_bookmarked={{is_bookmarked}}
    />
</div>
<div id="list-skeleton" class="py-6 px-4 md:px-8 lg:max-w-4xl lg:mx-auto">
    <div class="space-y-5 animate-pulse">
        <div class="flex items-center gap-3">
            <div class="h-7 w-16 bg-slate-700/50 rounded"></div>
            <div class="h-7 w-32 bg-slate-700/50 rounded"></div>
        </div>
        <div class="flex items-center gap-3">
            <div class="h-5 w-40 bg-slate-700/40 rounded"></div>
        </div>
        <div class="flex items-center gap-2">
            <div class="h-6 w-14 bg-slate-700/30 rounded-lg"></div>
            <div class="h-6 w-10 bg-slate-700/30 rounded-lg"></div>
            <div class="h-6 w-12 bg-slate-700/30 rounded-lg"></div>
            <div class="h-6 w-10 bg-slate-700/30 rounded-lg"></div>
        </div>
        <div class="h-px bg-slate-700/20 my-2"></div>
        {% for i in range(6) %}
        <div class="flex items-center gap-3">
            <div class="w-4 h-4 rounded-sm bg-slate-700/30 shrink-0"></div>
            <div class="h-4 {% if loop.index == 1 %}w-3/4{% elif loop.index == 2 %}w-1/2{% elif loop.index == 3 %}w-2/3{% elif loop.index == 4 %}w-5/6{% elif loop.index == 5 %}w-1/3{% else %}w-3/5{% endif %} bg-slate-700/40 rounded"></div>
            <div class="ml-auto h-4 w-12 bg-slate-700/20 rounded shrink-0"></div>
        </div>
        {% endfor %}
        <div class="h-px bg-slate-700/20 my-2"></div>
        <div class="flex items-center gap-3">
            <div class="h-4 w-20 bg-slate-700/40 rounded"></div>
        </div>
        {% for i in range(3) %}
        <div class="flex items-center gap-3">
            <div class="w-4 h-4 rounded-sm bg-slate-700/30 shrink-0"></div>
            <div class="h-4 {% if loop.index == 1 %}w-2/3{% elif loop.index == 2 %}w-1/3{% else %}w-4/5{% endif %} bg-slate-700/40 rounded"></div>
            <div class="ml-auto h-4 w-10 bg-slate-700/20 rounded shrink-0"></div>
        </div>
        {% endfor %}
    </div>
</div>
<Tasks.BulkActions sections_by_list={{sections_by_list}} />
<script>
(function() {
    function isInputFocused() {
        var active = document.activeElement;
        if (!active) return false;
        var tag = active.tagName.toLowerCase();
        return tag === 'input' || tag === 'textarea' || tag === 'select' || active.isContentEditable;
    }
    function isAnyDialogOpen() {
        var dialogs = document.getElementsByTagName('dialog');
        for (var i = 0; i < dialogs.length; i++) {
            if (dialogs[i].open) return true;
        }
        return false;
    }

    document.addEventListener('keydown', function(e) {
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        if (isInputFocused()) return;
        if (isAnyDialogOpen()) return;

        switch (e.key) {
            case 'S':
                e.preventDefault();
                var btn = document.querySelector('#btn-section-create');
                if (btn) btn.click();
                break;
        }
    });
})();
</script>
</Layout.App>
