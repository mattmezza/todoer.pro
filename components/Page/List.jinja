{# def user, spaces, space, lists, list, sections, sections_by_list, view_complete, tasks_by_section, is_bookmarked=False #}
<Layout.App spaces={spaces} space={space} user={user} title={"#" + list.title} lists={lists}>
<div class="py-4 md:py-8 px-2 md:px-8 max-w-screen-xl mx-auto">
<!--
    <a href="/space/{{ space.sid }}" class="flex items-center gap-1 cursor-pointer mb-2 hover:text-white ml-2 md:ml-0">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 15.75L3 12m0 0l3.75-3.75M3 12h18" />
        </svg>
        <span class="font-mono">@{{ space.title }}</span>
    </a>
-->
    <div class="ml-2 md:ml-0 mb-2 md:mb-4">
        <Breadcrumbs.Items with_back_arrow={"/space/" + space.sid}>
            <Breadcrumbs.Item title="Go to space." href={"/space/" + space.sid}>
                @{{ space.title }}
            </Breadcrumbs.Item>
        </Breadcrumbs.Items>
    </div>
    <div class="ml-2 md:ml-0 flex justify-between items-center gap-4 md:py-4">
        <Lists.Title list={list} />
        <Bookmarks.Toggle entity_type="list" entity_uuid={list.uuid} bookmarked={is_bookmarked} />
        <Btn.CopyId id={list.sid} prefix="#" title={"Copy list id (#" + list.sid + ")"} />
        <Lists.Actions list={list} view_complete={view_complete} is_bookmarked={is_bookmarked} />

        <Dialog.Closable id="dialog-list-move" class="md:w-1/3">
            <form class="space-y-8 mx-auto" hx-put="/list/{{ list.sid }}/space">
                <div class="">
                    <h1 class="font-bold text-2xl">Move list <span class="font-mono">#{{ list.title }}</span> to a different space</h1>
                    <h2 class="text-sm">Choose to which space you want to move <span class="font-mono">#{{ list.title }}</span></h2>
                </div>
                <main>
                    <select name="space" class="rounded dark:bg-black dark:text-white cursor-pointer border-0 ring-0 w-full text-center font-mono px-4 py-2">
                        {% for sp in spaces|rejectattr("uuid", "==", space.uuid) %}
                        <option class="cursor-pointer" value="{{ sp.uuid }}">
                            @{{ sp.title }}
                        </option>
                        {% else %}
                            <p class="text-slate-300 dark:text-slate-700">You only have one space.</p>
                        {% endfor %}
                    </select>
                </main>
                <footer class="flex justify-center items-center gap-4">
                    <button
                        type="reset"
                        onclick="document.getElementById('dialog-list-move').close()"
                        class="px-12 py-2 rounded text-white font-bold uppercase hover:bg-slate-700 transitions-all active:pulse-95"
                        >
                        Cancel
                    </button>
                    {% if spaces|rejectattr("uuid", "==", space.uuid)|list|length %}
                    <button
                        type="submit"
                        class="px-12 py-2 rounded bg-indigo-600 text-white font-bold uppercase hover:bg-indigo-700 transitions-all active:pulse-95"
                        >
                        Move
                    </button>
                    {% endif %}
                </footer>
            </form>
        </Dialog.Closable>

        <Dialog.Closable id="dialog-list-settings" class="md:w-1/3">
            <div class="space-y-4">
                <div>
                    <h1 class="font-bold text-2xl">List settings</h1>
                    <h2 class="text-sm">Configure <span class="font-mono">#{{ list.title }}</span></h2>
                </div>
                <div
                    hx-get="/list/{{ list.sid }}/settings"
                    hx-trigger="intersect once"
                    hx-swap="innerHTML">
                    <div class="flex justify-center py-8">
                        <svg class="animate-spin h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                    </div>
                </div>
            </div>
        </Dialog.Closable>

    </div>
    <div class="ml-2 md:ml-0">
        <Lists.Descr list={list} />
    </div>
    <!-- default section (inbox) -->
    <ul class="sections">
        {% set section_def = sections|selectattr("default")|first %}
        <Section
            section={section_def}
            sections={sections}
            sections_by_list={sections_by_list}
            view_complete={view_complete}
            tasks={tasks_by_section[section_def.uuid]}
            lists={lists}
            list={list}
        />
    </ul>
    <!-- sections -->
    <ul id="sections" class="py-8 sections">
    {% for section in sections|rejectattr("default") %}
        <Section
            section={section}
            sections={sections}
            sections_by_list={sections_by_list}
            view_complete={view_complete}
            tasks={tasks_by_section[section.uuid]}
            lists={lists}
            list={list}
        />
    {% endfor %}
    </ul>
    <Btn.Create id="btn-section-create" class="mb-24" with-text-reveal={False}>Add section</Btn.Create>
    <Lists.SectionAddForm list={list} />
</Layout.App>
