{# def user, spaces, space, lists, list, sections, view_complete, tasks_by_section #}
<Layout.App spaces={spaces} space={space} user={user} title={list.title} lists={lists}>
<div class="py-4 md:py-8 px-2 md:px-8 max-w-screen-xl mx-auto">
    <a href="/space/{{ space.sid }}" class="flex items-center gap-1 text-sm cursor-pointer mb-2 hover:text-white">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 15.75L3 12m0 0l3.75-3.75M3 12h18" />
        </svg>
        <span class="font-mono">{{ space.title }}</span>
        <!--<span class="rounded-full w-3 h-3" style="background: {{ list.color }}">&nbsp;</span>
        <span>{{ list.title }}</span>-->
    </a>

    <div class="flex justify-between items-center gap-4 p-4">
        <Lists.Title list={list} />
        <!-- contextual menu -->
        <Lists.Actions list={list} view_complete={view_complete} />
    </div>
    <Lists.Descr list={list} />
    <!-- default section (inbox) -->
    <ul class="py-8 sections">
        {% set section_def = sections|selectattr("default")|first %}
        <Section
            section={section_def}
            view_complete={view_complete}
            tasks={tasks_by_section[section_def.uuid]}
        />
    </ul>
    <!-- sections -->
    <ul class="py-8 sections">
    {% for section in sections|rejectattr("default") %}
        <Section
            section={section}
            view_complete={view_complete}
            tasks={tasks_by_section[section.uuid]}
        />
    {% endfor %}
    </ul>
    <Btn.Create id="btn-section-create" class="mb-24">Add section</Btn.Create>
    <Lists.SectionAddForm list={list} />
</Layout.App>
