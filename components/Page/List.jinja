{# def user, spaces, space, lists, list, sections, sections_by_list, view_complete, tasks_by_section, sort_by='manual', filter_priority=None, filter_due=None, filter_tags=None, all_tags=[], is_bookmarked=False #}
<Layout.App spaces={{spaces}} space={{space}} user={{user}} title={{"#" + list.title}} lists={{lists}}>
<div id="page-context" data-space-sid="{{ space.sid }}" data-space-title="{{ space.title }}" data-list-sid="{{ list.sid }}" data-list-title="{{ list.title }}" data-show-completed="{{ 'true' if view_complete else 'false' }}" style="display:none"></div>
<div id="page-content"
    hx-get="/list/{{ list.sid }}"
    hx-trigger="list-{{ list.sid }}-update from:body"
    hx-target="#page-content"
    hx-swap="innerHTML"
    class="py-6 px-4 md:px-8 lg:max-w-4xl lg:mx-auto"
    x-data="{
        selectMode: false,
        selected: [],
        toggleSelect(sid) {
            const idx = this.selected.indexOf(sid);
            if (idx === -1) {
                this.selected.push(sid);
            } else {
                this.selected.splice(idx, 1);
            }
        },
        isSelected(sid) {
            return this.selected.includes(sid);
        },
        selectAll() {
            const tasks = Array.from(document.querySelectorAll('.task[data-sid]'));
            const sids = tasks.map(el => el.dataset.sid).filter(Boolean);
            this.selected = [...new Set(sids)];
        },
        exitSelectMode() {
            this.selectMode = false;
            this.selected = [];
        },
        async bulkComplete() {
            if (!this.selected.length) return;
            const sids = [...this.selected];
            await fetch('/tasks/bulk/complete', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(sids)
            });
            this.exitSelectMode();
            location.reload();
        },
        async bulkDelete() {
            if (!this.selected.length) return;
            if (!confirm('Delete ' + this.selected.length + ' task(s)? This cannot be undone.')) return;
            const sids = [...this.selected];
            await fetch('/tasks/bulk/delete', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(sids)
            });
            this.exitSelectMode();
            location.reload();
        },
        async bulkMove(sectionUuid) {
            if (!this.selected.length || !sectionUuid) return;
            const sids = [...this.selected];
            await fetch('/tasks/bulk/move', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({sids: sids, section: sectionUuid})
            });
            this.exitSelectMode();
            location.reload();
        }
    }"
    @keydown.escape.window="if (selectMode) { exitSelectMode(); $event.preventDefault(); }"
>
    <Page.ListContent
        user={{user}}
        spaces={{spaces}}
        space={{space}}
        lists={{lists}}
        list={{list}}
        sections={{sections}}
        sections_by_list={{sections_by_list}}
        view_complete={{view_complete}}
        tasks_by_section={{tasks_by_section}}
        sort_by={{sort_by}}
        filter_priority={{filter_priority}}
        filter_due={{filter_due}}
        filter_tags={{filter_tags}}
        all_tags={{all_tags}}
        is_bookmarked={{is_bookmarked}}
    />
</div>
<Tasks.BulkActions sections_by_list={{sections_by_list}} />
<script>
(function() {
    function isInputFocused() {
        var active = document.activeElement;
        if (!active) return false;
        var tag = active.tagName.toLowerCase();
        return tag === 'input' || tag === 'textarea' || tag === 'select' || active.isContentEditable;
    }
    function isAnyDialogOpen() {
        var dialogs = document.getElementsByTagName('dialog');
        for (var i = 0; i < dialogs.length; i++) {
            if (dialogs[i].open) return true;
        }
        return false;
    }

    document.addEventListener('keydown', function(e) {
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        if (isInputFocused()) return;
        if (isAnyDialogOpen()) return;

        switch (e.key) {
            case 'S':
                e.preventDefault();
                var btn = document.querySelector('#btn-section-create');
                if (btn) btn.click();
                break;
        }
    });
})();
</script>
</Layout.App>
