{# def user, space, spaces, lists, list, section, task, subtask, children, ancestors, comments, attachments, audit_log #}
<Layout.App spaces={{spaces}} space={{space}} user={{user}} title={{"%" + task.sid + " > " + subtask.title}} lists={{lists}}>
<div class="py-6 px-4 md:px-8"
     x-data="{ sidebarOpen: window.innerWidth >= 1024 ? false : true }"
     @keydown.alt.h.window="if (window.innerWidth >= 1024) sidebarOpen = false"
     @keydown.alt.l.window="if (window.innerWidth >= 1024) sidebarOpen = true">

    <div class="lg:grid lg:gap-6"
         :class="sidebarOpen ? 'lg:grid-cols-3' : 'lg:grid-cols-1 lg:max-w-4xl lg:mx-auto'">

        <!-- Left: main content -->
        <div :class="sidebarOpen ? 'lg:col-span-2' : ''">
            <div class="space-y-6">

                <!-- Breadcrumbs -->
                <Breadcrumbs.Items with_back_arrow={{"/task/" + task.sid}}>
                    <Breadcrumbs.Item title="Go to space." href={{"/space/" + space.sid}}>
                        @{{ space.title }}
                    </Breadcrumbs.Item>
                    <Breadcrumbs.Separator />
                    <Breadcrumbs.Item title="Go to list." href={{"/list/" + list.sid}}>
                        #{{ list.title }}
                    </Breadcrumbs.Item>
                    <Breadcrumbs.Separator />
                    <Breadcrumbs.Item title="Go to section." href={{"/list/" + list.sid + "#section-" + section.sid}}>
                        ${{ section.title }}
                    </Breadcrumbs.Item>
                    <Breadcrumbs.Separator />
                    <Breadcrumbs.Item title="Go to task." href={{"/task/" + task.sid}}>
                        %{{ task.title }}
                    </Breadcrumbs.Item>
                    {% for anc in ancestors %}
                    <Breadcrumbs.Separator />
                    <Breadcrumbs.Item title="Go to parent subtask." href={{"/subtask/" + anc.sid}}>
                        {{ anc.title }}
                    </Breadcrumbs.Item>
                    {% endfor %}
                </Breadcrumbs.Items>

                <!-- Title + actions -->
                <div class="flex items-start justify-between gap-4">
                    <div class="min-w-0 grow">
                        <Subtasks.Title subtask={{subtask}} />
                    </div>
                </div>

                <!-- Description -->
                <div>
                    <Subtasks.Descr subtask={{subtask}} />
                </div>

                <!-- Child subtasks -->
                <div>
                    <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Subtasks</p>
                    <ul class="list-none space-y-1">
                        {% for child in children %}
                            <Subtask subtask={{child}} />
                        {% endfor %}
                    </ul>
                    <div class="mt-2">
                        <Btn.Create id="btn-child-subtask-create" with-text-reveal={{False}} class="!justify-start">Add sub-task</Btn.Create>
                    </div>
                    <form
                        style="display: none"
                        class="rounded-sm border border-slate-600 mt-2"
                        hx-target="previous ul"
                        hx-swap="beforeend"
                        hx-post="/subtasks"
                        hx-on::after-request="this.reset();this.querySelector('input[name=title]').focus()"
                        x-data
                        @keydown.escape="$el.reset();$el.style.display='none';document.getElementById('btn-child-subtask-create').style.display=''"
                        @reset="$el.style.display='none';document.getElementById('btn-child-subtask-create').style.display=''">
                        <div class="py-2">
                            <input autocapitalize="none" class="form-input block py-1 px-3 border-0 focus:ring-0 w-full placeholder:font-semibold font-semibold md:text-base" name="title" placeholder="Sub-task name" required autofocus>
                            <textarea
                                autofocus
                                name="descr"
                                placeholder="Description..."
                                x-data="{
                                    resize () {
                                        $el.style.height = '0px';
                                        $el.style.height = $el.scrollHeight + 'px'
                                    }
                                }"
                                x-init="$nextTick(() => resize())"
                                @input="resize()"
                                @keydown.meta.enter="$event.target.form && $event.target.form.dispatchEvent(new Event('submit'))"
                                @keydown.ctrl.enter="$event.target.form && $event.target.form.dispatchEvent(new Event('submit'))"
                                class="form-input h-auto min-h-[40px] block py-1 px-3 border-0 focus:ring-0 w-full resize-none md:text-base"
                                ></textarea>
                            <input type="hidden" name="task" value="{{ subtask.task }}">
                            <input type="hidden" name="parent" value="{{ subtask.uuid }}">
                        </div>
                        <div class="flex flex-row justify-between items-center border-t border-slate-600 px-3 py-2">
                            <div></div>
                            <div class="space-x-2">
                                <button type="reset" class="btn py-1">Cancel</button>
                                <button type="submit" class="btn py-1 bg-indigo-600 text-white">Add sub-task</button>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- Comments -->
                <div>
                    <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Comments</p>
                    <div id="comments" class="space-y-4">
                        {% for c in comments %}
                            <Comment comment={{c}} />
                        {% endfor %}
                    </div>
                    <div class="mt-3 flex justify-start">
                        <Btn.Create id="btn-comment-create" with-text-reveal={{False}} focus-tag="textarea">Add comment</Btn.Create>
                    </div>
                    <form
                        style="display: none"
                        class="rounded-sm border border-slate-600 mt-3"
                        hx-target="#comments" hx-swap="beforeend"
                        hx-post="/comments"
                        hx-on::after-request="this.reset()"
                        x-data
                        @keydown.escape="$el.reset();$el.style.display='none';document.getElementById('btn-comment-create').style.display=''"
                        @reset="$el.style.display='none';document.getElementById('btn-comment-create').style.display=''">
                        <div class="py-2">
                            <textarea
                                name="content"
                                placeholder="Type here..."
                                x-data="{
                                    resize () {
                                        $el.style.height = '0px';
                                        $el.style.height = $el.scrollHeight + 'px'
                                    }
                                }"
                                x-init="$nextTick(() => resize())"
                                @input="resize()"
                                @keydown.meta.enter="$event.target.form && $event.target.form.dispatchEvent(new Event('submit'))"
                                @keydown.ctrl.enter="$event.target.form && $event.target.form.dispatchEvent(new Event('submit'))"
                                class="form-input h-auto min-h-[40px] block py-1 px-3 border-0 focus:ring-0 w-full resize-none md:text-base"
                                autofocus></textarea>
                            <input type="hidden" name="task" value="{{ task.uuid }}">
                        </div>
                        <div class="flex flex-row justify-between items-center border-t border-slate-600 px-3 py-2">
                            <div>
                            </div>
                            <div class="space-x-2">
                                <button type="reset" class="btn py-1">Cancel</button>
                                <button type="submit" class="btn py-1 bg-indigo-600 text-white">Add comment</button>
                            </div>
                        </div>
                    </form>
                </div>

            </div>
        </div>

        <!-- Right: sidebar -->
        <div x-show="sidebarOpen"
             class="space-y-6 mt-8 lg:mt-0">

            <!-- Properties card -->
            <div class="rounded-lg border border-slate-700/50 bg-zinc-950 p-4 space-y-4">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Properties</span>
                    <div class="flex items-center gap-1">
                        <button @click="sidebarOpen = false"
                                class="text-slate-500 hover:text-slate-300 p-1 rounded cursor-pointer hidden lg:block"
                                title="Hide sidebar (Alt+h)">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M18.75 19.5l-7.5-7.5 7.5-7.5m-6 15L5.25 12l7.5-7.5" />
                            </svg>
                        </button>
                        <Btn.CopyId id={{subtask.sid}} prefix="~" title={{"Copy subtask id (~" + subtask.sid + ")"}} />
                        <Menu.Ctx>
                            <Menu.CtxItem
                                tag="button"
                                title="Copy subtask id"
                                onclick="navigator.clipboard.writeText('~{{ subtask.sid }}')">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4">
                                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 0 1 1.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 0 0-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 0 1-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 0 0-3.375-3.375h-1.5a1.125 1.125 0 0 1-1.125-1.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H9.75" />
                                </svg>
                                <span class="font-mono">~{{subtask.sid}}</span>
                            </Menu.CtxItem>
                            <Menu.CtxItem
                                tag="button"
                                title="Copy permalink to subtask."
                                onclick="navigator.clipboard.writeText(window.location.origin + '/subtask/{{ subtask.sid }}')">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4">
                                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                                </svg>
                                <span>Permalink</span>
                            </Menu.CtxItem>
                            <hr class="border-slate-900">
                            <Menu.CtxItem
                                tag="button"
                                destructive={{True}}
                                hx-delete="/subtask/{{ subtask.sid }}"
                                hx-confirm="Delete this subtask and its children?"
                                hx-on:htmx:after-request="window.location.href = '/task/{{ task.sid }}'">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4">
                                  <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                                </svg>
                                <span>Delete</span>
                            </Menu.CtxItem>
                        </Menu.Ctx>
                    </div>
                </div>

                <div class="space-y-3 pt-1 border-t border-slate-700/50">
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-slate-500">Parent task</span>
                        <a href="/task/{{ task.sid }}" class="text-xs text-indigo-400 hover:text-indigo-300 font-mono">%{{ task.title }}</a>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-slate-500">Due date</span>
                        <Tasks.DueDate task={{task}} />
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-slate-500">Priority</span>
                        <Tasks.Priority task={{task}} />
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-slate-500">Tags</span>
                        <Tasks.Tags task={{task}} />
                    </div>
                </div>
            </div>

            <!-- Attachments card -->
            <div class="rounded-lg border border-slate-700/50 bg-zinc-950 p-4 space-y-3">
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Attachments</p>
                <ul id="attachments" class="list-none text-sm flex flex-wrap gap-3">
                    {% for a in attachments %}
                        <Attachment attachment={{a}} />
                    {% endfor %}
                </ul>
                <form
                    hx-encoding='multipart/form-data'
                    hx-post='/attachments'
                    hx-target="previous ul"
                    hx-swap="beforeend"
                    hx-trigger="submit"
                    class="rounded bg-white/5 hover:cursor-pointer"
                    _='on htmx:beforeRequest show #progress then hide #upload then show #uploading on htmx:xhr:progress(loaded, total) set #progress.value to (loaded/total)*100 on htmx:afterRequest reset() me then set #progress.value to 0 then hide #progress then hide #uploading then show #upload'>
                    <label for="post-attachment" class="dark:text-zinc-200 text-sm cursor-pointer w-full">
                        <div id="uploading" style="display: none" class="btn text-center w-full px-4 animate-pulse duration-150 cursor-wait text-xs">Uploading...</div>
                        <div id="upload" style="display: flex" class="btn group hover:text-indigo-500 gap-2 w-full justify-start relative text-xs">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 shrink-0">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                            </svg>
                            <span id="post-attachment-fname">Upload file</span>
                            <input id="post-attachment" onchange="validate(this)" class="opacity-0 absolute inset-0 w-full cursor-pointer" type='file' name='file'>
                        </div>
                        <progress style="display: none" id='progress' value='0' max='100' class="h-1 w-full rounded"></progress>
                    </label>
                    <button class="btn hover:text-indigo-500 hidden" type="submit">Upload</button>
                    <input type="hidden" name="task" value="{{ task.uuid }}">
                </form>
            </div>

            <!-- Activity card -->
            <div class="rounded-lg border border-slate-700/50 bg-zinc-950 p-4 space-y-3">
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Activity</p>
                <Tasks.AuditLog audit_log={{audit_log}} />
            </div>

        </div>
    </div>

    <!-- Collapsed sidebar indicators -->
    <div x-show="!sidebarOpen"
         class="fixed right-4 top-1/2 -translate-y-1/2 z-40 hidden lg:flex flex-col items-center gap-2.5">
        <button @click="sidebarOpen = true"
                class="bg-zinc-950 border border-slate-700 rounded-full p-2 hover:bg-slate-800 cursor-pointer shadow-lg group"
                title="Show sidebar (Alt+l)">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-slate-400 group-hover:text-slate-200">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 4.5l7.5 7.5-7.5 7.5m-6-15l7.5 7.5-7.5 7.5" />
            </svg>
        </button>

        <div id="sidebar-indicators"
             hx-get="/task/{{ task.sid }}/indicators"
             hx-trigger="task-update from:body"
             hx-swap="innerHTML"
             class="flex flex-col items-center gap-2.5">
            <Tasks.Indicators task={{task}} attachments={{attachments}} />
        </div>
    </div>
</div>
<script>
    function fileIsTooLarge(input) {
        const fileSize = input.files[0].size / 1024 / 1024; // in MiB
        if (fileSize > 10)
            return true
        return false
    }
    function fileTypeIsNotAllowed(input) {
        const notAllowed = [
            'a-mime/type',
        ]
        if (notAllowed.includes(input.files[0].type))
            return true
        return false
    }
    function validate(input) {
        if (fileIsTooLarge(input)) {
            alert('File size is over 10MB. Select a smaller file please.')
            return false
        }
        if (fileTypeIsNotAllowed(input)) {
            alert('File type is not allowed. Select a different file please.')
            return false
        }

        input.form.querySelector("button[type=submit]").click()
    }
    function processDrop(ev) {
        console.log(ev)
    }
</script>
<script>
(function() {
    var taskSid = '{{ task.sid }}';

    function isInputFocused() {
        var active = document.activeElement;
        if (!active) return false;
        var tag = active.tagName.toLowerCase();
        return tag === 'input' || tag === 'textarea' || tag === 'select' || active.isContentEditable;
    }
    function isAnyDialogOpen() {
        var dialogs = document.getElementsByTagName('dialog');
        for (var i = 0; i < dialogs.length; i++) {
            if (dialogs[i].open) return true;
        }
        return false;
    }

    document.addEventListener('keydown', function(e) {
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        if (isInputFocused()) return;
        if (isAnyDialogOpen()) return;

        var key = e.key;

        switch (key) {
            case 'd':
                e.preventDefault();
                var dw = document.querySelector('.due-date-wrapper[data-task-sid="' + taskSid + '"]');
                window.openDatePicker(taskSid, dw ? dw.dataset.dueDate : '');
                break;
            case '+':
                e.preventDefault();
                var tw = document.querySelector('.tags-wrapper[data-task-sid="' + taskSid + '"]');
                window.openTagsPicker(taskSid, tw ? tw.dataset.tags : '');
                break;
            case 'f':
                e.preventDefault();
                var fileInput = document.querySelector('#post-attachment');
                if (fileInput) fileInput.click();
                break;
            case 'A':
                e.preventDefault();
                var addSubBtn = document.querySelector('#btn-child-subtask-create');
                if (addSubBtn) addSubBtn.click();
                break;
            case 'C':
                e.preventDefault();
                var addCommentBtn = document.querySelector('#btn-comment-create');
                if (addCommentBtn) addCommentBtn.click();
                break;
        }
    });
})();
</script>
</Layout.App>
