{# def
    user,
    spaces,
    space,
    lists,
    list_inbox,
    sections_inbox,
    tasks_by_section_inbox,
    tasks_by_list,
    sections_by_list,
    view_complete,
    is_bookmarked=False
#}
<Layout.App spaces={{spaces}} space={{space}} user={{user}} title={{"@" + space.title}} lists={{lists}}>
<div id="page-context" data-space-sid="{{ space.sid }}" data-space-title="{{ space.title }}" style="display:none"></div>
<div
    class="py-8 px-4 md:px-8 max-w-screen-xl mx-auto"
    x-data="{
        selectMode: false,
        selected: [],
        toggleSelect(sid) {
            const idx = this.selected.indexOf(sid);
            if (idx === -1) {
                this.selected.push(sid);
            } else {
                this.selected.splice(idx, 1);
            }
        },
        isSelected(sid) {
            return this.selected.includes(sid);
        },
        selectAll() {
            const tasks = Array.from(document.querySelectorAll('.task[data-sid]'));
            const sids = tasks.map(el => el.dataset.sid).filter(Boolean);
            this.selected = [...new Set(sids)];
        },
        exitSelectMode() {
            this.selectMode = false;
            this.selected = [];
        },
        async bulkComplete() {
            if (!this.selected.length) return;
            const sids = [...this.selected];
            await fetch('/tasks/bulk/complete', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(sids)
            });
            this.exitSelectMode();
            location.reload();
        },
        async bulkDelete() {
            if (!this.selected.length) return;
            if (!confirm('Delete ' + this.selected.length + ' task(s)? This cannot be undone.')) return;
            const sids = [...this.selected];
            await fetch('/tasks/bulk/delete', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(sids)
            });
            this.exitSelectMode();
            location.reload();
        },
        async bulkMove(sectionUuid) {
            if (!this.selected.length || !sectionUuid) return;
            const sids = [...this.selected];
            await fetch('/tasks/bulk/move', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({sids: sids, section: sectionUuid})
            });
            this.exitSelectMode();
            location.reload();
        }
    }"
>
    <div class="flex justify-between items-center gap-4 md:px-2 md:py-4">
        <Spaces.Title space={{space}} />
        {% if not space.default %}
        <Bookmarks.Toggle entity_type="space" entity_uuid={{space.uuid}} bookmarked={{is_bookmarked}} />
        {% endif %}
        <Btn.CopyId id={{space.sid}} prefix="@" title={{"Copy space id (@" + space.sid + ")"}} />
        <Spaces.Actions space={{space}} view_complete={{view_complete}} is_bookmarked={{is_bookmarked}} />
    </div>
    <div>
        <Spaces.Descr space={{space}} />
    </div>

    <!-- default section (inbox) -->
    <ul class="sections">
        {% set section_def = sections_inbox|selectattr("default")|first %}
        <Section
            section={{section_def}}
            sections={{sections_inbox}}
            view_complete={{view_complete}}
            tasks={{tasks_by_section_inbox[section_def.uuid]}}
            lists={{lists}}
            list={{list_inbox}}
        />
    </ul>
    <!-- sections -->
    <ul class="py-8 sections">
    {% for section in sections_inbox|rejectattr("default") %}
        <Section
            section={{section}}
            sections={{sections_inbox}}
            view_complete={{view_complete}}
            tasks={{tasks_by_section_inbox[section.uuid]}}
            lists={{lists}}
            list={{list_inbox}}
        />
    {% endfor %}
    </ul>
    <Btn.Create id="btn-section-create" class="mb-24" with-text-reveal={{False}}>Add section</Btn.Create>
    <Lists.SectionAddForm list={{list_inbox}} />
</div>
</Layout.App>
