{# def user, spaces, space, lists, tasks_by_list, sections_by_list #}
<Layout.App spaces={spaces} space={space} user={user} title={space.title}>
    <div class="py-8 px-2 md:px-8 max-w-screen-xl mx-auto">
        <div class="flex justify-between p-4">
            <div class="">
                <h1 class="text-2xl md:text-4xl font-bold">{{ space.title }}</h1>
                {%- if space.descr %}<p class="whitespace-pre text-sm mt-4">{{ space.descr }}</p>{% endif %}
            </div>
            <Menu.Ctx>
                <button tabindex="0" class="flex gap-2 w-full first-of-type:rounded-t-md last-of-type:rounded-b-md px-4 py-2.5 text-left text-xs items-center hover:bg-gray-50 dark:hover:bg-gray-800 disabled:text-gray-500" title="Rename" _="on click hide the previous <h1 /> then show the previous <form /> then select() the previous <input />">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
                    </svg>
                    <span>Rename</span>
                </button>
                <button
                    tabindex="0"
                    class="text-red-600 flex gap-2 w-full first-of-type:rounded-t-md last-of-type:rounded-b-md px-4 py-2.5 text-left text-xs items-center hover:bg-gray-50 dark:hover:bg-gray-800 disabled:text-gray-500 hover:text-red-500 gap-1 group"
                    hx-delete="/space/{{ space.sid }}"
                    hx-confirm="Are you sure? You will lose all of this space's lists, sections and tasks."
                    hx-target="#main"
                    hx-replace-url="/"
                    title="Delete list"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                    </svg>
                    <span>Delete</span>
                </button>
            </Menu.Ctx>
        </div>
    <ul class="my-16 space-y-1">
        {% for _list in lists %}
            <Lists.ListItem list={_list} num_tasks={tasks_by_list[_list.uuid]} num_sections={sections_by_list[_list.uuid]} />
        {% endfor %}
    </ul>
    <Btn.Create id="btn-list-create">Add list</Btn.Create>
    <form
        style="display: none"
        hx-target="previous ul"
        hx-swap="beforeend"
        hx-post="/spaces"
        hx-on::after-request="this.reset()"
        class="rounded-sm border border-slate-600 add-task-form mb-2"
        _="on reset or keyup[key is 'Escape'] hide me then show #btn-list-create">
        <div class="py-2"">
            <input
                name="title"
                placeholder="Space name"
                autofocus
                class="form-input block py-1 px-23 border-0 w-full font-bold placeholder:font-bold"
            >
            <textarea
                autofocus
                name="descr"
                placeholder="Description"
                x-data="{
                    resize () {
                        $el.style.height = '0px';
                        $el.style.height = $el.scrollHeight + 'px'
                    }
                }"
                x-init="resize()"
                @input="resize()"
                @keydown.meta.enter="$event.target.form && $event.target.form.dispatchEvent(new Event('submit'))"
                @keydown.ctrl.enter="$event.target.form && $event.target.form.dispatchEvent(new Event('submit'))"
                _="on keyup[key is 'Escape'] reset() the closest <form />"
                class="form-input h-auto min-h-[40px] block py-1 px-23 border-0 w-full resize-none"
                ></textarea>
        </div>
        <div class="flex flex-row justify-between items-center border-t border-slate-600 px-3 py-2">
            <div>
            </div>
            <div class="space-x-2">
                <button type="reset" class="btn py-1">Cancel</button>
                <button type="submit" class="btn py-1 bg-indigo-600 text-white">
                    Add space
                </button>
            </div>
        </div>
    </form>
</Layout.App>
