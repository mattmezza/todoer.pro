{# def user, spaces, space #}
{% set inbox_space = spaces|selectattr("default")|first %}
{% set spaces = spaces|rejectattr("default")|list %}
<div
    class="relative"
    x-data="{
        open: false,
        toggle() {
            if (this.open) return this.close()
            this.$refs.button.focus()
            this.open = true
        },
        close(focusAfter) {
            if (!this.open) return
            this.open = false
            focusAfter && focusAfter.focus()
        },
    }"
    x-on:keydown.escape.prevent.stop="close($refs.button)"
    x-on:focusin.window="! $refs.panel.contains($event.target) && close()"
    x-id="['dropdown-button']"
    >
    <!-- Button -->
    <button
        class="sidebar-nav-item flex gap-2 justify-start items-center group w-full p-2 dark:hover:bg-gray-900 transition-all active:scale-95 rounded"
        type="button"
        x-ref="button"
        @click="toggle()"
        @click.away="close($refs.button)"
        tabindex="0"
        :aria-expanded="open"
        :aria-controls="$id('dropdown-button')"
        aria-expanded="false"
        aria-haspopup>
        <img class="w-8 h-8 rounded-full" src="https://www.gravatar.com/avatar/{{ user.email_hash }}.jpg?s=100" width="32" height="32" alt="User">
        <div class="ml-1 text-left flex-grow">
            <div class="text-sm font-semibold text-slate-800 dark:text-slate-100">{{ user.name|default('') }}</div>
            {%- if space %}<div class="text-xs text-slate-500 dark:text-slate-400 font-mono">@{{ space.title[:20] }}</div>{% endif %}
        </div>
        <div class="text-slate-300 dark:text-slate-700">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
              <path fill-rule="evenodd" d="M11.47 4.72a.75.75 0 0 1 1.06 0l3.75 3.75a.75.75 0 0 1-1.06 1.06L12 6.31 8.78 9.53a.75.75 0 0 1-1.06-1.06l3.75-3.75Zm-3.75 9.75a.75.75 0 0 1 1.06 0L12 17.69l3.22-3.22a.75.75 0 1 1 1.06 1.06l-3.75 3.75a.75.75 0 0 1-1.06 0l-3.75-3.75a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
            </svg>
        </div>
    </button>
    <!-- Panel -->
    <div
        class="z-10 absolute bottom-[102%] left-0 min-w-44 bg-white dark:bg-gray-900 py-1.5 rounded shadow-lg overflow-hidden mt-1"
        x-ref="panel"
        x-show="open"
        :id="$id('dropdown-button')"
        style="display: none">
        {% if spaces|list|length %}
        <div class="py-2 mb-2 border-b border-slate-300 dark:border-slate-800">
            <h1 class="uppercase dark:text-slate-500 text-slate-600 font-semibold text-xs px-3">Spaces</h1>
            <ul class="font-mono">
                {% for sp in spaces %}
                <li>
                    <a
                        class="text-sm hover:font-semibold flex items-center py-1 px-3{%- if space and space.sid == sp.sid %} font-bold dark:text-white text-black{% else %} font-medium dark:text-zinc-200{% endif %}"
                        href="/space/{{ sp.sid }}">
                        @{{ sp.title[:20] }}
                    </a>
                </li>
                {% endfor %}
            </ul>
        </div>
        {% endif %}
        <ul>
            <li>
                <a
                    class="font-medium text-sm dark:text-zinc-200 hover:font-semibold flex items-center py-1 px-3"
                    href="/spaces">
                    Manage spaces
                </a>
            </li>
            <li>
                <a
                    class="font-medium text-sm dark:text-zinc-200 hover:font-semibold flex items-center py-1 px-3"
                    href="/account">
                    Account
                </a>
            </li>
            <li>
                <a
                    class="font-medium text-sm dark:text-zinc-200 hover:font-semibold flex items-center py-1 px-3"
                    href="/settings">
                    Settings
                </a>
            </li>
            <li>
                <button
                    id="about-btn"
                    class="font-medium text-sm dark:text-zinc-200 hover:font-semibold flex items-center py-1 px-3 cursor-pointer w-full"
                >
                    About
                </button>
                <script>
                function openAboutModal(e) {
                    e.preventDefault()
                    setTimeout(() => document.getElementById('modal-about').showModal(), 0)
                }
                document.getElementById('about-btn').addEventListener('click', openAboutModal)
                </script>
            </li>
            <li>
                <a class="font-medium text-sm text-red-500 hover:font-semibold flex items-center py-1 px-3"
                    href="/signout">
                    Sign Out
                </a>
            </li>
        </ul>
    </div>
</div>

