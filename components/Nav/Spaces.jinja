{# def spaces #}
<div>
    <h3 class="text-xs uppercase text-slate-500 font-semibold pl-3">
        <span class="hidden lg:block lg:sidebar-expanded:hidden 2xl:hidden text-center w-6"
            aria-hidden="true">•••</span>
        <span class="lg:hidden lg:sidebar-expanded:block 2xl:block">Spaces</span>
    </h3>
    <ul
        hx-get="/nav/spaces"
        hx-trigger="space-delete from:body, space-create from:body, space-update from:body"
        hx-target="closest div"
        class="mt-3 text-sm font-semibold">
        {% for space in spaces|rejectattr("default") %}
            <Nav.Spaces.Item space={space} />
        {% endfor %}
    </ul>
    {%- if False %}
    <button
        class="btn block text-slate-500 transition cursor-pointer hover:text-indigo-600 active:scale-95 group gap-2"
        _="on click showModal() on the next <dialog />"
    >
        <div class="flex items-center justify-between">
            <div class="flex items-center">
                <div class="dark:text-slate-700 dark:group-hover:bg-indigo-500 dark:group-hover:text-white rounded-full">
                    <svg
                        class="w-6 h-6 group-hover:text-slate-200 group-hover:rounded-full group-hover:bg-indigo-600"
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewbox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentcolor"
                    >
                        <path stroke-linecap="round" stroke-linejoin="round" d="m12 4.5v15m7.5-7.5h-15" />
                    </svg>
                </div>
                <span
                    class="hidden group-hover:block text-sm font-medium ml-2">
                    Add space
                </span>
            </div>
        </div>
    </button>
    <Dialog.Create
        title={"Add a new space"}
        subtitle={"Spaces help you to separate environments. Work from personal life, project a from project b, etc... You got the gist!"}
        action={"/spaces"}
    >
        <div class="flex flex-col gap-3 mt-4">
            <div class="space-y-1">
                <div class="text-xs flex flex-row items-center">
                    <span>Space name</span>
                </div>
                <input
                    tabindex="0"
                    autofocus
                    required
                    class="form-input w-full"
                    name="title"
                    placeholder="type here..." />
                <div class="text-xs flex flex-row items-center justify-end">
                </div>
            </div>
            <div class="space-y-1">
                <div class="text-xs flex flex-row items-center">
                    <span>Description</span>
                </div>
                <textarea class="form-input w-full resize-none" name="descr"
                    placeholder="type here..."></textarea>
                <div class="text-xs flex flex-row items-center justify-end">
                </div>
            </div>
        </div>
    </Dialog.Create>
    {% endif %}
</div>
