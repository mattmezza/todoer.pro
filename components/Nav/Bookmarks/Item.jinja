{# def bookmark #}
<li class="px-3 py-2 rounded-sm mb-0.5 last:mb-0">
    <a
        class="block text-slate-700 hover:text-black dark:text-slate-200 hover:dark:text-white truncate transition duration-150 cursor-pointer active:scale-95{{ ' !text-slate-100 !font-black' if cur_path_starts_with(('/' + bookmark.entity_type + '/' + bookmark.entity_sid) if bookmark.entity_sid else '/___') else ' font-medium' }}"
        href="/{{ bookmark.entity_type }}/{{ bookmark.entity_sid }}">
        <div class="flex items-center">
            {% if bookmark.entity_type == 'list' %}
            <span class="rounded-full shrink-0 w-4 h-4" style="background-color: {{ bookmark.entity_color or '#6366f1' }}">&nbsp;</span>
            <span class="text-sm ml-2 lg:opacity-0 lg:sidebar-expanded:opacity-100 2xl:opacity-100 duration-200 text-ellipsis overflow-hidden font-mono">#{{ bookmark.entity_title[0:20] if bookmark.entity_title else '...' }}</span>
            {% else %}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 shrink-0 text-yellow-400">
              <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z" clip-rule="evenodd" />
            </svg>
            <span class="text-sm ml-2 lg:opacity-0 lg:sidebar-expanded:opacity-100 2xl:opacity-100 duration-200 text-ellipsis overflow-hidden font-mono">@{{ bookmark.entity_title[0:20] if bookmark.entity_title else '...' }}</span>
            {% endif %}
        </div>
    </a>
</li>
