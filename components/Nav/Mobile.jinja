{# def space, spaces, lists #}
<nav class="lg:hidden fixed bottom-0 inset-x-0 z-50 bg-zinc-950/90 backdrop-blur-md border-t border-slate-800 pb-[env(safe-area-inset-bottom)]">
    <div class="flex items-center justify-around h-14">
        <!-- Home -->
        <a href="/dashboard"
           class="flex flex-col items-center gap-0.5 px-3 py-1.5 rounded-lg {{ 'text-indigo-400' if cur_path_starts_with('/dashboard') else 'text-slate-500 hover:text-slate-300' }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
              <path d="M11.47 3.841a.75.75 0 0 1 1.06 0l8.69 8.69a.75.75 0 1 0 1.06-1.061l-8.689-8.69a2.25 2.25 0 0 0-3.182 0l-8.69 8.69a.75.75 0 1 0 1.061 1.06l8.69-8.689Z" />
              <path d="m12 5.432 8.159 8.159c.03.03.06.058.091.086v6.198c0 1.035-.84 1.875-1.875 1.875H15a.75.75 0 0 1-.75-.75v-4.5a.75.75 0 0 0-.75-.75h-3a.75.75 0 0 0-.75.75V21a.75.75 0 0 1-.75.75H5.625a1.875 1.875 0 0 1-1.875-1.875v-6.198a2.29 2.29 0 0 0 .091-.086L12 5.432Z" />
            </svg>
            <span class="text-[10px] font-medium">Home</span>
        </a>

        <!-- Inbox -->
        <a href="/inbox"
           class="flex flex-col items-center gap-0.5 px-3 py-1.5 rounded-lg {{ 'text-indigo-400' if cur_path_starts_with('/inbox') else 'text-slate-500 hover:text-slate-300' }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
              <path fill-rule="evenodd" d="M1.5 9.832v1.793c0 1.036.84 1.875 1.875 1.875h17.25c1.035 0 1.875-.84 1.875-1.875V9.832a3 3 0 0 0-.722-1.952l-3.285-3.832A3 3 0 0 0 16.215 3h-8.43a3 3 0 0 0-2.278 1.048L2.222 7.88A3 3 0 0 0 1.5 9.832ZM7.785 4.5a1.5 1.5 0 0 0-1.139.524L3.881 8.25h3.165a3 3 0 0 1 2.496 1.336l.164.246a1.5 1.5 0 0 0 1.248.668h2.092a1.5 1.5 0 0 0 1.248-.668l.164-.246a3 3 0 0 1 2.496-1.336h3.165l-2.765-3.226a1.5 1.5 0 0 0-1.139-.524h-8.43Z" clip-rule="evenodd" />
              <path d="M2.813 15c-.725 0-1.313.588-1.313 1.313V18a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3v-1.688c0-.724-.588-1.312-1.313-1.312h-4.233a3 3 0 0 0-2.496 1.336l-.164.246a1.5 1.5 0 0 1-1.248.668h-2.092a1.5 1.5 0 0 1-1.248-.668l-.164-.246A3 3 0 0 0 7.046 15H2.812Z" />
            </svg>
            <span class="text-[10px] font-medium">Inbox</span>
        </a>

        <!-- Quick Add -->
        <button
            x-data
            @click="htmx.ajax('GET', '/tasks/quick-add', {target: '#quick-add-content', swap: 'innerHTML'}).then(function() { document.getElementById('quick-add-dialog').showModal(); $nextTick(() => document.getElementById('quick-add-title')?.focus()); })"
            class="flex flex-col items-center gap-0.5 px-3 py-1.5 rounded-lg text-slate-500 hover:text-slate-300">
            <div class="w-9 h-9 -mt-3 rounded-full bg-indigo-600 flex items-center justify-center shadow-lg shadow-indigo-600/30">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-white">
                  <path fill-rule="evenodd" d="M12 3.75a.75.75 0 0 1 .75.75v6.75h6.75a.75.75 0 0 1 0 1.5h-6.75v6.75a.75.75 0 0 1-1.5 0v-6.75H5.25a.75.75 0 0 1 0-1.5h6.75V4.5a.75.75 0 0 1 .75-.75Z" clip-rule="evenodd" />
                </svg>
            </div>
            <span class="text-[10px] font-medium">Add</span>
        </button>

        <!-- Search -->
        <button
            x-data
            @click="document.getElementById('search-dialog').showModal(); $nextTick(() => { document.getElementById('search-input').value = ''; document.getElementById('search-input').focus(); })"
            class="flex flex-col items-center gap-0.5 px-3 py-1.5 rounded-lg text-slate-500 hover:text-slate-300">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
              <path fill-rule="evenodd" d="M10.5 3.75a6.75 6.75 0 1 0 0 13.5 6.75 6.75 0 0 0 0-13.5ZM2.25 10.5a8.25 8.25 0 1 1 14.59 5.28l4.69 4.69a.75.75 0 1 1-1.06 1.06l-4.69-4.69A8.25 8.25 0 0 1 2.25 10.5Z" clip-rule="evenodd" />
            </svg>
            <span class="text-[10px] font-medium">Search</span>
        </button>

        <!-- Account -->
        <a href="/account"
           class="flex flex-col items-center gap-0.5 px-3 py-1.5 rounded-lg {{ 'text-indigo-400' if cur_path_starts_with('/account') else 'text-slate-500 hover:text-slate-300' }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
              <path fill-rule="evenodd" d="M18.685 19.097A9.723 9.723 0 0 0 21.75 12c0-5.385-4.365-9.75-9.75-9.75S2.25 6.615 2.25 12a9.723 9.723 0 0 0 3.065 7.097A9.716 9.716 0 0 0 12 21.75a9.716 9.716 0 0 0 6.685-2.653Zm-12.54-1.285A7.486 7.486 0 0 1 12 15a7.486 7.486 0 0 1 5.855 2.812A8.224 8.224 0 0 1 12 20.25a8.224 8.224 0 0 1-5.855-2.438ZM15.75 9a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" clip-rule="evenodd" />
            </svg>
            <span class="text-[10px] font-medium">Account</span>
        </a>
    </div>
</nav>
