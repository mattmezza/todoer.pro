{# def space, spaces, lists #}
<div x-data="{ open: false }" class="lg:hidden fixed bottom-0 z-50 w-full dark:bg-gray-950/80 backdrop-blur-sm border-t border-slate-800 py-4 flex flex-col gap-8 items-center rounded-t" @click.outside="open = false">
    <button @click="open = true" x-show="!open" class="hover:text-indigo-500 w-full cursor-pointer font-bold flex justify-center p-4">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
          <path fill-rule="evenodd" d="M3 6.75A.75.75 0 0 1 3.75 6h16.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 6.75ZM3 12a.75.75 0 0 1 .75-.75h16.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 12Zm0 5.25a.75.75 0 0 1 .75-.75h16.5a.75.75 0 0 1 0 1.5H3.75a.75.75 0 0 1-.75-.75Z" clip-rule="evenodd" />
        </svg>
    </button>
    <!--<button @click="open = false" x-show="open" class="hover:text-indigo-500 w-full cursor-pointer uppercase font-bold">Close</button>-->
    <div x-show="open" class="space-y-4 w-full px-4">
        <div class="text-left space-y-3 text-lg">
            {%- if cur_path_starts_with("/dashboard") -%}
                {% if spaces and not space and spaces|rejectattr("default")|list|length %}
                <a href="/spaces" class="uppercase font-bold hover:text-slate-100 hover:font-bold cursor-pointer">Spaces</a>
                <ul class="font-mono space-y-1">
                    {% for space in spaces|rejectattr("default") %}
                    <li>
                        <a class="hover:text-slate-100 hover:font-bold cursor-pointer" href="/space/{{ space.sid }}">
                            @{{ space.title[0:30] }}
                        </a>
                    </li>
                    {% endfor %}
                </ul>
                {% endif %}
            {% else %}
            {% if space and lists is defined and lists|rejectattr("default")|list|length > 0 and not space.default %}
                <a href="/space/{{ space.sid }}" class="uppercase font-bold hover:text-slate-100 hover:font-bold cursor-pointer">Lists</a>
                <ul class="font-mono space-y-1">
                    {% for list_ in lists|rejectattr("default") %}
                    <li>
                        <a class="hover:text-slate-100 hover:font-bold cursor-pointer" href="/list/{{ list_.sid }}">
                            #{{ list_.title[0:30] }}
                        </a>
                    </li>
                    {% endfor %}
                </ul>
                {% endif %}
            {% endif %}
        </div>
        <div class="grid grid-flow-col auto-cols-max justify-center gap-4">
            <a
                class="hover:text-indigo-500 cursor-pointer block p-4 rounded"
                href="/dashboard">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
                  <path d="M11.47 3.841a.75.75 0 0 1 1.06 0l8.69 8.69a.75.75 0 1 0 1.06-1.061l-8.689-8.69a2.25 2.25 0 0 0-3.182 0l-8.69 8.69a.75.75 0 1 0 1.061 1.06l8.69-8.689Z" />
                  <path d="m12 5.432 8.159 8.159c.03.03.06.058.091.086v6.198c0 1.035-.84 1.875-1.875 1.875H15a.75.75 0 0 1-.75-.75v-4.5a.75.75 0 0 0-.75-.75h-3a.75.75 0 0 0-.75.75V21a.75.75 0 0 1-.75.75H5.625a1.875 1.875 0 0 1-1.875-1.875v-6.198a2.29 2.29 0 0 0 .091-.086L12 5.432Z" />
                </svg>
            </a>
            <a
                class="hover:text-indigo-500 cursor-pointer block p-4 rounded"
                href="/inbox">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
                  <path fill-rule="evenodd" d="M1.5 9.832v1.793c0 1.036.84 1.875 1.875 1.875h17.25c1.035 0 1.875-.84 1.875-1.875V9.832a3 3 0 0 0-.722-1.952l-3.285-3.832A3 3 0 0 0 16.215 3h-8.43a3 3 0 0 0-2.278 1.048L2.222 7.88A3 3 0 0 0 1.5 9.832ZM7.785 4.5a1.5 1.5 0 0 0-1.139.524L3.881 8.25h3.165a3 3 0 0 1 2.496 1.336l.164.246a1.5 1.5 0 0 0 1.248.668h2.092a1.5 1.5 0 0 0 1.248-.668l.164-.246a3 3 0 0 1 2.496-1.336h3.165l-2.765-3.226a1.5 1.5 0 0 0-1.139-.524h-8.43Z" clip-rule="evenodd" />
                  <path d="M2.813 15c-.725 0-1.313.588-1.313 1.313V18a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3v-1.688c0-.724-.588-1.312-1.313-1.312h-4.233a3 3 0 0 0-2.496 1.336l-.164.246a1.5 1.5 0 0 1-1.248.668h-2.092a1.5 1.5 0 0 1-1.248-.668l-.164-.246A3 3 0 0 0 7.046 15H2.812Z" />
                </svg>
            </a>
            <button
                _="on click showModal() on #search-dialog then set #search-input.value to '' then call #search-input.focus()"
                class="hover:text-indigo-500 cursor-pointer block p-4 rounded">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
                  <path fill-rule="evenodd" d="M10.5 3.75a6.75 6.75 0 1 0 0 13.5 6.75 6.75 0 0 0 0-13.5ZM2.25 10.5a8.25 8.25 0 1 1 14.59 5.28l4.69 4.69a.75.75 0 1 1-1.06 1.06l-4.69-4.69A8.25 8.25 0 0 1 2.25 10.5Z" clip-rule="evenodd" />
                </svg>
            </button>
            {%- if space %}
            <button
                _="on click showModal() on the next <dialog />"
                class="hover:text-indigo-500 cursor-pointer block p-4 rounded">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v6m3-3H9m12 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                </svg>
            </button>
            {% endif %}
            <a
                class="hover:text-indigo-500 cursor-pointer block p-4 rounded"
                href="/account">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
                  <path fill-rule="evenodd" d="M18.685 19.097A9.723 9.723 0 0 0 21.75 12c0-5.385-4.365-9.75-9.75-9.75S2.25 6.615 2.25 12a9.723 9.723 0 0 0 3.065 7.097A9.716 9.716 0 0 0 12 21.75a9.716 9.716 0 0 0 6.685-2.653Zm-12.54-1.285A7.486 7.486 0 0 1 12 15a7.486 7.486 0 0 1 5.855 2.812A8.224 8.224 0 0 1 12 20.25a8.224 8.224 0 0 1-5.855-2.438ZM15.75 9a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" clip-rule="evenodd" />
                </svg>
            </a>
            <a
                class="hover:text-indigo-500 block p-4 rounded"
                href="/signout">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
                  <path fill-rule="evenodd" d="M7.5 3.75A1.5 1.5 0 0 0 6 5.25v13.5a1.5 1.5 0 0 0 1.5 1.5h6a1.5 1.5 0 0 0 1.5-1.5V15a.75.75 0 0 1 1.5 0v3.75a3 3 0 0 1-3 3h-6a3 3 0 0 1-3-3V5.25a3 3 0 0 1 3-3h6a3 3 0 0 1 3 3V9A.75.75 0 0 1 15 9V5.25a1.5 1.5 0 0 0-1.5-1.5h-6Zm10.72 4.72a.75.75 0 0 1 1.06 0l3 3a.75.75 0 0 1 0 1.06l-3 3a.75.75 0 1 1-1.06-1.06l1.72-1.72H9a.75.75 0 0 1 0-1.5h10.94l-1.72-1.72a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                </svg>
            </a>
        </div>
        {%- if space %}
            <Dialog.Create
                title={{"Add a new list"}}
                subtitle={{"You can choose a color to mark your list and set a description for the kind of tasks it will hold."}}
                action={{"/lists"}}
                hidden_vals={{{'space': space.uuid}}}
                hx_target="#nav-lists"
            >
                <div class="flex flex-col gap-3 mt-4">
                    <div class="space-y-1">
                        <div class="text-sm flex flex-row items-center">
                            <span>Color</span>
                        </div>
                        <input tabindex="1" type="color"
                            class="bg-transparent border-0 rounded outline-none" name="color"
                            value="#ff0000" />
                        <div class="text-sm flex flex-row items-center justify-end">
                        </div>
                    </div>
                    <div class="space-y-1">
                        <div class="text-sm flex flex-row items-center">
                            <span>List name</span>
                        </div>
                        <input tabindex="0" autofocus class="form-input w-full" name="title"
                            placeholder="Type here..." value="">
                        <div class="text-sm flex flex-row items-center justify-end">
                        </div>
                    </div>
                    <div class="space-y-1">
                        <div class="text-sm flex flex-row items-center">
                            <span>Description</span>
                        </div>
                        <textarea class="form-input w-full resize-none" name="descr"
                            placeholder="Type here..."></textarea>
                        <div class="text-sm flex flex-row items-center justify-end">
                        </div>
                    </div>
                </div>
            </Dialog.Create>
        {% endif %}
    </div>
</div>

