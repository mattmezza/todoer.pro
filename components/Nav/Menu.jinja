{# def spaces, user, space, lists #}
<div class="min-w-fit">
    <!-- Sidebar -->
    <div id="sidebar"
        class="flex flex-col absolute z-40 left-0 top-0 lg:static lg:left-auto lg:top-auto lg:translate-x-0 h-[100dvh] overflow-y-scroll lg:overflow-y-auto no-scrollbar w-64 lg:w-20 lg:sidebar-expanded:!w-64 2xl:!w-64 shrink-0 px-4 pt-4 pb-2 transition-all duration-200 ease-in-out -translate-x-64">

        <!-- Sidebar header -->
        <div class="flex justify-between mb-10 pr-3 sm:px-2">
            <!-- Logo -->
            <a class="flex flex-row items-start gap-1 font-extrabold text-2xl hover:text-white duration-150" href="/">
                <span class="-tracking-[2px] ml-0 text-zinc-200">todoer</span>
                <span class="tracking-tighter text-indigo-600 text-sm">pro</span>
            </a>
        </div>

        <!-- Links -->
        <div class="space-y-8">
            <div>
                <ul class="mt-3 text-sm font-semibold">
                    <Nav.Links.Item href="/dashboard">Dashboard</Nav.Links.Item>
                    <Nav.Links.Item href="/">Spaces</Nav.Links.Item>
                </ul>
            </div>
            {%- if spaces %}<Nav.Spaces spaces={spaces} />{% endif %}
            {%- if space %}<Nav.Lists space={space} lists={lists} />{% endif %}
        </div>
        <div class="flex-grow"></div>
        <Nav.UserBtn user={user} />
        <!--<div class="text-xs font-light text-slate-300 dark:text-slate-700 text-center">&copy; 2024 - <em>{{ RELEASE }}</em></div>-->
    </div>
</div>
