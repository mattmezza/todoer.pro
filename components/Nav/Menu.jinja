{# def spaces, user, space, lists #}
<div class="min-w-fit">
    <!-- Sidebar -->
    <div
        class="flex flex-col absolute z-40 left-0 top-0 lg:static lg:left-auto lg:top-auto lg:translate-x-0 h-[100dvh] overflow-y-scroll lg:overflow-y-auto no-scrollbar w-64 lg:w-20 lg:sidebar-expanded:!w-64 2xl:!w-64 shrink-0 px-4 pt-4 pb-2 transition-all duration-200 ease-in-out -translate-x-64">

        <!-- Sidebar header -->
        <div class="flex justify-between mb-10 pr-3 sm:px-2">
            <Nav.Logo tag="a" href="/dashboard" />
        </div>

        <!-- Links -->
        <div class="space-y-8">
            <div>
                <ul class="mt-3 text-sm font-semibold">
                    <Nav.Links.Item href="/dashboard">Home</Nav.Links.Item>
                    <Nav.Links.Item href="/inbox">Inbox</Nav.Links.Item>
                </ul>
                <div class="mt-2 px-3" x-data="{ notifOpen: false }">
                    <button
                        class="relative flex items-center gap-2 w-full py-2 text-sm font-semibold text-slate-700 hover:text-black dark:text-slate-400 dark:hover:text-white transition duration-150 cursor-pointer active:scale-95"
                        @click.prevent="notifOpen = !notifOpen"
                        hx-get="/notifications"
                        hx-target="#sidebar-notifications-content"
                        hx-trigger="click once">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" />
                        </svg>
                        <span>Notifications</span>
                        <span id="sidebar-notifications-badge"
                            hx-get="/notifications/badge"
                            hx-trigger="load, task-create from:body, task-update from:body"
                            hx-swap="innerHTML"
                            class="ml-auto">
                        </span>
                    </button>
                    <div x-show="notifOpen" x-transition class="mt-1 mb-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded shadow-lg overflow-y-auto max-h-80" style="display: none;">
                        <div id="sidebar-notifications-content">
                            <div class="py-4 px-4 text-center text-xs text-slate-500">Loading...</div>
                        </div>
                    </div>
                </div>
            </div>
            <div
                hx-get="/nav/bookmarks"
                hx-trigger="load"
                hx-swap="innerHTML"
            ></div>
            {%- if cur_path_starts_with("/dashboard") -%}
                {%- if spaces and spaces|rejectattr("default")|list|length %}<Nav.Spaces spaces={{spaces}} />{% endif %}
            {%- else -%}
                {%- if space and lists is defined %}<Nav.Lists space={{space}} lists={{lists}} />{% endif -%}
            {%- endif -%}
        </div>
        <div class="flex-grow"></div>
        <Nav.UserBtn user={{user}} spaces={{spaces}} space={{space}} />
        <!--<div class="text-xs font-light text-slate-300 dark:text-slate-700 text-center">&copy; 2024 - <em>{{ RELEASE }}</em></div>-->
    </div>
</div>
