{# def spaces, user, nav_lists_content="" #}
<div class="min-w-fit">
    <!-- Sidebar -->
    <div id="sidebar"
        class="flex flex-col absolute z-40 left-0 top-0 lg:static lg:left-auto lg:top-auto lg:translate-x-0 h-[100dvh] overflow-y-scroll lg:overflow-y-auto no-scrollbar w-64 lg:w-20 lg:sidebar-expanded:!w-64 2xl:!w-64 shrink-0 px-4 pt-4 pb-2 transition-all duration-200 ease-in-out -translate-x-64">

        <!-- Sidebar header -->
        <div class="flex justify-between mb-10 pr-3 sm:px-2">
            <!-- Logo -->
            <a class="flex flex-row items-start gap-1 font-extrabold text-2xl hover:text-white duration-150" href="/">
                <!--
                <svg width="32" height="32" viewBox="0 0 32 32">
                    <defs>
                        <linearGradient x1="28.538%" y1="20.229%" x2="100%" y2="108.156%" id="logo-a">
                            <stop stop-color="#A5B4FC" stop-opacity="0" offset="0%"></stop>
                            <stop stop-color="#A5B4FC" offset="100%"></stop>
                        </linearGradient>
                        <linearGradient x1="88.638%" y1="29.267%" x2="22.42%" y2="100%" id="logo-b">
                            <stop stop-color="#38BDF8" stop-opacity="0" offset="0%"></stop>
                            <stop stop-color="#38BDF8" offset="100%"></stop>
                        </linearGradient>
                    </defs>
                    <rect fill="#6366F1" width="32" height="32" rx="16"></rect>
                    <path
                        d="M18.277.16C26.035 1.267 32 7.938 32 16c0 8.837-7.163 16-16 16a15.937 15.937 0 01-10.426-3.863L18.277.161z"
                        fill="#4F46E5"></path>
                    <path
                        d="M7.404 2.503l18.339 26.19A15.93 15.93 0 0116 32C7.163 32 0 24.837 0 16 0 10.327 2.952 5.344 7.404 2.503z"
                        fill="url(#logo-a)"></path>
                    <path
                        d="M2.223 24.14L29.777 7.86A15.926 15.926 0 0132 16c0 8.837-7.163 16-16 16-5.864 0-10.991-3.154-13.777-7.86z"
                        fill="url(#logo-b)"></path>
                </svg>
                -->
                <span class="-tracking-[2px] ml-0 text-zinc-200">todoer</span>
                <span class="tracking-tighter text-indigo-600 text-sm">pro</span>
            </a>
            <button class="cursor-pointer p-2 bg-slate-700 hover:bg-slate-600 rounded lg:hidden"
                _="on click remove .translate-x-0 from #sidebar then add .-translate-x-64 to #sidebar">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                    stroke="currentColor" class="w-4 h-4">
                    <path stroke-linecap="round" stroke-linejoin="round"
                        d="M18.75 19.5l-7.5-7.5 7.5-7.5m-6 15L5.25 12l7.5-7.5" />
                </svg>
            </button>
        </div>

        <!-- Links -->
        <div class="space-y-8">
            <div>
                <ul class="mt-3 text-sm font-semibold">
                    <!-- Dashboard -->
                    <li class="px-3 py-2 rounded-sm mb-0.5 last:mb-0">
                        <a
                            class="block text-slate-200 hover:text-slate-200 truncate transition duration-150 hover:font-bold cursor-pointer active:scale-95"
                            href="/">
                            Home
                        </a>
                    </li>
                    <!-- Spaces -->
                    <li class="px-3 py-2 rounded-sm mb-0.5 last:mb-0">
                        <a
                            class="block text-slate-200 hover:text-slate-200 truncate transition duration-150 hover:font-bold cursor-pointer active:scale-95"
                            href="/spaces">
                            Spaces
                        </a>
                    </li>
                </ul>
            </div>
            {% if spaces %}
            <!-- Spaces group -->
            <div>
                <h3 class="text-xs uppercase text-slate-500 font-semibold pl-3">
                    <span class="hidden lg:block lg:sidebar-expanded:hidden 2xl:hidden text-center w-6"
                        aria-hidden="true">•••</span>
                    <span class="lg:hidden lg:sidebar-expanded:block 2xl:block">Spaces</span>
                </h3>
                <ul
                    hx-get="/nav/spaces"
                    hx-trigger="space-delete from:body, space-create from:body, space-update from:body"
                    class="mt-3 text-sm font-semibold">
                    {#% from "nav/space.htm" import nav_space %#}
                    {#% for space in spaces %#}
                        {# { nav_space(space) }#}
                    {#% endfor %#}
                </ul>
                <button
                    class="btn block text-slate-500 transition cursor-pointer hover:text-indigo-600 active:scale-95 group gap-2"
                    _="on click showModal() on the next <dialog />"
                >
                    <div class="flex items-center justify-between">
                        <div class="flex items-center">
                            <div class="dark:text-slate-700 dark:group-hover:bg-indigo-500 dark:group-hover:text-white rounded-full">
                                <svg
                                    class="w-6 h-6 group-hover:text-slate-200 group-hover:rounded-full group-hover:bg-indigo-600"
                                    xmlns="http://www.w3.org/2000/svg"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke-width="1.5"
                                    stroke="currentColor"
                                >
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                                </svg>
                            </div>
                            <span
                                class="hidden group-hover:block text-sm font-medium ml-2">
                                Add space
                            </span>
                        </div>
                    </div>
                </button>
                <Dialog.Create
                    title={"Add a new space"}
                    subtitle={"Spaces help you to separate environments. Work from personal life. Project A from project B, etc... You got the gist!"}
                    action={"/spaces"}
                >
                    <div class="flex flex-col gap-3 mt-4">
                        <div class="space-y-1">
                            <div class="text-xs flex flex-row items-center">
                                <span>Space name</span>
                            </div>
                            <input
                                tabindex="0"
                                autofocus
                                required
                                class="form-input w-full"
                                name="title"
                                placeholder="Type here..." />
                            <div class="text-xs flex flex-row items-center justify-end">
                            </div>
                        </div>
                        <div class="space-y-1">
                            <div class="text-xs flex flex-row items-center">
                                <span>Description</span>
                            </div>
                            <textarea class="form-input w-full resize-none" name="descr"
                                placeholder="Type here..."></textarea>
                            <div class="text-xs flex flex-row items-center justify-end">
                            </div>
                        </div>
                    </div>
                </Dialog.Create>
            </div>
            {% endif %}
            <!-- More group -->
            {% block nav_lists %}
                {% if nav_lists_content %}{{ nav_lists_content() }}{% endif %}
            {% endblock %}
        </div>
        <div class="flex-grow"></div>
        <!-- User button -->
        <div class="relative" x-data="{ open: false }">
            <button class="flex gap-2 justify-start items-center group w-full p-2 dark:hover:bg-gray-900 transitions-all active:scale-95 rounded" aria-haspopup="true" @click.prevent="open = !open" :aria-expanded="open" aria-expanded="false">
                <img class="w-8 h-8 rounded-full" src="https://www.gravatar.com/avatar/{{ user.email_hash }}.jpg?s=100" width="32" height="32" alt="User">
                <div class="">
                    <div class="text-sm font-semibold text-slate-800 dark:text-slate-100">{{ user.name|default('') }}</div>
                    <div class="ml-2 text-xs text-slate-500 dark:text-slate-400">Todoer since {{ user.created[0:4] }}</div>
                <div>
            </button>
            <div class="z-10 absolute bottom-[102%] left-0 min-w-44 bg-white dark:bg-gray-900 py-1.5 rounded shadow-lg overflow-hidden mt-1" @click.outside="open = false" @keydown.escape.window="open = false" x-show="open" x-transition:enter="transition ease-out duration-200 transform" x-transition:enter-start="opacity-0 -translate-y-2" x-transition:enter-end="opacity-100 translate-y-0" x-transition:leave="transition ease-out duration-200" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0" style="display: none;">
                <ul>
                    <li>
                        <button class="font-medium text-sm dark:text-zinc-200 hover:font-semibold flex items-center py-1 px-3" hx-get="/users/me" hx-target="#main" hx-push-url="true" @click="open = false" @focus="open = true" @focusout="open = false">Profile</button>
                    </li>
                    <li>
                        <a class="font-medium text-sm text-red-500 hover:font-semibold flex items-center py-1 px-3" href="/auth/logout" @click="open = false" @focus="open = true" @focusout="open = false">Sign Out</a>
                    </li>
                </ul>
            </div>
        </div>
        <!--<div class="text-xs font-light text-slate-300 dark:text-slate-700 text-center">&copy; 2024 - <em>{{ RELEASE }}</em></div>-->
        <!-- Expand / collapse button
        <div class="pt-3 hidden lg:inline-flex 2xl:hidden justify-end mt-auto">
            <div class="px-3 py-2">
                <button @click="sidebarExpanded = !sidebarExpanded">
                    <span class="sr-only">Expand / collapse sidebar</span>
                    <svg class="w-6 h-6 fill-current sidebar-expanded:rotate-180" viewBox="0 0 24 24">
                        <path class="text-slate-400" d="M19.586 11l-5-5L16 4.586 23.414 12 16 19.414 14.586 18l5-5H7v-2z"></path>
                        <path class="text-slate-600" d="M3 23H1V1h2z"></path>
                    </svg>
                </button>
            </div>
        </div>
        -->
    </div>
</div>

