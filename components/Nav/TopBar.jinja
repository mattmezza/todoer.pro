{# def user #}
<header class="sticky top-0 border-b border-slate-200 dark:border-slate-700/50 z-30 bg-white/80 dark:bg-black/80 backdrop-blur-sm">
    <div class="px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-end h-10">
            <!-- Notifications bell -->
            <div class="relative" x-data="{ open: false }">
                <button
                    class="relative p-1.5 rounded-full hover:bg-slate-100 dark:hover:bg-slate-800 transition cursor-pointer"
                    @click.prevent="open = !open"
                    hx-get="/notifications"
                    hx-target="#topbar-notifications-content"
                    hx-trigger="click"
                    aria-haspopup="true"
                    :aria-expanded="open"
                >
                    <span id="topbar-notifications-bell"
                        hx-get="/notifications/badge"
                        hx-trigger="load, task-create from:body, task-update from:body, notification-update from:body"
                        hx-swap="innerHTML">
                    </span>
                </button>
                <!-- Dropdown panel -->
                <div class="origin-top-right absolute top-full right-0 mt-1 w-96 max-h-[70vh] bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg shadow-xl overflow-hidden"
                    @click.outside="open = false"
                    @keydown.escape.window="open = false"
                    x-show="open"
                    x-transition:enter="transition ease-out duration-150"
                    x-transition:enter-start="opacity-0 -translate-y-1"
                    x-transition:enter-end="opacity-100 translate-y-0"
                    x-transition:leave="transition ease-in duration-100"
                    x-transition:leave-start="opacity-100"
                    x-transition:leave-end="opacity-0"
                    x-cloak>
                    <div class="flex items-center justify-between px-4 py-2 border-b border-slate-200 dark:border-slate-700">
                        <h3 class="text-sm font-semibold text-slate-700 dark:text-slate-200">Notifications</h3>
                        <div class="flex items-center gap-2">
                            <button
                                class="text-xs text-indigo-500 hover:text-indigo-400 cursor-pointer"
                                hx-post="/notifications/read-all"
                                hx-target="#topbar-notifications-content"
                                hx-swap="innerHTML">
                                Mark all read
                            </button>
                        </div>
                    </div>
                    <div id="topbar-notifications-content" class="overflow-y-auto max-h-[60vh]">
                        <div class="py-6 px-4 text-center text-sm text-slate-500">Loading...</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>
