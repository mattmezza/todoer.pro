{# def list #}
<li class="sidebar-nav-item px-3 py-2 rounded-sm mb-0.5 last:mb-0">
    <a
        class="block text-slate-800 dark:text-slate-200 hover:text-black hover:dark:text-white hover:font-black transition duration-150 cursor-pointer font-mono active:scale-95{{ ' font-black text-black dark:text-white' if cur_path_starts_with('/list/' + list.sid) else ' font-medium' }}"
        href="/list/{{ list.sid }}">
        <div class="flex items-center justify-between">
            <div class="flex items-center">
                <span class="rounded-full shrink-0 w-6 h-6" style="background-color: {{ list.color }}">&nbsp;</span>
                <span class="text-sm ml-3 lg:opacity-0 lg:sidebar-expanded:opacity-100 2xl:opacity-100 duration-200 text-ellipsis overflow-hidden">#{{ list.title[0:20] }}</span>
            </div>
            <div class="flex flex-shrink-0 ml-2">
                {%- if False %}
                <span class="inline-flex items-center justify-center h-5 text-xs font-medium text-white bg-indigo-500 px-2 rounded">
                    {{ 2 }}
                </span>
                {% endif %}
            </div>
        </div>
    </a>
</li>
