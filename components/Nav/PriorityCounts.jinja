{# def counts #}
{% if counts %}
<div class="nav-priority-counts"
     hx-get="/nav/priority-counts"
     hx-trigger="task-update from:body, task-create from:body, task-delete from:body"
     hx-target="this"
     hx-swap="innerHTML">
    <h3 class="text-xs text-slate-500 font-semibold pl-3">
        <span class="hidden lg:block lg:sidebar-expanded:hidden 2xl:hidden text-center w-6" aria-hidden="true">!!!</span>
        <span class="lg:hidden lg:sidebar-expanded:block 2xl:block uppercase">Priority</span>
    </h3>
    <ul class="mt-3 text-sm font-semibold">
        {% for p in [1, 2, 3, 4] %}
        {% set label = "P" ~ p %}
        {% set count = counts.get(p, 0) %}
        {% set color = {
            1: 'bg-red-500/20 text-red-400',
            2: 'bg-orange-500/20 text-orange-400',
            3: 'bg-yellow-500/20 text-yellow-400',
            4: 'bg-blue-500/20 text-blue-400',
        }[p] %}
        <li class="sidebar-nav-item px-3 py-2 rounded-sm mb-0.5 last:mb-0">
            <a
                class="block text-slate-700 hover:text-black dark:text-slate-400 dark:hover:text-white truncate transition duration-150 hover:font-bold cursor-pointer active:scale-95{% if cur_path_starts_with('/priority/' ~ p) %} !text-slate-100 !font-black{% endif %}"
                href="/priority/{{ p }}">
                <div class="flex items-center gap-2">
                    <span class="shrink-0 w-2 h-2 rounded-full {{ color }}"></span>
                    <span class="grow">{{ label }}</span>
                    <span class="text-xs {{ color }} px-1.5 py-0.5 rounded">{{ count }}</span>
                </div>
            </a>
        </li>
        {% endfor %}
    </ul>
</div>
{% endif %}
