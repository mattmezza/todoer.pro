{# def space, lists #}
<div
    id="nav-lists"
    hx-get="/nav/lists?space={{ space.uuid }}"
    hx-trigger="list-delete from:body, list-create from:body, list-update from:body, task-update from:body, task-delete from:body, task-create from:body"
>
    <h3 class="text-xs text-slate-500 font-semibold pl-3">
        <span class="hidden lg:block lg:sidebar-expanded:hidden 2xl:hidden text-center w-6"
            aria-hidden="true">•••</span>
        <span class="lg:hidden lg:sidebar-expanded:block 2xl:block uppercase">Lists</span>
    </h3>
    <ul class="mt-3 text-sm font-semibold">
        {% for l in lists|rejectattr("default") %}
            <Nav.Lists.Item list={{l}} />
        {% endfor %}
    </ul>
    <button
        class="btn block text-slate-500 transition cursor-pointer hover:text-indigo-600 active:scale-95 group gap-2"
        _="on click showModal() on the next <dialog />"
    >
        <div class="flex items-center justify-between">
            <div class="flex items-center">
                <div class="dark:text-slate-700 dark:group-hover:bg-indigo-500 dark:group-hover:text-white rounded-full">
                    <svg
                        class="w-6 h-6 group-hover:text-slate-200 group-hover:rounded-full group-hover:bg-indigo-600"
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                    >
                        <path stroke-linecap="round" stroke-linejoin="round" d="m12 4.5v15m7.5-7.5h-15" />
                    </svg>
                </div>
                <span
                    class="hidden group-hover:block text-sm font-medium ml-2">
                    Add list
                </span>
            </div>
        </div>
    </button>
    <Dialog.Create
        title={{"Add a new list"}}
        subtitle={{"Lists are like containers of common things."}}
        action={{"/lists"}}
        hx-target="#nav-lists"
        hx-swap="beforeend"
        hidden_vals={{{"space": space["uuid"]}}}
    >
        <div class="flex flex-col gap-3 mt-4">
            <div class="space-y-1">
                <div class="text-sm flex flex-row items-center">
                    <span>Color</span>
                </div>
                <input tabindex="1" type="color"
                    class="bg-transparent border-0 rounded outline-none" name="color"
                    value="#ff0000" />
                <div class="text-sm flex flex-row items-center justify-end">
                </div>
            </div>
            <div class="space-y-1">
                <div class="text-sm flex flex-row items-center">
                    <span>List name</span>
                </div>
                <input
                    tabindex="0"
                    class="form-input w-full" name="title"
                    placeholder="#trip-to-paris"
                    autofocus
                    required>
                <div class="text-sm flex flex-row items-center justify-end">
                </div>
            </div>
            <div class="space-y-1">
                <div class="text-sm flex flex-row items-center">
                    <span>Description</span>
                </div>
                <textarea
                    class="form-input w-full resize-none"
                    name="descr"
                    placeholder="A checklist of things to pack for the trip."
                    @keydown.meta.enter="$event.target.form && $event.target.form.dispatchEvent(new Event('submit'))"
                    @keydown.ctrl.enter="$event.target.form && $event.target.form.dispatchEvent(new Event('submit'))"
                ></textarea>
                <div class="text-sm flex flex-row items-center justify-end">
                </div>
            </div>
        </div>
    </Dialog.Create>
</div>

