{# def overdue, due_today, upcoming #}
<div class="text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase pt-1.5 pb-2 px-4">Notifications</div>
{% if not overdue and not due_today and not upcoming %}
    <div class="py-6 px-4 text-center text-sm text-slate-500 dark:text-slate-400">
        No upcoming deadlines. You're all caught up!
    </div>
{% else %}
    {% if overdue %}
    <div class="px-4 pt-2 pb-1">
        <span class="text-xs font-semibold text-red-400 uppercase">Overdue</span>
    </div>
    <ul>
        {% for task in overdue %}
            <Notifications.Item task={task} kind="overdue" />
        {% endfor %}
    </ul>
    {% endif %}
    {% if due_today %}
    <div class="px-4 pt-2 pb-1">
        <span class="text-xs font-semibold text-amber-400 uppercase">Due Today</span>
    </div>
    <ul>
        {% for task in due_today %}
            <Notifications.Item task={task} kind="today" />
        {% endfor %}
    </ul>
    {% endif %}
    {% if upcoming %}
    <div class="px-4 pt-2 pb-1">
        <span class="text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase">Upcoming</span>
    </div>
    <ul>
        {% for task in upcoming %}
            <Notifications.Item task={task} kind="upcoming" />
        {% endfor %}
    </ul>
    {% endif %}
{% endif %}
