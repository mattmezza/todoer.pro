{# def overdue, due_today, upcoming #}
{% if not overdue and not due_today and not upcoming %}
    <div class="py-8 px-4 flex flex-col items-center justify-center gap-2 text-slate-400 dark:text-slate-400">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" class="w-8 h-8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" />
        </svg>
        <span class="text-sm">You're all caught up!</span>
    </div>
{% else %}
    {% if overdue %}
    <div class="px-4 pt-2 pb-1">
        <span class="text-xs font-semibold text-red-400 uppercase">Overdue</span>
    </div>
    <ul>
        {% for task in overdue %}
            <Notifications.Item task={{task}} kind="overdue" />
        {% endfor %}
    </ul>
    {% endif %}
    {% if due_today %}
    <div class="px-4 pt-2 pb-1">
        <span class="text-xs font-semibold text-amber-400 uppercase">Due Today</span>
    </div>
    <ul>
        {% for task in due_today %}
            <Notifications.Item task={{task}} kind="today" />
        {% endfor %}
    </ul>
    {% endif %}
    {% if upcoming %}
    <div class="px-4 pt-2 pb-1">
        <span class="text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase">Upcoming</span>
    </div>
    <ul>
        {% for task in upcoming %}
            <Notifications.Item task={{task}} kind="upcoming" />
        {% endfor %}
    </ul>
    {% endif %}
{% endif %}
