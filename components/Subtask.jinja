{# def subtask #}
<li id="subtask-{{ subtask.sid }}" class="shadow-lg rounded-sm border-slate-200 dark:border-slate-800 pr-1 py-2 group{% if subtask.complete %} opacity-40{% endif %}">
    <!-- Display view -->
    <div class="subtask-display">
        <form class="sm:flex sm:justify-between sm:items-start">
            <!-- Left side -->
            <div class="grow mt-0.5 mb-0.5 sm:mb-0">
                <div class="flex items-center">
                    <!-- Drag button -->
                    <button class="cursor-ns-resize mr-2 hidden {% if not subtask.complete %}group-hover:visible{% endif %}">
                        <span class="sr-only">Drag</span>
                        <svg class="w-3 h-3 fill-slate-300 dark:fill-slate-600" viewBox="0 0 12 12" xmlns="http://www.w3.org/2000/svg">
                            <path d="M0 1h12v2H0V1Zm0 4h12v2H0V5Zm0 4h12v2H0V9Z" fill-rule="evenodd"></path>
                        </svg>
                    </button>
                    <!-- Checkbox button -->
                    <div class="flex items-center">
                        <input hx-put="/subtask/{{ subtask.sid }}" hx-target="closest li" hx-swap="outerHTML" hx-trigger="click consume" name="complete" hx-push-url="false" type="checkbox" {% if subtask.complete %}checked{% endif %} class="form-checkbox w-5 h-5 rounded-full peer cursor-pointer">
                        <input name="title" type="hidden" value="{{ subtask.title }}" />
                        {% if subtask.descr %}<input name="descr" type="hidden" value="{{ subtask.descr }}" />{% endif %}
                        <span class="font-semibold text-slate-800 dark:text-slate-100 peer-checked:line-through ml-3 xs:text-xs sm:text-sm md:text-base lg:text-lg">{{ subtask.title }}</span>
                    </div>
                </div>
                {% if subtask.descr %}
                <div class="ml-8">
                    <div class="rounded text-sm w-full prose dark:prose-white prose-xs md:prose-base lg:prose-lg xs:prose-xs sm:prose-sm">
                        {{ subtask.descr|markdown|safe }}
                    </div>
                </div>
                {% endif %}
            </div>
            <!-- Right side -->
            <div class="items-center justify-end space-x-2 hidden group-hover:flex mr-4">
                <!-- Edit button -->
                <button
                    type="button"
                    class="text-slate-400 dark:text-slate-500 hover:text-indigo-500 dark:hover:text-indigo-500"
                    _="on click hide closest .subtask-display then show next .subtask-edit from closest <li/> then next .subtask-edit.querySelector('input[name=title]').select() from closest <li/>">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
                    </svg>
                </button>
                <!-- Delete button -->
                <button type="button" class="text-slate-400 dark:text-slate-500 hover:text-indigo-500 dark:hover:text-indigo-500" hx-delete="/subtask/{{ subtask.sid }}" hx-target="closest li" hx-swap="outerHTML" hx-trigger="click consume" hx-push-url="false" hx-confirm="Are you sure you want to delete this subtask?">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-red-400">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                    </svg>
                </button>
            </div>
        </form>
    </div>
    <!-- Edit form (hidden by default) -->
    <form
        class="subtask-edit rounded-sm border border-slate-600 mx-1"
        style="display: none"
        hx-put="/subtask/{{ subtask.sid }}"
        hx-target="closest li"
        hx-swap="outerHTML"
        _="on reset or keyup[key is 'Escape'] hide me then show previous .subtask-display">
        <div class="py-2">
            <input
                class="form-input block py-1 px-3 border-0 w-full font-semibold placeholder:font-semibold xs:text-xs sm:text-sm md:text-base lg:text-lg"
                name="title"
                placeholder="Subtask name"
                value="{{ subtask.title }}"
                required
                @keydown.meta.enter="$event.target.form && $event.target.form.dispatchEvent(new Event('submit'))"
                @keydown.ctrl.enter="$event.target.form && $event.target.form.dispatchEvent(new Event('submit'))"
                _="on keyup[key is 'Escape'] reset() the closest <form />"
                autofocus>
            <textarea
                name="descr"
                placeholder="Description"
                x-data="{
                    resize () {
                        $el.style.height = '0px';
                        $el.style.height = $el.scrollHeight + 'px'
                    }
                }"
                x-init="$nextTick(() => resize())"
                @input="resize()"
                @focus="resize()"
                @keydown.meta.enter="$event.target.form && $event.target.form.dispatchEvent(new Event('submit'))"
                @keydown.ctrl.enter="$event.target.form && $event.target.form.dispatchEvent(new Event('submit'))"
                _="on keyup[key is 'Escape'] reset() the closest <form />"
                class="form-input h-auto min-h-[40px] block py-1 px-3 border-0 w-full resize-none md:text-base"
                >{{ subtask.descr or '' }}</textarea>
        </div>
        {% if subtask.complete %}<input type="hidden" name="complete" value="on" />{% endif %}
        <div class="flex flex-row justify-between items-center border-t border-slate-600 px-3 py-2">
            <div></div>
            <div class="space-x-2">
                <button type="reset" class="btn py-1">Cancel</button>
                <button type="submit" class="btn py-1 bg-indigo-600 text-white">Save</button>
            </div>
        </div>
    </form>
</li>
