{# def subtask #}
<li class="shadow-lg rounded-sm border-b border-slate-200 dark:border-slate-800 pr-1 py-2 group cursor-pointer{% if subtask.complete %} opacity-40{% endif %}" draggable="{% if subtask.complete %}false{% else %}true{% endif %}">
    <form class="sm:flex sm:justify-between sm:items-start">
        <!-- Left side -->
        <div class="grow mt-0.5 mb-0.5 sm:mb-0">
            <div class="flex items-center">
                <!-- Drag button -->
                <button class="cursor-ns-resize mr-2 invisible {% if not subtask.complete %}group-hover:visible{% endif %}">
                    <span class="sr-only">Drag</span>
                    <svg class="w-3 h-3 fill-slate-300 dark:fill-slate-600" viexbox="0 0 12 12" xmlns="http://www.w3.org/2000/svg">
                        <path d="M0 1h12v2H0V1Zm0 4h12v2H0V5Zm0 4h12v2H0V9Z" fill-rule="evenodd"></path>
                    </svg>
                </button>
                <!-- Checkbox button -->
                <div class="flex items-center">
                    <input hx-put="/subtasks/{{ subtask.sid }}" hx-target="closest li" hx-swap="outerHTML" hx-trigger="click consume" name="complete" hx-push-url="false" type="checkbox" {% if subtask.complete %}checked{% endif %} class="form-checkbox w-5 h-5 rounded-full peer cursor-pointer">
                    <input name="title" type="hidden" value="{{ subtask.title }}" />
                    {% if subtask.descr %}<input name="descr" type="hidden" value="{{ subtask.descr }}" />{% endif %}
                    <span class="font-semibold text-slate-800 dark:text-slate-100 peer-checked:line-through ml-2 text-sm">{{ subtask.title }}</span>
                </div>
            </div>
            {% if subtask.descr %}
            <div class="ml-12">
                <p class="font-medium text-slate-500 dark:text-slate-400 peer-checked:line-through text-xs">
                    {{ subtask.descr }}
                </p>
            </div>
            {% endif %}
        </div>
        <!-- Right side -->
        <div class="items-center justify-end space-x-2 hidden group-hover:flex mr-4">
            <!-- Delete button -->
            <button type="button" class="text-slate-400 dark:text-slate-500 hover:text-indigo-500 dark:hover:text-indigo-500" hx-delete="/subtasks/{{ subtask.sid }}" hx-target="closest li" hx-swap="outerHTML" hx-trigger="click consume" hx-push-url="false" hx-confirm="Are you sure you want to delete this subtask?">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-red-400">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                </svg>
            </button>
        </div>
    </form>
</li>

