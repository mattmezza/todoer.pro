{# def spaces, user, space=False, lists=[], title=False #}
<!doctype html>
<html>
<head>
    <title>{% if ENV != "prod" %}[{{ ENV }}] {% endif %}Todoer{%- if title %} - {{ title }}{% endif %}</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% if ENV == "local" %}
    <link href="/public/style.css?v={{ epoch() }}" rel="stylesheet">
    {% else %}
    <link href="/public/style.css?v={{ RELEASE or '' }}" rel="stylesheet">
    {% endif %}
    <!-- emoji to png|ico via https://emojifavicon.dev -->
    <link rel="icon" href="/public/favicon.ico?v={{ RELEASE or '' }}">
    <link rel="icon" href="/public/favicon.png?v={{ RELEASE or '' }}">
</head>
<body hx-ext="loading-states" class="font-inter antialiased bg-slate-100 dark:bg-gray-950 text-slate-600 dark:text-slate-300 sidebar-expanded">
    <div class="flex h-[100dvh] overflow-hidden">
            <Nav.Menu spaces={spaces} user={user} space={space} lists={lists} />
        <div class="relative flex flex-col flex-1 overflow-y-auto overflow-x-hidden dark:bg-black lg:rounded-l-lg">
            {# <Nav.TopBar user={user} /> #}
            <div class="flex flex-row">
                <div id="main" class="grow">
                    {{ content }}
                </div>
            </div>
        </div>
        <Nav.Mobile space={space} />
    </div>
    <Dialog.Empty open id="modal-about" class="fixed top-[40%]">
        <div class="p-8 text-center relative">
            <button
                class="text-slate-800 dark:text-gray-300 flex items-center justify-center h-6 w-6 active:scale-95 transitions-all absolute right-2 top-2 rounded-full dark:hover:bg-white/30 hover:bg-black/30 cursor-pointer lowercase font-semibold font-mono"
                onclick="document.getElementById('modal-about').close()">
                X
            </button>
            <div class="flex justify-center items-center">
                <Nav.Logo />
            </div>
            <h4 class="text-sm">A slogan here...</h4>

            <footer class="text-xs mt-16">
                All rights reserved &copy; Matteo Merola
            </footer>
        </div>
    </Dialog.Empty>
    <script src="//unpkg.com/alpinejs" defer></script>
    <script src="//unpkg.com/htmx.org@1.9.5/dist/htmx.min.js" defer></script>
    <script src="//unpkg.com/hyperscript.org@0.9.11" defer></script>
    <script src="//unpkg.com/htmx.org/dist/ext/loading-states.js" defer></script>
    {% if ENV == "local" %}
        <script src="//unpkg.com/htmx.org/dist/ext/debug.js" defer></script>
        {{ hot_reload.script("ws://localhost:8000/hot-reload") | safe }}
    {% endif %}
    {% block scripts %}
    {% endblock %}
    {{ catalog.render_assets() }}
</body>
</html>


