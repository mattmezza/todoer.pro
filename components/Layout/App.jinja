{# def
    spaces,
    user,
    space=False,
    lists=[],
    title=False,
    content_class="dark:bg-black",
    body_class="bg-slate-100 dark:bg-gray-950 text-slate-600 dark:text-slate-300"
#}
<!doctype html>
<html>
<head>
    <title>{% if ENV != "prod" %}[{{ ENV[:3] }}] {% endif %}{% if title %}{{ title|truncate(75) }} &middot; {% endif %}todoer</title>
    <meta charset="UTF-8">
    <meta name="theme-color" content="#000000">
    <link rel="manifest" href="/manifest.json?v={{ RELEASE or '' }}">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    {% if ENV == "local" %}
    <link href="/public/style.css?v={{ epoch() }}" rel="stylesheet">
    {% else %}
    <link href="/public/style.css?v={{ RELEASE or '' }}" rel="stylesheet">
    {% endif %}
    <!-- emoji to png|ico via https://emojifavicon.dev -->
    <link rel="icon" href="/public/favicon.ico?v={{ RELEASE or '' }}">
    <link rel="icon" href="/public/favicon.png?v={{ RELEASE or '' }}">
</head>
<body class="font-inter antialiased sidebar-expanded {{ body_class }}">
    <div class="flex h-[100dvh] overflow-hidden">
        <Nav.Menu spaces={{spaces}} user={{user}} space={{space}} lists={{lists}} />
            <div class="relative flex flex-col flex-1 overflow-y-auto overflow-x-hidden lg:rounded-l-xl pb-16 lg:pb-0 {{ content_class }}">
            <Nav.TopBar user={{user}} />
            <div class="flex flex-row">
                <div id="main" class="grow">
                    {{ content }}
                </div>
            </div>
        </div>
            <Nav.Mobile space={{space}} spaces={{spaces}} lists={{lists}} />
    </div>
    <dialog id="search-dialog" class="bg-transparent backdrop:bg-black/50 w-full max-w-4xl mx-auto mt-[15vh]"
        _="on keydown[key is 'Escape'] call me.close()">
        <div class="bg-zinc-950 rounded-lg border border-slate-700 shadow-2xl overflow-hidden">
            <div class="flex items-center gap-2 px-4 border-b border-slate-700">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-slate-400 shrink-0">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                </svg>
                <input
                    id="search-input"
                    type="search"
                    name="q"
                    placeholder="Search tasks, lists, spaces..."
                    class="w-full bg-transparent border-0 text-slate-200 placeholder:text-slate-500 py-3 focus:ring-0"
                    hx-get="/search"
                    hx-trigger="keyup changed delay:300ms"
                    hx-target="#search-results"
                    autocomplete="off">
            </div>
            <div id="search-results" class="max-h-[60vh] overflow-y-auto">
                <div class="py-8 text-center text-sm text-slate-500">Type to search...</div>
            </div>
            <div class="px-4 py-2 border-t border-slate-700 text-xs text-slate-500 flex justify-between">
                <span><kbd class="px-1 bg-slate-700 rounded font-mono">↑↓</kbd> or <kbd class="px-1 bg-slate-700 rounded font-mono">C-j/k</kbd> navigate · <kbd class="px-1 bg-slate-700 rounded font-mono">@#$%</kbd> scope</span>
                <span><kbd class="px-1.5 py-0.5 rounded bg-slate-700 text-slate-400 font-mono text-xs">Esc</kbd> to close</span>
            </div>
        </div>
    </dialog>
    <dialog id="quick-add-dialog" class="bg-transparent backdrop:bg-black/50 w-full max-w-4xl mx-auto mt-[15vh]"
        _="on keydown[key is 'Escape'] call me.close()">
        <div id="quick-add-content">
        </div>
    </dialog>
    <DatePicker />
    <TagsPicker />
    <Dialog.About />
    <KeyboardShortcuts />
    <script src="//unpkg.com/alpinejs"></script>
    <script>
        Alpine.data('filterBar', (opts) => ({
            sid: opts.sid,
            sortBy: opts.sortBy || 'manual',
            filterPriority: opts.filterPriority,
            filterDue: opts.filterDue || null,
            filterTags: opts.filterTags || [],
            tagDropdownOpen: false,
            dueDropdownOpen: false,
            sortDropdownOpen: false,
            selectedTag(tag) {
                return this.filterTags.includes(tag);
            },
            toggleTag(tag) {
                const idx = this.filterTags.indexOf(tag);
                if (idx === -1) {
                    this.filterTags.push(tag);
                } else {
                    this.filterTags.splice(idx, 1);
                }
            },
            applyFilters() {
                const params = new URLSearchParams();
                if (this.sortBy && this.sortBy !== 'manual') params.set('sort_by', this.sortBy);
                if (this.filterPriority) params.set('priority', this.filterPriority);
                if (this.filterDue) params.set('due', this.filterDue);
                if (this.filterTags.length) params.set('tags', this.filterTags.join(','));
                const url = '/list/' + this.sid + (params.toString() ? '?' + params.toString() : '');
                htmx.ajax('GET', url, { target: '#page-content', swap: 'innerHTML' });
            },
            clearFilters() {
                this.sortBy = 'manual';
                this.filterPriority = null;
                this.filterDue = null;
                this.filterTags = [];
                this.applyFilters();
            },
            hasActiveFilters() {
                return this.sortBy !== 'manual'
                    || this.filterPriority
                    || this.filterDue
                    || this.filterTags.length > 0;
            }
        }));
    </script>
    <script src="//unpkg.com/htmx.org@1.9.5/dist/htmx.min.js"></script>
    <script src="//unpkg.com/hyperscript.org@0.9.11"></script>
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
    {% if ENV == "local" %}
        <script src="//unpkg.com/htmx.org/dist/ext/debug.js"></script>
        {{ hot_reload.script("ws://" + HOST + "/hot-reload") | safe }}
    {% endif %}
    {% block scripts %}
    {% endblock %}
    <script>
        function dismissAllDialogs() {
            Array.from(document.getElementsByTagName("dialog")).forEach(el => el.close())
        }
        function halt(e) {
            e.stopPropagation()
            return false
        }
        const allProse = Array.from(document.querySelectorAll(".prose a"))
        allProse.forEach(el => el.addEventListener("click", halt))
        document.addEventListener('keydown', function(e) {
            if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
                e.preventDefault();
                var dialog = document.getElementById('search-dialog');
                if (dialog.open) {
                    dialog.close();
                } else {
                    dialog.showModal();
                    document.getElementById('search-input').focus();
                    document.getElementById('search-input').value = '';
                    document.getElementById('search-results').innerHTML = '<div class="py-8 text-center text-sm text-slate-500">Type to search...</div>';
                }
            }
        });
        document.getElementById('search-input').addEventListener('keydown', function(e) {
            var isDown = e.key === 'ArrowDown' || (e.ctrlKey && e.key === 'j');
            var isUp = e.key === 'ArrowUp' || (e.ctrlKey && e.key === 'k');
            if (isDown || isUp) e.preventDefault();
            var results = document.querySelectorAll('#search-results li a');
            if (!results.length) return;
            var current = document.querySelector('#search-results li a.search-focused');
            var idx = current ? Array.from(results).indexOf(current) : -1;
            if (isDown) {
                if (current) current.classList.remove('search-focused');
                idx = Math.min(idx + 1, results.length - 1);
                results[idx].classList.add('search-focused');
                results[idx].scrollIntoView({ block: 'nearest' });
            } else if (isUp) {
                if (current) current.classList.remove('search-focused');
                idx = Math.max(idx - 1, 0);
                results[idx].classList.add('search-focused');
                results[idx].scrollIntoView({ block: 'nearest' });
            } else if (e.key === 'Enter' && current) {
                e.preventDefault();
                current.click();
            }
        });
        document.addEventListener('keydown', function(e) {
            if (e.key === 'n' && !e.metaKey && !e.ctrlKey && !e.altKey) {
                var active = document.activeElement;
                var tag = active ? active.tagName.toLowerCase() : '';
                if (tag === 'input' || tag === 'textarea' || tag === 'select' || active.isContentEditable) return;
                var dialog = document.getElementById('quick-add-dialog');
                if (dialog.open) return;
                e.preventDefault();
                var focusedTask = document.querySelector('.task.task-focused');
                var sectionSid = '';
                if (focusedTask) {
                    var sortableContainer = focusedTask.closest('.sortable-tasks');
                    if (sortableContainer) sectionSid = sortableContainer.dataset.sectionSid;
                }
                var qaUrl = '/tasks/quick-add' + (sectionSid ? '?section=' + sectionSid : '');
                htmx.ajax('GET', qaUrl, {target: '#quick-add-content', swap: 'innerHTML'}).then(function() {
                    dialog.showModal();
                    var titleInput = document.getElementById('quick-add-title');
                    if (titleInput) titleInput.focus();
                });
            }
        });
    </script>
    <script>
        // Keyboard navigation for tasks
        (function() {
            var pendingG = false;
            var gTimeout = null;
            var pendingC = false;
            var cTimeout = null;
            var pendingD = false;
            var dTimeout = null;
            var pendingY = false;
            var yTimeout = null;
            var pendingBang = false;
            var bangTimeout = null;
            var numericPrefix = 0;
            var numericTimeout = null;
            var visualMode = false;
            var visualAnchor = -1;

            function isInputFocused() {
                var active = document.activeElement;
                if (!active) return false;
                var tag = active.tagName.toLowerCase();
                return tag === 'input' || tag === 'textarea' || tag === 'select' || active.isContentEditable;
            }

            function isAnyDialogOpen() {
                var dialogs = document.getElementsByTagName('dialog');
                for (var i = 0; i < dialogs.length; i++) {
                    if (dialogs[i].open) return true;
                }
                return false;
            }

            function getVisibleTasks() {
                return Array.from(document.querySelectorAll('.task')).filter(function(el) {
                    return el.offsetParent !== null;
                });
            }

            function getTasksInSection(taskEl) {
                var sortable = taskEl.closest('.sortable-tasks');
                if (!sortable) return [taskEl];
                return Array.from(sortable.querySelectorAll('.task')).filter(function(el) {
                    return el.offsetParent !== null;
                });
            }

            function getFocusedTask() {
                return document.querySelector('.task.task-focused');
            }

            function setFocusedTask(taskEl) {
                var current = getFocusedTask();
                if (current) current.classList.remove('task-focused');
                if (taskEl) {
                    taskEl.classList.add('task-focused');
                    taskEl.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
                }
            }

            function clearFocus() {
                var current = getFocusedTask();
                if (current) current.classList.remove('task-focused');
            }

            function getAlpineScope() {
                var el = document.querySelector('[x-data*="selectMode"]');
                return el && el._x_dataStack ? el._x_dataStack[0] : null;
            }

            function updateVisualSelection(newIdx) {
                var scope = getAlpineScope();
                if (!scope || !visualMode) return;
                var tasks = getVisibleTasks();
                var start = Math.min(visualAnchor, newIdx);
                var end = Math.max(visualAnchor, newIdx);
                scope.selected = tasks.slice(start, end + 1).map(function(t) { return t.dataset.sid; });
            }

            function exitVisual() {
                visualMode = false;
                visualAnchor = -1;
                var scope = getAlpineScope();
                if (scope) { scope.selectMode = false; scope.selected = []; }
            }

            function triggerSectionUpdate(sid) {
                var el = document.querySelector('.task[data-sid="' + sid + '"]');
                var sec = el ? el.closest('.section') : null;
                var secSid = sec ? sec.id.replace('section-', '') : null;
                if (secSid) htmx.trigger(document.body, 'section-' + secSid + '-update');
            }

            function setPriority(sid, val) {
                fetch('/task/' + sid + '/priority', {
                    method: 'PUT',
                    headers: {'Content-Type': 'application/x-www-form-urlencoded'},
                    body: 'priority=' + val
                }).then(function(r) { return r.text(); }).then(function(html) {
                    var w = document.querySelector('.priority-wrapper[data-task-sid="' + sid + '"]');
                    if (w) { var t = document.createElement('div'); t.innerHTML = html.trim(); var n = t.firstElementChild; w.replaceWith(n); htmx.process(n); }
                    htmx.trigger(document.body, 'task-update');
                    htmx.trigger(document.body, 'task-' + sid + '-update');
                    triggerSectionUpdate(sid);
                });
            }

            function openScopedSearch(prefix) {
                var dialog = document.getElementById('search-dialog');
                dialog.showModal();
                var input = document.getElementById('search-input');
                input.value = prefix;
                input.focus();
                htmx.trigger(input, 'keyup');
            }

            document.addEventListener('keydown', function(e) {
                if (e.metaKey || e.ctrlKey || e.altKey) return;
                if (isInputFocused()) return;
                if (isAnyDialogOpen()) return;
                if (document.body.classList.contains('sidebar-nav-active')) return;

                var key = e.key;
                var tasks, focused, idx;

                // Priority: !N
                if (pendingBang) {
                    clearTimeout(bangTimeout);
                    pendingBang = false;
                    if (key >= '0' && key <= '4') {
                        e.preventDefault();
                        focused = getFocusedTask();
                        if (focused) setPriority(focused.dataset.sid, key === '0' ? '' : key);
                        return;
                    }
                }

                if (key >= '0' && key <= '9') {
                    e.preventDefault();
                    numericPrefix = numericPrefix * 10 + parseInt(key);
                    clearTimeout(numericTimeout);
                    numericTimeout = setTimeout(function() { numericPrefix = 0; }, 1500);
                    return;
                }
                var count = numericPrefix || 1;
                numericPrefix = 0;
                clearTimeout(numericTimeout);

                if (pendingC) {
                    clearTimeout(cTimeout);
                    pendingC = false;
                    e.preventDefault();
                    focused = getFocusedTask();
                    if (focused) {
                        if (key === 'c') {
                            var df2 = focused.querySelector('form:not(.task-title-edit)');
                            var ef2 = focused.querySelector('.task-title-edit');
                            if (df2 && ef2) {
                                df2.style.display = 'none';
                                ef2.style.display = '';
                                var ti2 = ef2.querySelector('input[name=title]');
                                if (ti2) { ti2.value = ''; ti2.focus(); }
                            }
                        } else if (key === 't') {
                            var displayForm = focused.querySelector('form:not(.task-title-edit)');
                            var editForm = focused.querySelector('.task-title-edit');
                            if (displayForm && editForm) {
                                displayForm.style.display = 'none';
                                editForm.style.display = '';
                                var titleInput = editForm.querySelector('input[name=title]');
                                if (titleInput) titleInput.select();
                            }
                        } else if (key === 'd') {
                            var descrForm = focused.querySelector('.task-descr-edit');
                            if (descrForm) {
                                descrForm.style.display = '';
                                var ta = descrForm.querySelector('textarea[name=descr]');
                                if (ta) ta.focus();
                            }
                        }
                    } else {
                        if (key === 't') {
                            var pageTitle = document.querySelector('.page-title-display');
                            if (pageTitle) pageTitle.click();
                        } else if (key === 'd') {
                            var pageDescr = document.querySelector('.page-descr-display');
                            if (pageDescr) pageDescr.click();
                        }
                    }
                    return;
                }

                if (pendingY) {
                    clearTimeout(yTimeout);
                    pendingY = false;
                    if (key === 'y') {
                        e.preventDefault();
                        focused = getFocusedTask();
                        if (focused) {
                            var titleEl = focused.querySelector('span.font-semibold');
                            if (titleEl) navigator.clipboard.writeText(titleEl.textContent.trim());
                        }
                    }
                    return;
                }

                switch (key) {
                    case 'j':
                        e.preventDefault();
                        tasks = getVisibleTasks();
                        if (tasks.length === 0) return;
                        focused = getFocusedTask();
                        if (!focused) {
                            setFocusedTask(tasks[0]);
                            if (visualMode) updateVisualSelection(0);
                        } else {
                            idx = tasks.indexOf(focused);
                            var ni = Math.min(idx + count, tasks.length - 1);
                            setFocusedTask(tasks[ni]);
                            if (visualMode) updateVisualSelection(ni);
                        }
                        break;

                    case 'k':
                        e.preventDefault();
                        tasks = getVisibleTasks();
                        if (tasks.length === 0) return;
                        focused = getFocusedTask();
                        if (!focused) {
                            setFocusedTask(tasks[tasks.length - 1]);
                            if (visualMode) updateVisualSelection(tasks.length - 1);
                        } else {
                            idx = tasks.indexOf(focused);
                            var ni2 = Math.max(idx - count, 0);
                            setFocusedTask(tasks[ni2]);
                            if (visualMode) updateVisualSelection(ni2);
                        }
                        break;

                    case 'G':
                        e.preventDefault();
                        tasks = getVisibleTasks();
                        if (tasks.length > 0) {
                            setFocusedTask(tasks[tasks.length - 1]);
                            if (visualMode) updateVisualSelection(tasks.length - 1);
                        }
                        break;

                    case 'g':
                        e.preventDefault();
                        if (pendingG) {
                            clearTimeout(gTimeout);
                            pendingG = false;
                            tasks = getVisibleTasks();
                            if (tasks.length > 0) {
                                setFocusedTask(tasks[0]);
                                if (visualMode) updateVisualSelection(0);
                            }
                        } else {
                            pendingG = true;
                            gTimeout = setTimeout(function() { pendingG = false; }, 500);
                        }
                        break;

                    case '}':
                        focused = getFocusedTask();
                        if (!focused) return;
                        e.preventDefault();
                        var secTasksEnd = getTasksInSection(focused);
                        if (secTasksEnd.length > 0) {
                            setFocusedTask(secTasksEnd[secTasksEnd.length - 1]);
                            if (visualMode) {
                                tasks = getVisibleTasks();
                                updateVisualSelection(tasks.indexOf(secTasksEnd[secTasksEnd.length - 1]));
                            }
                        }
                        break;

                    case '{':
                        focused = getFocusedTask();
                        if (!focused) return;
                        e.preventDefault();
                        var secTasksStart = getTasksInSection(focused);
                        if (secTasksStart.length > 0) {
                            setFocusedTask(secTasksStart[0]);
                            if (visualMode) {
                                tasks = getVisibleTasks();
                                updateVisualSelection(tasks.indexOf(secTasksStart[0]));
                            }
                        }
                        break;

                    case 'A':
                        e.preventDefault();
                        focused = getFocusedTask();
                        var section = focused ? focused.closest('.section') : document.querySelector('.section');
                        if (!section) return;
                        var sectionSid = section.querySelector('.sortable-tasks').dataset.sectionSid;
                        var createBtn = document.getElementById('btn-task-create-' + sectionSid);
                        if (createBtn) {
                            createBtn.click();
                            var addForm = section.querySelector('.add-task-form');
                            if (addForm) {
                                var titleInput = addForm.querySelector('input[name=title]');
                                if (titleInput) setTimeout(function() { titleInput.focus(); }, 50);
                            }
                        }
                        break;

                    case 'a':
                        focused = getFocusedTask();
                        if (!focused) return;
                        e.preventDefault();
                        var df = focused.querySelector('form:not(.task-title-edit)');
                        var ef = focused.querySelector('.task-title-edit');
                        if (df && ef) {
                            df.style.display = 'none';
                            ef.style.display = '';
                            var ti = ef.querySelector('input[name=title]');
                            if (ti) { ti.focus(); ti.setSelectionRange(ti.value.length, ti.value.length); }
                        }
                        break;

                    case 'c':
                        e.preventDefault();
                        pendingC = true;
                        cTimeout = setTimeout(function() { pendingC = false; }, 500);
                        break;

                    case 'y':
                        e.preventDefault();
                        pendingY = true;
                        yTimeout = setTimeout(function() { pendingY = false; }, 500);
                        break;

                    case 'b':
                        e.preventDefault();
                        var bookmarkBtn = document.querySelector('button[hx-post="/bookmarks"]');
                        if (bookmarkBtn) bookmarkBtn.click();
                        break;

                    case 'x':
                        focused = getFocusedTask();
                        if (!focused) return;
                        e.preventDefault();
                        var checkbox = focused.querySelector('input[type="checkbox"]');
                        if (checkbox) checkbox.click();
                        break;

                    case 'Enter':
                        focused = getFocusedTask();
                        if (!focused) return;
                        e.preventDefault();
                        var sid = focused.dataset.sid;
                        if (sid) window.location.href = '/task/' + sid;
                        break;

                    case 'e':
                        focused = getFocusedTask();
                        if (!focused) return;
                        e.preventDefault();
                        var displayForm = focused.querySelector('form:not(.task-title-edit)');
                        var editForm = focused.querySelector('.task-title-edit');
                        if (displayForm && editForm) {
                            displayForm.style.display = 'none';
                            editForm.style.display = '';
                            var titleInput = editForm.querySelector('input[name=title]');
                            if (titleInput) titleInput.select();
                        }
                        break;

                    case 'h':
                        e.preventDefault();
                        var url = new URL(window.location.href);
                        if (url.searchParams.get('view_complete') === 'true') {
                            url.searchParams.delete('view_complete');
                        } else {
                            url.searchParams.set('view_complete', 'true');
                        }
                        window.location.href = url.toString();
                        break;

                    case 'd':
                        e.preventDefault();
                        if (pendingD) {
                            clearTimeout(dTimeout);
                            pendingD = false;
                            var scope = getAlpineScope();
                            if (scope && scope.selected.length > 0) {
                                scope.bulkDelete();
                                exitVisual();
                            }
                        } else {
                            pendingD = true;
                            dTimeout = setTimeout(function() {
                                pendingD = false;
                                focused = getFocusedTask();
                                if (!focused) return;
                                var dw = focused.querySelector('.due-date-wrapper');
                                window.openDatePicker(focused.dataset.sid, dw ? dw.dataset.dueDate : '');
                            }, 300);
                        }
                        break;

                    case '+':
                        focused = getFocusedTask();
                        if (!focused) return;
                        e.preventDefault();
                        var tw = focused.querySelector('.tags-wrapper');
                        window.openTagsPicker(focused.dataset.sid, tw ? tw.dataset.tags : '');
                        break;

                    case '!':
                        e.preventDefault();
                        pendingBang = true;
                        bangTimeout = setTimeout(function() { pendingBang = false; }, 1000);
                        break;

                    case 'v':
                        e.preventDefault();
                        if (visualMode) {
                            exitVisual();
                        } else {
                            focused = getFocusedTask();
                            if (!focused) return;
                            tasks = getVisibleTasks();
                            visualMode = true;
                            visualAnchor = tasks.indexOf(focused);
                            var scope = getAlpineScope();
                            if (scope) {
                                scope.selectMode = true;
                                scope.selected = [focused.dataset.sid];
                            }
                        }
                        break;

                    case '@':
                        e.preventDefault();
                        openScopedSearch('@');
                        break;

                    case '#':
                        e.preventDefault();
                        var ctx = document.getElementById('page-context');
                        openScopedSearch(ctx && ctx.dataset.spaceTitle ? '@' + ctx.dataset.spaceTitle + ' #' : '#');
                        break;

                    case '$':
                        e.preventDefault();
                        var ctx2 = document.getElementById('page-context');
                        if (ctx2 && ctx2.dataset.listTitle) {
                            openScopedSearch('@' + ctx2.dataset.spaceTitle + ' #' + ctx2.dataset.listTitle + ' $');
                        } else {
                            openScopedSearch('$');
                        }
                        break;

                    case '%':
                        e.preventDefault();
                        openScopedSearch('%');
                        break;

                    case '?':
                        e.preventDefault();
                        var dialog = document.getElementById('keyboard-shortcuts-dialog');
                        if (dialog) dialog.showModal();
                        break;

                    case 'Escape':
                        if (visualMode) {
                            e.preventDefault();
                            exitVisual();
                            return;
                        }
                        if (getFocusedTask()) {
                            e.preventDefault();
                            clearFocus();
                        }
                        break;
                }
            });

            document.addEventListener('click', function(e) {
                if (!e.target.closest('.task')) {
                    clearFocus();
                }
            });

            document.body.addEventListener('htmx:afterSettle', function() {
                var focused = getFocusedTask();
                if (focused && !document.body.contains(focused)) {
                    clearFocus();
                }
            });
        })();
    </script>
    <script>
    (function() {
        var style = document.createElement('style');
        style.textContent = '.sidebar-item-focused { background: rgba(99, 102, 241, 0.2); border-radius: 0.25rem; }';
        document.head.appendChild(style);

        var sidebarFocused = false;
        var sidebarIdx = -1;
        var pendingCtrlW = false;
        var ctrlWTimeout = null;

        function getSidebarItems() {
            return Array.from(document.querySelectorAll('.sidebar-nav-item')).filter(function(el) {
                return el.offsetParent !== null;
            });
        }

        function setSidebarFocus(idx) {
            var items = getSidebarItems();
            items.forEach(function(el) { el.classList.remove('sidebar-item-focused'); });
            if (idx >= 0 && idx < items.length) {
                sidebarIdx = idx;
                items[idx].classList.add('sidebar-item-focused');
                items[idx].scrollIntoView({ block: 'nearest' });
            }
        }

        function enterSidebar() {
            sidebarFocused = true;
            document.body.classList.add('sidebar-nav-active');
            var items = getSidebarItems();
            if (items.length > 0) setSidebarFocus(0);
        }

        function exitSidebar() {
            sidebarFocused = false;
            sidebarIdx = -1;
            document.body.classList.remove('sidebar-nav-active');
            var items = getSidebarItems();
            items.forEach(function(el) { el.classList.remove('sidebar-item-focused'); });
        }

        document.addEventListener('keydown', function(e) {
            if (e.altKey && e.key === 'w') {
                e.preventDefault();
                pendingCtrlW = true;
                clearTimeout(ctrlWTimeout);
                ctrlWTimeout = setTimeout(function() { pendingCtrlW = false; }, 500);
                return;
            }
            if (e.altKey && e.key === 'h') {
                e.preventDefault();
                enterSidebar();
                return;
            }
            if (e.altKey && e.key === 'l') {
                e.preventDefault();
                exitSidebar();
                return;
            }

            if (pendingCtrlW) {
                clearTimeout(ctrlWTimeout);
                pendingCtrlW = false;
                if (e.key === 'h') {
                    e.preventDefault();
                    enterSidebar();
                } else if (e.key === 'l') {
                    e.preventDefault();
                    exitSidebar();
                }
                return;
            }

            if (!sidebarFocused) return;

            var active = document.activeElement;
            var tag = active ? active.tagName.toLowerCase() : '';
            if (tag === 'input' || tag === 'textarea' || tag === 'select' || active.isContentEditable) return;

            var items = getSidebarItems();
            if (!items.length) return;

            switch (e.key) {
                case 'j':
                    e.preventDefault();
                    e.stopPropagation();
                    setSidebarFocus(Math.min(sidebarIdx + 1, items.length - 1));
                    break;
                case 'k':
                    e.preventDefault();
                    e.stopPropagation();
                    setSidebarFocus(Math.max(sidebarIdx - 1, 0));
                    break;
                case 'Enter':
                    e.preventDefault();
                    e.stopPropagation();
                    if (sidebarIdx >= 0 && items[sidebarIdx]) {
                        var link = items[sidebarIdx].querySelector('a') || items[sidebarIdx].closest('a');
                        if (link) link.click();
                        else if (items[sidebarIdx].tagName === 'A') items[sidebarIdx].click();
                        else if (items[sidebarIdx].tagName === 'BUTTON') items[sidebarIdx].click();
                    }
                    exitSidebar();
                    break;
                case 'n':
                    e.preventDefault();
                    e.stopPropagation();
                    var navListBtns = document.querySelectorAll('#nav-lists button');
                    for (var i = 0; i < navListBtns.length; i++) {
                        if (navListBtns[i].getAttribute('_') && navListBtns[i].getAttribute('_').includes('showModal')) {
                            navListBtns[i].click();
                            break;
                        }
                    }
                    exitSidebar();
                    break;
                case 'Escape':
                    e.preventDefault();
                    e.stopPropagation();
                    exitSidebar();
                    break;
            }
        }, true);
    })();
    </script>
    <script>
        function initSortableTasks() {
            document.querySelectorAll('.sortable-tasks').forEach(function(el) {
                if (el._sortable) return;
                el._sortable = new Sortable(el, {
                    forceFallback: true,
                    animation: 150,
                    ghostClass: 'opacity-30',
                    chosenClass: 'sortable-chosen',
                    dragClass: 'sortable-drag',
                    onEnd: function(evt) {
                        var sectionSid = el.dataset.sectionSid;
                        var sids = Array.from(el.children).map(function(li) {
                            return li.dataset.sid;
                        }).filter(Boolean);
                        fetch('/tasks/reorder', {
                            method: 'PUT',
                            headers: {'Content-Type': 'application/json'},
                            body: JSON.stringify({sids: sids, section_sid: sectionSid})
                        });
                    }
                });
            });
        }
        document.addEventListener('DOMContentLoaded', initSortableTasks);
        document.body.addEventListener('htmx:afterSettle', initSortableTasks);
    </script>
    {{ catalog.render_assets() }}
</body>
</html>
