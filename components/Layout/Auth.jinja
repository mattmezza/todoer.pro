{# def img="/public/images/auth-image.jpg", title=False #}
<!doctype html>
<html>
<head>
    <title>{% if ENV != "prod" %}[{{ ENV }}] {% endif %}Todoer{%- if title %} - {{ title }}{% endif %}</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    {% if ENV == "local" %}
    <link href="/public/style.css?v={{ epoch() }}" rel="stylesheet">
    {% else %}
    <link href="/public/style.css?v={{ RELEASE or '' }}" rel="stylesheet">
    {% endif %}
    <!-- emoji to png|ico via https://emojifavicon.dev -->
    <link rel="icon" href="/public/favicon.ico?v={{ RELEASE or '' }}">
    <link rel="icon" href="/public/favicon.png?v={{ RELEASE or '' }}">
</head>
<body class="dark:bg-black dark:text-zinc-100 min-h-screen">
    <main class="bg-white dark:bg-slate-900">
        <div class="relative flex">
            <!-- Content -->
            <div class="w-full md:w-1/2">
                <div class="min-h-[100dvh] h-full flex flex-col after:flex-1">
                    <!-- Header -->
                    <div class="flex-1">
                        <div class="flex items-center justify-between h-16 px-4 sm:px-6 lg:px-8">
                            <Nav.Logo />
                        </div>
                    </div>
                    {{ content }}
                </div>
            </div>
            <!-- Image -->
            <div class="hidden md:block absolute top-0 bottom-0 right-0 md:w-1/2" aria-hidden="true">
                <img class="object-cover object-center w-full h-full" src="{{ img }}" width="760" height="1024" alt="Authentication image">
                <img class="absolute top-1/4 left-0 -translate-x-1/2 ml-8 hidden lg:block" src="/public/images/auth-decoration.png" width="218" height="224" alt="Authentication decoration">
            </div>
        </div>
    </main>
    <script src="//unpkg.com/htmx.org@1.9.5/dist/htmx.min.js"></script>
    <script src="//unpkg.com/hyperscript.org@0.9.11"></script>
    {% if ENV == "local" %}
        <script src="//unpkg.com/htmx.org/dist/ext/debug.js"></script>
        {{ hot_reload.script("ws://localhost:8000/hot-reload") | safe }}
    {% endif %}
    {{ catalog.render_assets() }}
</body>

