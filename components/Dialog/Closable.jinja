{# def id #}
<Dialog.Empty __attrs={attrs} id={id}>
    <div class="p-8 text-center relative">
        <button
            class="text-slate-800 dark:text-gray-300 flex items-center justify-center h-6 w-6 active:scale-95 transitions-all absolute right-2 top-2 rounded-full dark:hover:bg-white/30 hover:bg-black/30 cursor-pointer lowercase font-semibold font-mono"
            onclick="document.getElementById('{{ id }}').close()">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
              <path fill-rule="evenodd" d="M5.47 5.47a.75.75 0 0 1 1.06 0L12 10.94l5.47-5.47a.75.75 0 1 1 1.06 1.06L13.06 12l5.47 5.47a.75.75 0 1 1-1.06 1.06L12 13.06l-5.47 5.47a.75.75 0 0 1-1.06-1.06L10.94 12 5.47 6.53a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
            </svg>
        </button>
        {{ content }}
    </div>
</Dialog.Empty>
