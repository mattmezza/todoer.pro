{# def list #}
<div class="w-full flex flex-row items-center gap-2">
    <Lists.Color color={list.color} />
    <form
        class="flex items-center gap-1"
        hx-put="/list/{{ list.sid }}/color"
        hx-target="previous div"
        style="display: none;"
        _="on submit or reset hide me then show the previous <div />">
        <input
            _="on keyup[key is 'Escape'] reset() on the closest <form /> on keyup[key is 'Enter'] submit() on the closest <form />"
            type="color" value="{{ list.color }}" name="color">
        <div class="flex items-center">
            <button type="reset" class="btn text-xs py-0.5 text-white cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
                  <path fill-rule="evenodd" d="M5.47 5.47a.75.75 0 0 1 1.06 0L12 10.94l5.47-5.47a.75.75 0 1 1 1.06 1.06L13.06 12l5.47 5.47a.75.75 0 1 1-1.06 1.06L12 13.06l-5.47 5.47a.75.75 0 0 1-1.06-1.06L10.94 12 5.47 6.53a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                </svg>
            </button>
            <button type="submit" class="btn bg-indigo-500 text-xs py-0.5 text-white cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
                  <path fill-rule="evenodd" d="M19.916 4.626a.75.75 0 0 1 .208 1.04l-9 13.5a.75.75 0 0 1-1.154.114l-6-6a.75.75 0 0 1 1.06-1.06l5.353 5.353 8.493-12.74a.75.75 0 0 1 1.04-.207Z" clip-rule="evenodd" />
                </svg>
            </button>
        </div>
    </form>
    <!-- title -->
    <h1 class="text-2xl md:text-4xl font-bold cursor-pointer hover:text-white rounded py-1 font-mono"
        _="on click hide me then show the next <form /> then select() the next <input />">#{{ list.title }}</h1>
    <form class="flex items-center gap-1 w-full" hx-put="/list/{{ list.sid }}/title" hx-target="previous h1" style="display: none" _="on submit or reset hide me then show the previous <h1 />">
        <input autocapitalize="none" class="form-input px-2 py-1 text-2xl md:text-4xl font-bold text-white w-full grow font-mono" name="title" value="{{ list.title }}" _="on keyup[key is 'Escape'] reset() on the closest <form />">
        <div class="flex items-center">
            <button type="reset" class="btn text-xs py-0.5 text-white cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
                  <path fill-rule="evenodd" d="M5.47 5.47a.75.75 0 0 1 1.06 0L12 10.94l5.47-5.47a.75.75 0 1 1 1.06 1.06L13.06 12l5.47 5.47a.75.75 0 1 1-1.06 1.06L12 13.06l-5.47 5.47a.75.75 0 0 1-1.06-1.06L10.94 12 5.47 6.53a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                </svg>
            </button>
            <button type="submit" class="btn bg-indigo-500 text-xs py-0.5 text-white cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
                  <path fill-rule="evenodd" d="M19.916 4.626a.75.75 0 0 1 .208 1.04l-9 13.5a.75.75 0 0 1-1.154.114l-6-6a.75.75 0 0 1 1.06-1.06l5.353 5.353 8.493-12.74a.75.75 0 0 1 1.04-.207Z" clip-rule="evenodd" />
                </svg>
            </button>
        </div>
    </form>
</div>
