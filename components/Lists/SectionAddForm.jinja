{# def list #}
<form
    style="display: none"
    hx-target="previous .sections"
    hx-swap="beforeend"
    hx-post="/sections"
    hx-on::after-request="this.reset()"
    class="rounded-sm border border-slate-600 add-task-form mb-16"
    _="on keyup[key is 'Escape'] hide me then show #btn-section-create">
    <div class="py-2">
        <input
            name="title"
            placeholder="Section name"
            class="form-input block py-1 px-3 border-0 w-full font-semibold placeholder:font-semibold xs:text-xs sm:text-sm md:text-base font-mono"
            autofocus
            required>
    </div>
    <div class="flex flex-row justify-between items-center border-t border-slate-600 px-3 py-2">
        <div>
        </div>
        <div class="space-x-2">
            <button _="on click hide closest <form /> then show #btn-section-create" type="reset" class="btn py-1">Cancel</button>
            <button type="submit" class="btn py-1 bg-indigo-600 text-white">
                Add section
            </button>
        </div>
    </div>
    <input type="hidden" name="list_id" value="{{ list.uuid }}">
</form>
