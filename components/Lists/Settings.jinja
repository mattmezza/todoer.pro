{# def list #}
<div id="list-settings-{{ list.sid }}">
    <form
        class="space-y-6"
        hx-put="/list/{{ list.sid }}/settings"
        hx-target="#list-settings-{{ list.sid }}"
        hx-swap="outerHTML">

        <div>
            <label class="block text-sm font-semibold mb-1" for="default_view">Default view</label>
            <select
                id="default_view"
                name="default_view"
                class="rounded dark:bg-black dark:text-white cursor-pointer border border-slate-600 w-full font-mono px-3 py-2 text-sm">
                <option value="board" {% if list.default_view == 'board' %}selected{% endif %}>Board</option>
                <option value="list" {% if list.default_view == 'list' %}selected{% endif %}>List</option>
            </select>
        </div>

        <div class="flex items-center gap-3">
            <input
                type="checkbox"
                id="show_completed"
                name="show_completed"
                value="true"
                {% if list.show_completed %}checked{% endif %}
                class="rounded dark:bg-black border-slate-600 cursor-pointer">
            <label class="text-sm font-semibold cursor-pointer" for="show_completed">Show completed tasks</label>
        </div>

        <div class="flex justify-end gap-3 pt-2">
            <button
                type="button"
                class="px-6 py-2 rounded text-sm font-bold uppercase hover:bg-slate-700 transition-all active:scale-95"
                onclick="document.getElementById('dialog-list-settings').close()">
                Cancel
            </button>
            <button
                type="submit"
                class="px-6 py-2 rounded bg-indigo-600 text-white text-sm font-bold uppercase hover:bg-indigo-700 transition-all active:scale-95"
                _="on click wait 100ms then call document.getElementById('dialog-list-settings').close()">
                Save
            </button>
        </div>
    </form>
</div>
