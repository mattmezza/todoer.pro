{# def comment #}
<div class="flex gap-2 justify-start items-start">
    <img class="w-6 h-6 rounded-full" src="https://www.gravatar.com/avatar/{{ comment.author_email_hash }}.jpg?s=100" width="32" height="32" alt="User">
    <div class="border-l-4 dark:border-slate-400 px-2 pb-8 relative flex-grow">
        {{ comment.content }}
        <span
            class="text-xs italic dark:text-slate-600 absolute right-0 bottom-0"
            title="{{ comment.created }}"
        >{{ comment.created|age }}</span>
    </div>
</div>

