{
  "manifest_version": 3,
  "name": "Todoer Pro",
  "version": "3.0.0",
  "description": "Open Todoer in a compact window, pin lists to websites, and capture pages.",
  "icons": {
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Todoer Pro"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["activeTab", "contextMenus", "storage"],
  "browser_specific_settings": {
    "gecko": {
      "id": "browser-extension@todoer.pro",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "minimum_chrome_version": "121",
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js",
    "type": "module"
  }
}
