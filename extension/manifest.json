{
  "manifest_version": 3,
  "name": "Todoer Pro",
  "version": "3.2.0",
  "description": "Open Todoer from the toolbar, pin Todoer links to websites, and capture pages.",
  "icons": {
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Todoer Pro",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "side_panel": {
    "default_path": "popup.html?side=1"
  },
  "permissions": ["activeTab", "contextMenus", "storage", "sidePanel"],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https: http://localhost:* http://127.0.0.1:*; frame-src https: http://localhost:* http://127.0.0.1:*"
  },
  "minimum_chrome_version": "121",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
