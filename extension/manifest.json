{
  "manifest_version": 3,
  "name": "Todoer Pro",
  "version": "3.0.1",
  "description": "Open Todoer in a compact window, pin lists to websites, and capture pages.",
  "icons": {
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Todoer Pro"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["activeTab", "contextMenus", "storage"],
  "minimum_chrome_version": "121",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
