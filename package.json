{
  "private": true,
  "scripts": {
    "assets": "tailwindcss -i rebuild/assets/source.css -o rebuild/assets/app.css --minify",
    "test:browser": "playwright test",
    "format": "prettier --write \"rebuild/assets/*.js\" rebuild/assets/source.css \"rebuild/browser/*.js\" playwright.config.js package.json",
    "format:check": "prettier --check \"rebuild/assets/*.js\" rebuild/assets/source.css \"rebuild/browser/*.js\" playwright.config.js package.json"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/cli": "4.3.1",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/typography": "0.5.19",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.1"
  },
  "dependencies": {
    "htmx.org": "2.0.8"
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "7.1.7"
    }
  }
}
