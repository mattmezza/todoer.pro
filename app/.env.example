# Local development only: synthetic accounts, loopback binding, no Google needed.
# Copy to an ignored file and export variables; never source the legacy .envrc.
TODOER_DEV_AUTH=1
TODOER_DEV_TOKEN=replace-with-random-value-at-least-24-characters
TODOER_RUST_DB=.local/rebuild/rust.db
TODOER_RUST_PORT=8092
TODOER_URL=http://127.0.0.1:8092
# CLI uses TODOER_TOKEN, separately issued through browser Settings in production.

# Production: remove TODOER_DEV_AUTH and TODOER_DEV_TOKEN entirely.
# TODOER_RUST_BIND=0.0.0.0
# TODOER_PUBLIC_URL=https://todoer.example.invalid
# TODOER_GOOGLE_CLIENT_ID=replace-with-google-client-id
# TODOER_GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# Exact verified email allowlist; otherwise registration requires an invitation.
# TODOER_REGISTRATION_ALLOWLIST=owner@example.invalid
# Persistent random 32-byte hexadecimal key (openssl rand -hex 32).
# Required in production; changing it invalidates outstanding invitation links.
# TODOER_SERVER_KEY=replace-with-64-hexadecimal-characters

# Private attachment storage. Keep distinct from Litestream replication credentials.
# TODOER_ATTACHMENTS_ENDPOINT=https://objects.example.invalid
# TODOER_ATTACHMENTS_BUCKET=todoer-attachments
# TODOER_ATTACHMENTS_REGION=us-east-1
# TODOER_ATTACHMENTS_PREFIX=todoer/
# TODOER_ATTACHMENTS_ACCESS_KEY_ID=replace-me
# TODOER_ATTACHMENTS_SECRET_ACCESS_KEY=replace-me
# Legacy import/export can use a separate read-only source adapter:
# TODOER_LEGACY_STORAGE_ENDPOINT=https://legacy-objects.example.invalid
# TODOER_LEGACY_STORAGE_BUCKET=legacy-attachments
# TODOER_LEGACY_STORAGE_REGION=us-east-1
# TODOER_LEGACY_STORAGE_PREFIX=
# TODOER_LEGACY_STORAGE_ACCESS_KEY_ID=replace-me
# TODOER_LEGACY_STORAGE_SECRET_ACCESS_KEY=replace-me

# Optional SMTP. Reminders/digests are opt-in; invitations also use this outbox.
# TODOER_SMTP_HOST=smtp.example.invalid
# TODOER_SMTP_PORT=587
# TODOER_SMTP_TLS=starttls
# TODOER_SMTP_FROM=Todoer <todoer@example.invalid>
# TODOER_SMTP_USERNAME=replace-me
# TODOER_SMTP_PASSWORD=replace-me
# Local capture tests ONLY permit plaintext on loopback:
# TODOER_SMTP_INSECURE_LOCAL=1
# TODOER_SMTP_TEST_RECIPIENT=capture@example.invalid

# Optional Web Push: base64url P-256 private key, contact mailto/HTTPS URI.
# TODOER_PUSH_VAPID_PRIVATE_KEY=replace-with-base64url-p256-private-key
# TODOER_PUSH_VAPID_SUBJECT=mailto:owner@example.invalid
# Additional provider hostnames are an explicit operator trust decision:
# TODOER_PUSH_EXTRA_HOSTS=

# Optional built-in AI and billing. Core task/agent access never requires credits.
# Start disabled; configure supported models/rates in the platform Admin panel.
# Source support does not imply a hosted instance has checkout enabled.
TODOER_AI_ENABLED=0
TODOER_BILLING_ENABLED=0
# Managed inference only; account BYOK uses the user's encrypted OpenRouter key.
# TODOER_OPENROUTER_API_KEY=replace-with-openrouter-inference-key
# Dedicated stable encryption key (openssl rand -hex 32); keep backups private.
# TODOER_BYOK_ENCRYPTION_KEY=replace-with-64-random-hex-characters
# Only during a controlled rotation; remove after records are rotated safely.
# TODOER_BYOK_PREVIOUS_ENCRYPTION_KEY=replace-with-previous-encryption-material
# Private runtime JSON with nonempty classify and draft strings. Never commit it.
# TODOER_ASSIST_PROMPT_FILE=.local/private/prompts/ai-runtime.json
# Stripe server/test credentials. Card details stay with Stripe.
# TODOER_STRIPE_SECRET_KEY=sk_test_replace-with-test-secret
# TODOER_STRIPE_WEBHOOK_SECRET=whsec_replace-with-endpoint-signing-secret
# POST /api/billing/stripe/webhook receives signed successful payment/refund/dispute events.
# EUR checkout is fixed. Optional usd/gbp/cad rates are currency units per EUR,
# scaled by one million, configured deliberately and locked on each purchase.
# TODOER_BILLING_CURRENCY_RATES={}
# See docs/rebuild/ai-billing.md before enabling billing or changing encryption.
